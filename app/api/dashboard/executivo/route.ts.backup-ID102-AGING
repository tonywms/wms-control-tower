import { NextResponse } from "next/server";
import { unstable_rethrow } from "next/navigation";
import { createClient } from "@/lib/supabase/server";
import { requirePermission } from "@/lib/auth/permissions";

type Projeto = {
  id: string;
  nome: string;
  status: string;
  prioridade: string;
  percentual: number | null;
  data_fim: string | null;
  cliente?: { id: string; nome: string } | null;
  etapa?: { id: string; nome: string; ordem: number } | null;
  responsavel?: { id: string; nome: string } | null;
};

type Pendencia = {
  id: string;
  projeto_id: string;
  titulo: string;
  tipo: "Pendência" | "Impedimento";
  prioridade: "Baixa" | "Normal" | "Alta" | "Crítica";
  status: "Pendente" | "Em andamento" | "Concluída" | "Cancelada";
  prazo: string | null;
};

type Marco = {
  id: string;
  projeto_id: string;
  nome: string;
  status: "Previsto" | "Em andamento" | "Concluído" | "Cancelado";
  data_prevista: string | null;
};

type Acao = {
  id: string;
  projeto_id: string;
  titulo: string;
  status: "Pendente" | "Em andamento" | "Concluída" | "Cancelada";
  prioridade: "Baixa" | "Normal" | "Alta" | "Crítica";
  prazo: string | null;
};

function normalize(value: unknown) {
  return String(value ?? "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .trim()
    .toLowerCase();
}

function fimDoDia(data: string) {
  return new Date(`${data}T23:59:59`).getTime();
}

function vencido(data: string | null) {
  return !!data && fimDoDia(data) < Date.now();
}

function diasAtraso(data: string | null) {
  if (!data || !vencido(data)) return 0;

  const fim = fimDoDia(data);
  const agora = Date.now();
  return Math.max(1, Math.floor((agora - fim) / 86_400_000) + 1);
}

function encerrado(status: string) {
  const s = normalize(status);
  return s === "finalizado" || s === "cancelado" || s === "concluido";
}

export async function GET() {
  try {
    const permissao = await requirePermission("visualizar");

    if (!permissao.ok) {
      return NextResponse.json(
        { success: false, error: permissao.error },
        { status: permissao.status },
      );
    }

    const supabase = await createClient();

    const [projetosRes, pendenciasRes, marcosRes, acoesRes] =
      await Promise.all([
        supabase
          .from("projetos")
          .select(`
            id,nome,status,prioridade,percentual,data_fim,
            cliente:clientes(id,nome),
            etapa:etapas(id,nome,ordem),
            responsavel:usuarios!projetos_responsavel_id_fkey(id,nome)
          `)
          .order("updated_at", { ascending: false }),

        supabase
          .from("projeto_pendencias")
          .select("id,projeto_id,titulo,tipo,prioridade,status,prazo"),

        supabase
          .from("projeto_marcos")
          .select("id,projeto_id,nome,status,data_prevista"),

        supabase
          .from("projeto_acoes")
          .select("id,projeto_id,titulo,status,prioridade,prazo"),
      ]);

    const erro =
      projetosRes.error ||
      pendenciasRes.error ||
      marcosRes.error ||
      acoesRes.error;

    if (erro) {
      return NextResponse.json(
        { success: false, error: erro.message },
        { status: 500 },
      );
    }

    const projetos = (projetosRes.data ?? []) as unknown as Projeto[];
    const pendencias = (pendenciasRes.data ?? []) as Pendencia[];
    const marcos = (marcosRes.data ?? []) as Marco[];
    const acoes = (acoesRes.data ?? []) as Acao[];

    const pendenciasPorProjeto = new Map<string, Pendencia[]>();
    const marcosPorProjeto = new Map<string, Marco[]>();
    const acoesPorProjeto = new Map<string, Acao[]>();

    for (const item of pendencias) {
      const lista = pendenciasPorProjeto.get(item.projeto_id) ?? [];
      lista.push(item);
      pendenciasPorProjeto.set(item.projeto_id, lista);
    }

    for (const item of marcos) {
      const lista = marcosPorProjeto.get(item.projeto_id) ?? [];
      lista.push(item);
      marcosPorProjeto.set(item.projeto_id, lista);
    }

    for (const item of acoes) {
      const lista = acoesPorProjeto.get(item.projeto_id) ?? [];
      lista.push(item);
      acoesPorProjeto.set(item.projeto_id, lista);
    }

    const detalhes = projetos.map((projeto) => {
      const p = pendenciasPorProjeto.get(projeto.id) ?? [];
      const m = marcosPorProjeto.get(projeto.id) ?? [];
      const a = acoesPorProjeto.get(projeto.id) ?? [];

      const pendenciasAbertas = p.filter(
        (x) => normalize(x.status) !== "concluida" && normalize(x.status) !== "cancelada",
      );

      const impedimentosAbertos = pendenciasAbertas.filter(
        (x) => normalize(x.tipo) === "impedimento",
      );

      const impedimentosCriticos = impedimentosAbertos.filter(
        (x) => normalize(x.prioridade) === "critica" || vencido(x.prazo),
      );

      const pendenciasVencidas = pendenciasAbertas.filter(
        (x) => normalize(x.tipo) === "pendencia" && vencido(x.prazo),
      );

      const marcosAtrasados = m.filter(
        (x) =>
          normalize(x.status) !== "concluido" &&
          normalize(x.status) !== "cancelado" &&
          vencido(x.data_prevista),
      );

      const acoesAbertas = a.filter(
        (x) =>
          normalize(x.status) !== "concluida" &&
          normalize(x.status) !== "cancelada",
      );

      const acoesVencidas = acoesAbertas.filter((x) => vencido(x.prazo));

      const proximaAcao =
        [...acoesAbertas].sort((x, y) => {
          const xv = vencido(x.prazo) ? 0 : x.prazo ? 1 : 2;
          const yv = vencido(y.prazo) ? 0 : y.prazo ? 1 : 2;
          if (xv !== yv) return xv - yv;
          if (x.prazo && y.prazo) return x.prazo.localeCompare(y.prazo);
          return normalize(x.prioridade) === "critica" ? -1 : 1;
        })[0] ?? null;

      const projetoAtrasado =
        !encerrado(projeto.status) &&
        vencido(projeto.data_fim);

      const lateDays = projetoAtrasado ? diasAtraso(projeto.data_fim) : 0;
      const status = normalize(projeto.status);
      const prioridade = normalize(projeto.prioridade);

      const isBlocked = status === "bloqueado";
      const isPaused = status === "pausado";
      const isCriticalPriority = prioridade === "critica";
      const isHighPriority = prioridade === "alta";
      const hasOwner = Boolean(projeto.responsavel?.nome?.trim());
      const hasDeadline = Boolean(projeto.data_fim);

      // Regra executiva única, alinhada ao Control Tower Live.
      const criticalByProject =
        isBlocked ||
        lateDays >= 15 ||
        (lateDays >= 7 && (isCriticalPriority || isHighPriority)) ||
        (isPaused && lateDays > 0);

      // Um impedimento crítico real sempre torna o projeto crítico.
      const critico =
        impedimentosCriticos.length > 0 ||
        criticalByProject;

      const attentionByProject =
        !critico &&
        (
          lateDays > 0 ||
          isCriticalPriority ||
          isPaused ||
          !hasOwner ||
          (!hasDeadline && (isHighPriority || isCriticalPriority))
        );

      // Dados operacionais reais também elevam para atenção.
      const atencao =
        !critico &&
        (
          attentionByProject ||
          pendenciasVencidas.length > 0 ||
          impedimentosAbertos.length > 0 ||
          marcosAtrasados.length > 0 ||
          acoesVencidas.length > 0
        );

      const saude = critico ? "Crítico" : atencao ? "Atenção" : "Estável";

      // Score apenas para ranking/pressão. A saúde é definida pelas regras acima.
      let score = critico ? 100 : atencao ? 50 : 0;

      score += impedimentosCriticos.length * 40;
      score += impedimentosAbertos.length * 15;
      score += pendenciasVencidas.length * 12;
      score += marcosAtrasados.length * 10;
      score += acoesVencidas.length * 8;

      if (isBlocked) score += 40;
      if (lateDays > 0) score += Math.min(30, lateDays);
      if (isCriticalPriority) score += 20;
      else if (isHighPriority) score += 10;
      if (isPaused) score += 8;
      if (!hasOwner) score += 5;
      if (!hasDeadline && (isHighPriority || isCriticalPriority)) score += 3;

      const motivos: string[] = [];

      if (isBlocked) motivos.push("Bloqueado");
      if (isPaused) motivos.push("Pausado");
      if (lateDays > 0) motivos.push(`${lateDays}d de atraso`);
      if (isCriticalPriority) motivos.push("Prioridade crítica");
      else if (isHighPriority) motivos.push("Prioridade alta");
      if (!hasOwner) motivos.push("Sem responsável");
      if (!hasDeadline) motivos.push("Sem prazo");
      if (impedimentosCriticos.length > 0) {
        motivos.push(`${impedimentosCriticos.length} impedimento(s) crítico(s)`);
      }
      if (pendenciasVencidas.length > 0) {
        motivos.push(`${pendenciasVencidas.length} pendência(s) vencida(s)`);
      }
      if (marcosAtrasados.length > 0) {
        motivos.push(`${marcosAtrasados.length} marco(s) atrasado(s)`);
      }
      if (acoesVencidas.length > 0) {
        motivos.push(`${acoesVencidas.length} ação(ões) vencida(s)`);
      }

      return {
        ...projeto,
        saude,
        score,
        lateDays,
        motivos,
        proximaAcao: proximaAcao
          ? {
              id: proximaAcao.id,
              titulo: proximaAcao.titulo,
              prioridade: proximaAcao.prioridade,
              prazo: proximaAcao.prazo,
              vencida: vencido(proximaAcao.prazo),
            }
          : null,
        detalhesAlertas: {
          impedimentos: impedimentosAbertos.map((x) => ({
            id: x.id,
            titulo: x.titulo,
            prioridade: x.prioridade,
            prazo: x.prazo,
          })),
          pendenciasVencidas: pendenciasVencidas.map((x) => ({
            id: x.id,
            titulo: x.titulo,
            prioridade: x.prioridade,
            prazo: x.prazo,
          })),
          marcosAtrasados: marcosAtrasados.map((x) => ({
            id: x.id,
            nome: x.nome,
            data_prevista: x.data_prevista,
          })),
          acoesVencidas: acoesVencidas.map((x) => ({
            id: x.id,
            titulo: x.titulo,
            prioridade: x.prioridade,
            prazo: x.prazo,
          })),
        },
        indicadores: {
          projetoAtrasado,
          diasAtraso: lateDays,
          pendenciasAbertas: pendenciasAbertas.length,
          pendenciasVencidas: pendenciasVencidas.length,
          impedimentosAbertos: impedimentosAbertos.length,
          impedimentosCriticos: impedimentosCriticos.length,
          marcosAtrasados: marcosAtrasados.length,
          acoesAbertas: acoesAbertas.length,
          acoesVencidas: acoesVencidas.length,
        },
      };
    });

    const ativos = detalhes.filter((x) => !encerrado(x.status));

    const proximosMarcos = marcos
      .filter(
        (x) =>
          normalize(x.status) !== "concluido" &&
          normalize(x.status) !== "cancelado" &&
          !!x.data_prevista &&
          !vencido(x.data_prevista),
      )
      .map((x) => {
        const projeto = projetos.find((p) => p.id === x.projeto_id);
        return {
          ...x,
          projeto: projeto
            ? {
                id: projeto.id,
                nome: projeto.nome,
                cliente: projeto.cliente ?? null,
              }
            : null,
        };
      })
      .sort((x, y) =>
        String(x.data_prevista ?? "").localeCompare(String(y.data_prevista ?? "")),
      )
      .slice(0, 20);

    const resumo = {
      total: detalhes.length,
      ativos: ativos.length,
      estaveis: ativos.filter((x) => x.saude === "Estável").length,
      atencao: ativos.filter((x) => x.saude === "Atenção").length,
      criticos: ativos.filter((x) => x.saude === "Crítico").length,
      atrasados: ativos.filter((x) => x.indicadores.projetoAtrasado).length,
      bloqueados: ativos.filter((x) => normalize(x.status) === "bloqueado").length,
      semPrazo: ativos.filter((x) => !x.data_fim).length,
      pendenciasAbertas: ativos.reduce(
        (s, x) => s + x.indicadores.pendenciasAbertas,
        0,
      ),
      pendenciasVencidas: ativos.reduce(
        (s, x) => s + x.indicadores.pendenciasVencidas,
        0,
      ),
      impedimentos: ativos.reduce(
        (s, x) => s + x.indicadores.impedimentosAbertos,
        0,
      ),
      impedimentosCriticos: ativos.reduce(
        (s, x) => s + x.indicadores.impedimentosCriticos,
        0,
      ),
      marcosAtrasados: ativos.reduce(
        (s, x) => s + x.indicadores.marcosAtrasados,
        0,
      ),
      acoesAbertas: ativos.reduce(
        (s, x) => s + x.indicadores.acoesAbertas,
        0,
      ),
      acoesVencidas: ativos.reduce(
        (s, x) => s + x.indicadores.acoesVencidas,
        0,
      ),
      proximosMarcos: proximosMarcos.length,
    };

    const ranking = [...ativos]
      .filter((x) => x.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 10);

    const porStatus = Object.entries(
      detalhes.reduce<Record<string, number>>((acc, projeto) => {
        acc[projeto.status] = (acc[projeto.status] ?? 0) + 1;
        return acc;
      }, {}),
    )
      .map(([nome, total]) => ({ nome, total }))
      .sort((a, b) => b.total - a.total);

    const porEtapa = Object.entries(
      ativos.reduce<Record<string, number>>((acc, projeto) => {
        const nome = projeto.etapa?.nome ?? "Sem etapa";
        acc[nome] = (acc[nome] ?? 0) + 1;
        return acc;
      }, {}),
    )
      .map(([nome, total]) => ({ nome, total }))
      .sort((a, b) => b.total - a.total);

    return NextResponse.json({
      success: true,
      atualizadoEm: new Date().toISOString(),
      resumo,
      ranking,
      projetos: ativos,
      proximosMarcos,
      porStatus,
      porEtapa,
    });
  } catch (error) {
    unstable_rethrow(error);
    console.error("[API /api/dashboard/executivo] Erro inesperado:", error);

    return NextResponse.json(
      { success: false, error: "Erro ao montar dashboard executivo." },
      { status: 500 },
    );
  }
}
