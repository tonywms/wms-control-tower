"use client";

import {
  Activity, AlertTriangle, CalendarDays, ChevronLeft, ChevronRight, CircleAlert,
  Clock3, Gauge, Layers3, Maximize2, Pause, Play, ShieldAlert, Target, Timer,
  Users, X, Zap, RefreshCw
} from "lucide-react";
import { useCallback, useEffect, useMemo, useState } from "react";

type Projeto = {
  id: string;
  cliente_id: string;
  nome: string;
  plataforma: string | null;
  etapa_id: string | null;
  setor: string | null;
  responsavel_id: string | null;
  responsavel_nome: string | null;
  status: string;
  prioridade: string;
  data_inicio: string | null;
  data_fim: string | null;
  observacoes: string | null;
  fase_origem: string | null;
  percentual: number;
  created_at: string;
  updated_at: string;
  cliente: { id: string; nome: string; cidade: string | null } | null;
  etapa: { id: string; nome: string; ordem: number } | null;
};

type Props = {
  projetos: Projeto[];
  onOpenProjeto: (id: string) => void;
  onExit: () => void;
};

type Health = "critical" | "attention" | "stable";

type Ranked = Projeto & {
  health: Health;
  score: number;
  lateDays: number;
  reasons: string[];
};

type ExecutiveProject = {
  id: string; nome: string; status: string; prioridade: string;
  percentual: number | null; data_fim: string | null;
  saude: "Crítico" | "Atenção" | "Estável"; score: number; lateDays: number; motivos: string[];
  cliente?: { id: string; nome: string } | null;
  etapa?: { id: string; nome: string; ordem: number } | null;
  responsavel?: { id: string; nome: string } | null;
  proximaAcao?: {
    id: string; titulo: string; prioridade: string; prazo: string | null; vencida: boolean;
  } | null;
  detalhesAlertas?: {
    impedimentos: { id: string; titulo: string; prioridade: string; prazo: string | null }[];
    pendenciasVencidas: { id: string; titulo: string; prioridade: string; prazo: string | null }[];
    marcosAtrasados: { id: string; nome: string; data_prevista: string | null }[];
    acoesVencidas: { id: string; titulo: string; prioridade: string; prazo: string | null }[];
  };
  indicadores: {
    projetoAtrasado: boolean; diasAtraso: number; pendenciasAbertas: number;
    pendenciasVencidas: number; impedimentosAbertos: number; impedimentosCriticos: number;
    marcosAtrasados: number; acoesAbertas: number; acoesVencidas: number;
  };
};

type ExecutiveMilestone = {
  id: string; projeto_id: string; nome: string; status: string; data_prevista: string | null;
  projeto: { id: string; nome: string; cliente?: { id: string; nome: string } | null } | null;
};

type ExecutiveDashboard = {
  success: boolean; atualizadoEm: string;
  resumo: {
    total: number; ativos: number; estaveis: number; atencao: number; criticos: number;
    atrasados: number; bloqueados: number; semPrazo: number; pendenciasAbertas: number;
    pendenciasVencidas: number; impedimentos: number; impedimentosCriticos: number;
    marcosAtrasados: number; acoesAbertas: number; acoesVencidas: number; proximosMarcos: number;
  };
  ranking: ExecutiveProject[]; projetos: ExecutiveProject[]; proximosMarcos: ExecutiveMilestone[];
};

const slides = [
  { key: "agora", label: "Agora", icon: Activity },
  { key: "problemas", label: "Problemas", icon: AlertTriangle },
  { key: "riscos", label: "Riscos", icon: ShieldAlert },
  { key: "pendencias", label: "Pendências", icon: Clock3 },
  { key: "areas", label: "Áreas", icon: Layers3 },
  { key: "marcos", label: "Marcos", icon: CalendarDays },
  { key: "capacidade", label: "Capacidade", icon: Users },
  { key: "guerra", label: "Guerra", icon: Zap },
] as const;

type SlideKey = (typeof slides)[number]["key"];

const normalize = (value?: string | null) =>
  (value ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

function localDate(value: string | null) {
  if (!value) return null;
  const [y, m, d] = value.slice(0, 10).split("-").map(Number);
  if (!y || !m || !d) return null;
  return new Date(y, m - 1, d);
}

function diffDays(value: string | null) {
  const date = localDate(value);
  if (!date) return null;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  date.setHours(0, 0, 0, 0);
  return Math.round((date.getTime() - today.getTime()) / 86400000);
}

function fmtDate(value: string | null) {
  const d = localDate(value);
  return d ? d.toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit" }) : "Sem prazo";
}

function isClosed(p: Projeto) {
  const s = normalize(p.status);
  return s === "finalizado" || s === "cancelado";
}

function rankProject(p: Projeto): Ranked {
  const reasons: string[] = [];
  const late = diffDays(p.data_fim);
  const lateDays = late !== null && late < 0 && !isClosed(p) ? Math.abs(late) : 0;
  const status = normalize(p.status);
  const priority = normalize(p.prioridade);

  const isBlocked = status === "bloqueado";
  const isPaused = status === "pausado";
  const isCriticalPriority = priority === "critica";
  const isHighPriority = priority === "alta";
  const hasOwner = Boolean(p.responsavel_nome?.trim());
  const hasDeadline = Boolean(p.data_fim);

  if (isBlocked) reasons.push("Bloqueado");
  if (isPaused) reasons.push("Pausado");
  if (lateDays > 0) reasons.push(`${lateDays}d de atraso`);
  if (isCriticalPriority) reasons.push("Prioridade crítica");
  else if (isHighPriority) reasons.push("Prioridade alta");
  if (!hasOwner) reasons.push("Sem responsável");
  if (!hasDeadline && !isClosed(p)) reasons.push("Sem prazo");

  const isCritical =
    isBlocked ||
    lateDays >= 15 ||
    (lateDays >= 7 && (isCriticalPriority || isHighPriority)) ||
    (isPaused && lateDays > 0);

  const isAttention =
    !isCritical &&
    (
      lateDays > 0 ||
      isCriticalPriority ||
      isPaused ||
      !hasOwner ||
      (!hasDeadline && (isHighPriority || isCriticalPriority))
    );

  const health: Health = isCritical
    ? "critical"
    : isAttention
      ? "attention"
      : "stable";

  // Score serve apenas para ordenar pressão/criticidade dentro da mesma regra executiva.
  let score = health === "critical" ? 100 : health === "attention" ? 50 : 0;

  if (isBlocked) score += 40;
  if (lateDays > 0) score += Math.min(30, lateDays);
  if (isCriticalPriority) score += 20;
  else if (isHighPriority) score += 10;
  if (isPaused) score += 8;
  if (!hasOwner) score += 5;
  if (!hasDeadline && (isHighPriority || isCriticalPriority)) score += 3;

  return { ...p, score, lateDays, reasons, health };
}

const healthClasses: Record<Health, string> = {
  critical: "border-rose-400/25 bg-rose-400/[0.08] text-rose-300",
  attention: "border-amber-400/25 bg-amber-400/[0.08] text-amber-300",
  stable: "border-emerald-400/25 bg-emerald-400/[0.08] text-emerald-300",
};

function Kpi({ label, value, helper, tone = "sky" }: { label: string; value: string | number; helper: string; tone?: "sky" | "rose" | "amber" | "emerald" }) {
  const toneClass = tone === "rose" ? "text-rose-300" : tone === "amber" ? "text-amber-300" : tone === "emerald" ? "text-emerald-300" : "text-sky-300";
  return (
    <div className="min-h-0 rounded-2xl border border-white/[0.08] bg-white/[0.035] p-[clamp(12px,1.1vw,20px)] shadow-[0_18px_60px_rgba(0,0,0,.18)]">
      <div className="text-[clamp(9px,.62vw,12px)] font-semibold uppercase tracking-[.16em] text-slate-500">{label}</div>
      <div className={`mt-2 text-[clamp(24px,2.2vw,44px)] font-semibold tracking-[-.05em] ${toneClass}`}>{value}</div>
      <div className="mt-1 text-[clamp(9px,.65vw,12px)] text-slate-500">{helper}</div>
    </div>
  );
}

function Panel({ title, subtitle, children, className = "" }: { title: string; subtitle?: string; children: React.ReactNode; className?: string }) {
  return (
    <section className={`min-h-0 overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.03] ${className}`}>
      <div className="border-b border-white/[0.07] px-[clamp(14px,1.2vw,22px)] py-[clamp(10px,.8vw,15px)]">
        <h3 className="text-[clamp(15px,1.05vw,20px)] font-semibold tracking-[-.02em] text-white">{title}</h3>
        {subtitle && <p className="mt-0.5 text-[clamp(11px,.72vw,14px)] text-slate-400">{subtitle}</p>}
      </div>
      <div className="h-[calc(100%-58px)] min-h-0 overflow-auto px-[clamp(12px,1vw,18px)] py-2">{children}</div>
    </section>
  );
}

function ProjectRows({ items, limit = 8 }: { items: Ranked[]; limit?: number }) {
  return (
    <div className="divide-y divide-white/[0.07]">
      {items.slice(0, limit).map((p, i) => (
        <div
          key={p.id}
          className="grid w-full grid-cols-[44px_minmax(0,1fr)] items-center gap-4 px-2 py-[clamp(10px,1vh,16px)]"
        >
          <span className="text-[clamp(11px,.72vw,14px)] font-medium text-slate-500">
            {String(i + 1).padStart(2, "0")}
          </span>

          <div className="min-w-0">
            <div className="flex min-w-0 flex-wrap items-center gap-2.5">
              <span className="truncate text-[clamp(14px,1vw,19px)] font-semibold tracking-[-.02em] text-slate-100">
                {p.nome}
              </span>
              <span
                className={`rounded-full border px-2.5 py-1 text-[clamp(9px,.62vw,12px)] font-bold uppercase tracking-[.05em] ${healthClasses[p.health]}`}
              >
                {p.health === "critical" ? "Crítico" : p.health === "attention" ? "Atenção" : "Estável"}
              </span>
            </div>

            <div className="mt-1.5 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-[clamp(11px,.76vw,14px)] text-slate-400">
              <span className="font-medium text-slate-300">{p.cliente?.nome ?? "Sem cliente"}</span>
              <span className="text-slate-600">•</span>
              <span>{p.reasons.join(" • ") || "Operação estável"}</span>
              {p.responsavel_nome && (
                <>
                  <span className="text-slate-600">•</span>
                  <span>Resp. {p.responsavel_nome}</span>
                </>
              )}
            </div>
          </div>
        </div>
      ))}

      {items.length === 0 && (
        <div className="py-10 text-center text-[clamp(12px,.8vw,15px)] text-slate-500">
          Nenhum item para exibir.
        </div>
      )}
    </div>
  );
}


function PendingAgingRanking({
  items,
  executiveById,
  onOpenProjeto,
}: {
  items: Ranked[];
  executiveById: Map<string, ExecutiveProject>;
  onOpenProjeto: (id: string) => void;
}) {
  const rows = items
    .map((p) => {
      const ex = executiveById.get(p.id);

      const pendencias =
        ex?.indicadores.pendenciasVencidas ?? 0;

      const impedimentos =
        ex?.indicadores.impedimentosAbertos ?? 0;

      const acoes =
        ex?.indicadores.acoesVencidas ?? 0;

      const marcos =
        ex?.indicadores.marcosAtrasados ?? 0;

      const abertas =
        ex?.indicadores.pendenciasAbertas ?? 0;

      const totalVencido =
        pendencias +
        impedimentos +
        acoes +
        marcos;

      return {
        p,
        ex,
        pendencias,
        impedimentos,
        acoes,
        marcos,
        abertas,
        totalVencido,
      };
    })
    .filter(
      (x) =>
        x.totalVencido > 0 ||
        x.abertas > 0
    )
    .sort(
      (a, b) =>
        b.totalVencido - a.totalVencido ||
        b.p.score - a.p.score
    );

  return (
    <div className="h-full min-h-0 overflow-y-auto pr-1">
      <div
        className="
          grid
          grid-cols-1
          gap-3
          pb-3
          md:grid-cols-2
          xl:grid-cols-3
          2xl:grid-cols-4
        "
      >
        {rows.map(
          (
            {
              p,
              ex,
              pendencias,
              impedimentos,
              acoes,
              marcos,
              abertas,
              totalVencido,
            },
            i
          ) => {
            const temCritico =
              p.health === "critical";

            const proximaAcao =
              ex?.proximaAcao;

            return (
              <button
                key={p.id}
                onClick={() =>
                  onOpenProjeto(p.id)
                }
                className="
                  group
                  relative
                  flex
                  min-h-[210px]
                  flex-col
                  overflow-hidden
                  rounded-2xl
                  border
                  border-white/[0.08]
                  bg-black/[0.12]
                  p-4
                  text-left
                  transition
                  duration-200
                  hover:-translate-y-0.5
                  hover:border-sky-400/25
                  hover:bg-white/[0.035]
                "
              >
                <div
                  className={`
                    absolute
                    left-0
                    top-0
                    h-full
                    w-[3px]
                    ${
                      temCritico
                        ? "bg-rose-400"
                        : p.health === "attention"
                          ? "bg-amber-400"
                          : "bg-emerald-400"
                    }
                  `}
                />

                <div className="flex items-start justify-between gap-3">
                  <div className="min-w-0">
                    <div className="mb-1 text-[9px] font-semibold uppercase tracking-[.15em] text-slate-600">
                      #{String(i + 1).padStart(
                        2,
                        "0"
                      )}
                    </div>

                    <div className="flex min-w-0 items-center gap-2">
                      <h3 className="truncate text-[15px] font-semibold text-white">
                        {p.nome}
                      </h3>

                      <span
                        className={`
                          shrink-0
                          rounded-full
                          border
                          px-2
                          py-0.5
                          text-[8px]
                          font-bold
                          uppercase
                          ${healthClasses[p.health]}
                        `}
                      >
                        {p.health ===
                        "critical"
                          ? "Crítico"
                          : p.health ===
                              "attention"
                            ? "Atenção"
                            : "Estável"}
                      </span>
                    </div>

                    <div className="mt-1 truncate text-[10px] text-slate-500">
                      {p.responsavel_nome ||
                        "Sem responsável"}
                    </div>
                  </div>

                  <div className="shrink-0 text-right">
                    <div className="text-[8px] uppercase tracking-[.12em] text-slate-600">
                      Ocorrências
                    </div>

                    <div
                      className={`mt-0.5 text-xl font-semibold ${
                        totalVencido > 0
                          ? "text-amber-300"
                          : "text-emerald-300"
                      }`}
                    >
                      {totalVencido}
                    </div>
                  </div>
                </div>

                <div className="my-3 h-px bg-white/[0.06]" />

                <div className="grid grid-cols-4 gap-2">
                  <div className="rounded-xl border border-white/[0.06] bg-black/10 px-2 py-2">
                    <div className="text-[7px] font-semibold uppercase tracking-[.1em] text-slate-600">
                      Pend.
                    </div>

                    <div
                      className={`mt-1 text-base font-semibold ${
                        pendencias
                          ? "text-rose-300"
                          : "text-slate-400"
                      }`}
                    >
                      {pendencias}
                    </div>
                  </div>

                  <div className="rounded-xl border border-white/[0.06] bg-black/10 px-2 py-2">
                    <div className="text-[7px] font-semibold uppercase tracking-[.1em] text-slate-600">
                      Imped.
                    </div>

                    <div
                      className={`mt-1 text-base font-semibold ${
                        impedimentos
                          ? "text-rose-300"
                          : "text-slate-400"
                      }`}
                    >
                      {impedimentos}
                    </div>
                  </div>

                  <div className="rounded-xl border border-white/[0.06] bg-black/10 px-2 py-2">
                    <div className="text-[7px] font-semibold uppercase tracking-[.1em] text-slate-600">
                      Ações
                    </div>

                    <div
                      className={`mt-1 text-base font-semibold ${
                        acoes
                          ? "text-amber-300"
                          : "text-slate-400"
                      }`}
                    >
                      {acoes}
                    </div>
                  </div>

                  <div className="rounded-xl border border-white/[0.06] bg-black/10 px-2 py-2">
                    <div className="text-[7px] font-semibold uppercase tracking-[.1em] text-slate-600">
                      Marcos
                    </div>

                    <div
                      className={`mt-1 text-base font-semibold ${
                        marcos
                          ? "text-amber-300"
                          : "text-slate-400"
                      }`}
                    >
                      {marcos}
                    </div>
                  </div>
                </div>

                <div className="mt-3 flex-1 rounded-xl border border-white/[0.06] bg-black/[0.10] px-3 py-2">
                  <div className="text-[7px] font-semibold uppercase tracking-[.12em] text-slate-600">
                    Próxima ação
                  </div>

                  <div
                    className={`mt-1 truncate text-[11px] font-medium ${
                      proximaAcao?.vencida
                        ? "text-rose-300"
                        : "text-sky-300"
                    }`}
                  >
                    {proximaAcao?.titulo ||
                      "Nenhuma ação aberta"}
                  </div>

                  <div className="mt-1 flex items-center justify-between gap-2 text-[8px] text-slate-600">
                    <span>
                      {abertas} pendência(s)
                      aberta(s)
                    </span>

                    {proximaAcao?.prazo && (
                      <span
                        className={
                          proximaAcao.vencida
                            ? "text-rose-400"
                            : ""
                        }
                      >
                        {proximaAcao.vencida
                          ? "Vencida"
                          : "Prazo"}
                        {" · "}
                        {fmtDate(
                          proximaAcao.prazo
                        )}
                      </span>
                    )}
                  </div>
                </div>
              </button>
            );
          }
        )}

        {rows.length === 0 && (
          <div className="col-span-full flex min-h-[300px] items-center justify-center rounded-2xl border border-dashed border-white/[0.08]">
            <div className="text-center">
              <div className="text-sm font-semibold text-slate-300">
                Nenhuma ocorrência aberta
              </div>

              <div className="mt-1 text-xs text-slate-600">
                Não existem pendências,
                impedimentos, ações vencidas
                ou marcos atrasados.
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
function RiskRanking({
  items,
  executiveById,
  onOpenProjeto,
}: {
  items: Ranked[];
  executiveById: Map<string, ExecutiveProject>;
  onOpenProjeto: (id: string) => void;
}) {
  return (
    <div className="divide-y divide-white/[0.07]">
      {items.slice(0, 10).map((p, i) => {
        const ex = executiveById.get(p.id);
        const bloqueado = normalize(p.status) === "bloqueado";
        const impedimentos = ex?.indicadores.impedimentosAbertos ?? 0;
        const impedimentosCriticos = ex?.indicadores.impedimentosCriticos ?? 0;
        const pendencias = ex?.indicadores.pendenciasVencidas ?? 0;
        const acoes = ex?.indicadores.acoesVencidas ?? 0;
        const marcos = ex?.indicadores.marcosAtrasados ?? 0;

        return (
          <button key={p.id} onClick={() => onOpenProjeto(p.id)} className="grid w-full grid-cols-[38px_minmax(190px,1.2fr)_110px_120px_115px_minmax(180px,1fr)] items-center gap-3 px-2 py-[clamp(9px,.9vh,14px)] text-left transition hover:bg-white/[0.025]">
            <span className="text-xs font-medium text-slate-600">{String(i + 1).padStart(2, "0")}</span>
            <div className="min-w-0">
              <div className="flex items-center gap-2"><span className="truncate text-[clamp(13px,.9vw,17px)] font-semibold text-white">{p.nome}</span><span className={`shrink-0 rounded-full border px-2 py-0.5 text-[9px] font-bold uppercase ${healthClasses[p.health]}`}>{p.health === "critical" ? "Crítico" : "Atenção"}</span></div>
              <div className="mt-1 truncate text-[11px] text-slate-500">{p.reasons.join(" • ") || "Pressão operacional"}</div>
            </div>
            <div><div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Bloqueio</div><div className={`mt-1 text-sm font-semibold ${bloqueado || impedimentos ? "text-rose-300" : "text-emerald-300"}`}>{bloqueado ? "Bloqueado" : impedimentos ? `${impedimentos} imped.` : "Livre"}</div>{impedimentosCriticos > 0 && <div className="text-[9px] text-rose-400">{impedimentosCriticos} crítico(s)</div>}</div>
            <div><div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Aging / atraso</div><div className={`mt-1 text-sm font-semibold ${p.lateDays ? "text-rose-300" : "text-slate-300"}`}>{p.lateDays ? `${p.lateDays} dias` : "Sem atraso"}</div></div>
            <div className="min-w-0"><div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Responsável</div><div className="mt-1 truncate text-xs font-medium text-slate-300">{p.responsavel_nome || "Sem responsável"}</div></div>
            <div className="min-w-0"><div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Impacto operacional</div><div className="mt-1 truncate text-xs font-medium text-amber-300">{[pendencias ? `${pendencias} pend. venc.` : "", acoes ? `${acoes} ação(ões) venc.` : "", marcos ? `${marcos} marco(s) atras.` : ""].filter(Boolean).join(" • ") || "Criticidade por prazo/prioridade"}</div><div className="mt-0.5 truncate text-[9px] text-slate-600">Próxima ação: {ex?.proximaAcao?.titulo || "não cadastrada"}</div></div>
          </button>
        );
      })}
      {items.length === 0 && <div className="py-14 text-center text-sm text-slate-500">Nenhum risco ou bloqueio identificado.</div>}
    </div>
  );
}

function ProblemRanking({
  items,
  executiveById,
  onOpenProjeto,
}: {
  items: Ranked[];
  executiveById: Map<string, ExecutiveProject>;
  onOpenProjeto: (id: string) => void;
}) {
  return (
    <div className="divide-y divide-white/[0.07]">
      {items.slice(0, 10).map((p, i) => {
        const ex = executiveById.get(p.id);
        const pendencias = ex?.indicadores.pendenciasVencidas ?? 0;
        const impedimentos = ex?.indicadores.impedimentosAbertos ?? 0;
        const acoes = ex?.indicadores.acoesVencidas ?? 0;
        const marcos = ex?.indicadores.marcosAtrasados ?? 0;
        const ocorrencias = pendencias + impedimentos + acoes + marcos;

        return (
          <button
            key={p.id}
            onClick={() => onOpenProjeto(p.id)}
            className="grid w-full grid-cols-[38px_minmax(190px,1.25fr)_105px_105px_125px_minmax(190px,1fr)] items-center gap-3 px-2 py-[clamp(9px,.9vh,14px)] text-left transition hover:bg-white/[0.025]"
          >
            <span className="text-xs font-medium text-slate-600">{String(i + 1).padStart(2, "0")}</span>

            <div className="min-w-0">
              <div className="flex items-center gap-2">
                <span className="truncate text-[clamp(13px,.9vw,17px)] font-semibold text-white">{p.nome}</span>
                <span className={`shrink-0 rounded-full border px-2 py-0.5 text-[9px] font-bold uppercase ${healthClasses[p.health]}`}>
                  {p.health === "critical" ? "Crítico" : p.health === "attention" ? "Atenção" : "Estável"}
                </span>
              </div>
              <div className="mt-1 truncate text-[11px] text-slate-500">
                {p.reasons.join(" • ") || "Sem motivo crítico"}
              </div>
            </div>

            <div>
              <div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Atraso</div>
              <div className={`mt-1 text-sm font-semibold ${p.lateDays ? "text-rose-300" : "text-emerald-300"}`}>
                {p.lateDays ? `${p.lateDays} dias` : "No prazo"}
              </div>
            </div>

            <div>
              <div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Ocorrências</div>
              <div className={`mt-1 text-sm font-semibold ${ocorrencias ? "text-amber-300" : "text-slate-400"}`}>
                {ocorrencias}
              </div>
              <div className="text-[9px] text-slate-600">P {pendencias} · I {impedimentos} · A {acoes} · M {marcos}</div>
            </div>

            <div className="min-w-0">
              <div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Responsável</div>
              <div className="mt-1 truncate text-xs font-medium text-slate-300">{p.responsavel_nome || "Sem responsável"}</div>
            </div>

            <div className="min-w-0">
              <div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Próxima ação</div>
              <div className={`mt-1 truncate text-xs font-medium ${ex?.proximaAcao?.vencida ? "text-rose-300" : "text-sky-300"}`}>
                {ex?.proximaAcao?.titulo || "Nenhuma ação aberta"}
              </div>
              {ex?.proximaAcao?.prazo && (
                <div className="mt-0.5 text-[9px] text-slate-600">
                  {ex.proximaAcao.vencida ? "Vencida" : "Prazo"} · {fmtDate(ex.proximaAcao.prazo)}
                </div>
              )}
            </div>
          </button>
        );
      })}
    </div>
  );
}

export default function ControlTowerLive({ projetos, onOpenProjeto, onExit }: Props) {
  const [slide, setSlide] = useState(0);
  const [auto, setAuto] = useState(true);
  const [now, setNow] = useState(new Date());
  const [lastUpdate, setLastUpdate] = useState(new Date());
  const [executive, setExecutive] = useState<ExecutiveDashboard | null>(null);
  const [liveError, setLiveError] = useState<string | null>(null);
  const [refreshing, setRefreshing] = useState(false);

  const loadExecutive = useCallback(async () => {
    try {
      setRefreshing(true);
      const response = await fetch("/api/dashboard/executivo", { cache: "no-store", credentials: "same-origin" });
      const body = await response.json();
      if (!response.ok || !body?.success) throw new Error(body?.error || `Falha HTTP ${response.status}`);
      setExecutive(body as ExecutiveDashboard);
      setLiveError(null);
      setLastUpdate(new Date(body.atualizadoEm || Date.now()));
    } catch (error) {
      setLiveError(error instanceof Error ? error.message : "Falha ao atualizar dados executivos.");
    } finally {
      setRefreshing(false);
    }
  }, []);

  const exit = useCallback(() => {
    if (document.fullscreenElement) document.exitFullscreen().catch(() => undefined);
    onExit();
  }, [onExit]);

  useEffect(() => {
    const key = (e: KeyboardEvent) => { if (e.key === "Escape") exit(); };
    window.addEventListener("keydown", key);
    return () => window.removeEventListener("keydown", key);
  }, [exit]);

  useEffect(() => {
    const t = window.setInterval(() => setNow(new Date()), 1000);
    return () => window.clearInterval(t);
  }, []);

  useEffect(() => {
    void loadExecutive();
    const t = window.setInterval(() => void loadExecutive(), 60000);
    return () => window.clearInterval(t);
  }, [loadExecutive]);

  useEffect(() => {
    if (!auto) return;
    const t = window.setInterval(() => setSlide((s) => (s + 1) % slides.length), 15000);
    return () => window.clearInterval(t);
  }, [auto]);

  const localById = useMemo(() => new Map(projetos.map((p) => [p.id, p])), [projetos]);

  const ranked = useMemo<Ranked[]>(() => {
    if (!executive) return projetos.filter((p) => !isClosed(p)).map(rankProject).sort((a,b)=>b.score-a.score);
    return executive.projetos.map((item) => {
      const local = localById.get(item.id);
      if (!local) return null;
      const health: Health = item.saude === "Crítico" ? "critical" : item.saude === "Atenção" ? "attention" : "stable";
      return {
        ...local,
        status: item.status ?? local.status,
        prioridade: item.prioridade ?? local.prioridade,
        percentual: Number(item.percentual ?? local.percentual ?? 0),
        data_fim: item.data_fim ?? local.data_fim,
        responsavel_nome: item.responsavel?.nome ?? local.responsavel_nome,
        score: item.score, lateDays: item.lateDays ?? item.indicadores.diasAtraso,
        reasons: item.motivos ?? [], health,
      } as Ranked;
    }).filter((x): x is Ranked => x !== null).sort((a,b)=>b.score-a.score);
  }, [executive, localById, projetos]);

  const executiveById = useMemo(() => new Map((executive?.projetos ?? []).map(p=>[p.id,p])), [executive]);
  const critical = ranked.filter((p) => p.health === "critical");
  const attention = ranked.filter((p) => p.health === "attention");
  const stable = ranked.filter((p) => p.health === "stable");
  const delayed = ranked.filter((p) => p.lateDays > 0);
  const blocked = ranked.filter((p) => normalize(p.status) === "bloqueado");
  const noDeadline = ranked.filter((p) => !p.data_fim);
  const avg = ranked.length ? Math.round(ranked.reduce((a,p)=>a+(p.percentual||0),0)/ranked.length) : 0;
  const healthPct = ranked.length ? Math.round((stable.length/ranked.length)*100) : 100;
  const summary = executive?.resumo ?? {
    total: projetos.length, ativos: ranked.length, estaveis: stable.length, atencao: attention.length,
    criticos: critical.length, atrasados: delayed.length, bloqueados: blocked.length, semPrazo: noDeadline.length,
    pendenciasAbertas: 0, pendenciasVencidas: 0, impedimentos: 0, impedimentosCriticos: 0,
    marcosAtrasados: 0, acoesAbertas: 0, acoesVencidas: 0, proximosMarcos: 0,
  };

  const areas = useMemo(() => {
    const names = ["Comercial","Implantação","Desenvolvimento","Suporte"];
    return names.map(name => {
      const n=normalize(name);
      const items=ranked.filter(p=>normalize(p.setor).includes(n)||normalize(p.fase_origem).includes(n)||normalize(p.etapa?.nome).includes(n));
      return {name,total:items.length,critical:items.filter(p=>p.health==="critical").length,delayed:items.filter(p=>p.lateDays>0).length,blocked:items.filter(p=>normalize(p.status)==="bloqueado").length};
    });
  },[ranked]);

  const owners = useMemo(() => {
    const map=new Map<string,Ranked[]>();
    ranked.forEach(p=>{const k=p.responsavel_nome?.trim()||"Sem responsável";map.set(k,[...(map.get(k)??[]),p]);});
    return [...map.entries()].map(([name,items])=>({name,total:items.length,critical:items.filter(p=>p.health==="critical").length,delayed:items.filter(p=>p.lateDays>0).length,pressure:items.reduce((a,p)=>a+p.score,0)})).sort((a,b)=>b.pressure-a.pressure);
  },[ranked]);

  const operationalProblems = useMemo(() => ranked.filter(p => {
    const x=executiveById.get(p.id);
    return !!x && (x.indicadores.pendenciasVencidas>0 || x.indicadores.impedimentosAbertos>0 || x.indicadores.marcosAtrasados>0 || x.indicadores.acoesVencidas>0);
  }),[executiveById,ranked]);

  const milestones = useMemo(() => executive?.proximosMarcos ?? [], [executive]);

  const goFullscreen = async () => {
    if (!document.fullscreenElement) await document.documentElement.requestFullscreen().catch(() => undefined);
    else await document.exitFullscreen().catch(() => undefined);
  };

  const next = () => setSlide((s) => (s + 1) % slides.length);
  const prev = () => setSlide((s) => (s - 1 + slides.length) % slides.length);
  const current = slides[slide].key as SlideKey;

  const renderSlide = () => {
    if (current === "agora") return <>
      <div className="grid min-h-0 grid-cols-6 gap-3">
        <Kpi label="Projetos ativos" value={summary.ativos} helper={`${avg}% progresso médio`} />
        <Kpi label="Críticos" value={summary.criticos} helper="Ação imediata" tone="rose" />
        <Kpi label="Em atenção" value={summary.atencao} helper="Monitorar de perto" tone="amber" />
        <Kpi label="Atrasados" value={summary.atrasados} helper="Prazo ultrapassado" tone="rose" />
        <Kpi label="Bloqueados" value={summary.bloqueados} helper="Fluxo interrompido" tone={summary.bloqueados ? "rose" : "emerald"} />
        <Kpi label="Sem prazo" value={summary.semPrazo} helper="Previsão necessária" tone="amber" />
      </div>
      <div className="grid min-h-0 flex-1 grid-cols-[.72fr_1.28fr] gap-3">
        <Panel title="Saúde da carteira" subtitle="Percentual dos projetos ativos classificados como estáveis">
          <div className="flex h-full flex-col justify-center">
            <div className="text-[clamp(42px,5vw,82px)] font-semibold tracking-[-.07em] text-white">{healthPct}<span className="ml-2 text-2xl text-slate-500">%</span></div>
            <div className="mt-5 h-2.5 overflow-hidden rounded-full bg-black/40"><div className="h-full rounded-full bg-emerald-400" style={{width:`${healthPct}%`}}/></div>
            <div className="mt-5 grid grid-cols-3 gap-2 text-center"><Kpi label="Crítico" value={summary.criticos} helper="" tone="rose"/><Kpi label="Atenção" value={summary.atencao} helper="" tone="amber"/><Kpi label="Estável" value={summary.estaveis} helper="" tone="emerald"/></div>
          </div>
        </Panel>
        <Panel title="Atenção imediata" subtitle="Projetos com maior criticidade neste momento"><ProjectRows items={ranked} limit={7}/></Panel>
      </div>
    </>;

    if (current === "problemas") return <div className="grid min-h-0 flex-1 grid-cols-[1.58fr_.42fr] gap-3"><Panel title="Mapa de Problemas" subtitle="Ranking executivo: criticidade, motivo, atraso, ocorrências, responsável e próxima ação"><ProblemRanking items={ranked} executiveById={executiveById} onOpenProjeto={onOpenProjeto}/></Panel><div className="grid min-h-0 grid-rows-5 gap-3"><Kpi label="Críticos" value={summary.criticos} helper="Decisão imediata" tone="rose"/><Kpi label="Atrasados" value={summary.atrasados} helper="Projetos fora do prazo" tone="rose"/><Kpi label="Pendências vencidas" value={summary.pendenciasVencidas} helper="Pendências reais" tone="amber"/><Kpi label="Ações vencidas" value={summary.acoesVencidas} helper="Ações reais" tone="amber"/><Kpi label="Marcos atrasados" value={summary.marcosAtrasados} helper="Marcos reais" tone="rose"/></div></div>;

    if (current === "riscos") {
      const riskItems = ranked.filter((p) => {
        const ex = executiveById.get(p.id);
        return p.health === "critical" || normalize(p.status) === "bloqueado" || (ex?.indicadores.impedimentosAbertos ?? 0) > 0 || (ex?.indicadores.impedimentosCriticos ?? 0) > 0;
      });
      return <div className="grid min-h-0 flex-1 grid-cols-[1.58fr_.42fr] gap-3"><Panel title="Riscos e bloqueios" subtitle="Criticidade, bloqueio, impacto, responsável, aging e próxima ação"><RiskRanking items={riskItems} executiveById={executiveById} onOpenProjeto={onOpenProjeto}/></Panel><div className="grid min-h-0 grid-rows-5 gap-3"><Kpi label="Riscos críticos" value={critical.length} helper="Projetos críticos" tone="rose"/><Kpi label="Bloqueados" value={summary.bloqueados} helper="Status bloqueado" tone={summary.bloqueados ? "rose" : "emerald"}/><Kpi label="Impedimentos" value={summary.impedimentos} helper={`${summary.impedimentosCriticos} críticos`} tone={summary.impedimentosCriticos ? "rose" : "amber"}/><Kpi label="Atrasados" value={summary.atrasados} helper="Aging por prazo" tone="rose"/><Kpi label="Ocorrências vencidas" value={summary.pendenciasVencidas + summary.acoesVencidas + summary.marcosAtrasados} helper="Pendências + ações + marcos" tone="amber"/></div></div>;
    }

    if (current === "pendencias")
      return (
        <div className="grid min-h-0 flex-1 grid-cols-[1.58fr_.42fr] gap-3">
          <Panel
            title="Pendências e Aging"
            subtitle="Vencidas, impedimentos, ações vencidas, marcos atrasados e responsável"
          >
            <PendingAgingRanking
              items={ranked}
              executiveById={executiveById}
              onOpenProjeto={onOpenProjeto}
            />
          </Panel>

          <div className="grid min-h-0 grid-rows-5 gap-3">
            <Kpi
              label="Pendências abertas"
              value={summary.pendenciasAbertas}
              helper="Total aberto"
            />

            <Kpi
              label="Pendências vencidas"
              value={summary.pendenciasVencidas}
              helper="Prazo ultrapassado"
              tone="rose"
            />

            <Kpi
              label="Impedimentos"
              value={summary.impedimentos}
              helper={`${summary.impedimentosCriticos} críticos`}
              tone={
                summary.impedimentosCriticos
                  ? "rose"
                  : "amber"
              }
            />

            <Kpi
              label="Ações vencidas"
              value={summary.acoesVencidas}
              helper={`${summary.acoesAbertas} ações abertas`}
              tone="amber"
            />

            <Kpi
              label="Marcos atrasados"
              value={summary.marcosAtrasados}
              helper="Prazo ultrapassado"
              tone="rose"
            />
          </div>
        </div>
      );
    if (current === "areas") {
      const areas = [
        "Comercial",
        "Implantação",
        "Desenvolvimento",
        "Suporte",
      ];

      const dadosAreas = areas.map((area) => {
        const projetosArea = ranked.filter(
          (p) => normalize(p.setor) === normalize(area)
        );

        const criticos = projetosArea.filter(
          (p) => p.health === "critical"
        ).length;

        const atencao = projetosArea.filter(
          (p) => p.health === "attention"
        ).length;

        const estaveis = projetosArea.filter(
          (p) => p.health === "stable"
        ).length;

        const atrasados = projetosArea.filter(
          (p) => p.lateDays > 0
        ).length;

        const bloqueados = projetosArea.filter(
          (p) => normalize(p.status) === "bloqueado"
        ).length;

        const semPrazo = projetosArea.filter(
          (p) => !p.data_fim
        ).length;

        const ocorrencias = projetosArea.reduce(
          (total, p) => {
            const ex = executiveById.get(p.id);

            return (
              total +
              (ex?.indicadores.pendenciasVencidas ?? 0) +
              (ex?.indicadores.impedimentosAbertos ?? 0) +
              (ex?.indicadores.acoesVencidas ?? 0) +
              (ex?.indicadores.marcosAtrasados ?? 0)
            );
          },
          0
        );

        const progresso =
          projetosArea.length > 0
            ? Math.round(
                projetosArea.reduce(
                  (total, p) =>
                    total +
                    Number(p.percentual || 0),
                  0
                ) / projetosArea.length
              )
            : 0;

        const pressao =
          criticos * 100 +
          atencao * 50 +
          atrasados * 20 +
          bloqueados * 40 +
          ocorrencias * 10;

        return {
          area,
          projetosArea,
          total: projetosArea.length,
          criticos,
          atencao,
          estaveis,
          atrasados,
          bloqueados,
          semPrazo,
          ocorrencias,
          progresso,
          pressao,
        };
      });

      const maiorPressao = Math.max(
        1,
        ...dadosAreas.map((a) => a.pressao)
      );

      return (
        <div className="grid min-h-0 flex-1 grid-cols-[1fr_310px] gap-3">
          <Panel
            title="Radar das Áreas"
            subtitle="Comercial, Implantação, Desenvolvimento e Suporte na mesma visão operacional"
          >
            <div className="grid h-full min-h-0 grid-cols-2 gap-3 overflow-y-auto pr-1">
              {dadosAreas.map((area) => {
                const percentualPressao = Math.round(
                  (area.pressao / maiorPressao) * 100
                );

                const statusArea =
                  area.criticos > 0
                    ? "Crítica"
                    : area.atencao > 0 ||
                        area.atrasados > 0
                      ? "Atenção"
                      : "Estável";

                const statusClass =
                  statusArea === "Crítica"
                    ? "border-rose-400/25 bg-rose-400/10 text-rose-300"
                    : statusArea === "Atenção"
                      ? "border-amber-400/25 bg-amber-400/10 text-amber-300"
                      : "border-emerald-400/25 bg-emerald-400/10 text-emerald-300";

                return (
                  <div
                    key={area.area}
                    className="
                      relative
                      overflow-hidden
                      rounded-2xl
                      border
                      border-white/[0.08]
                      bg-black/[0.12]
                      p-4
                    "
                  >
                    <div
                      className={`absolute left-0 top-0 h-full w-[3px] ${
                        statusArea === "Crítica"
                          ? "bg-rose-400"
                          : statusArea === "Atenção"
                            ? "bg-amber-400"
                            : "bg-emerald-400"
                      }`}
                    />

                    <div className="flex items-start justify-between gap-3">
                      <div>
                        <div className="text-[9px] font-semibold uppercase tracking-[.15em] text-slate-600">
                          Área operacional
                        </div>

                        <div className="mt-1 text-lg font-semibold text-white">
                          {area.area}
                        </div>
                      </div>

                      <span
                        className={`rounded-full border px-2.5 py-1 text-[9px] font-bold uppercase ${statusClass}`}
                      >
                        {statusArea}
                      </span>
                    </div>

                    <div className="mt-4 grid grid-cols-4 gap-2">
                      <div className="rounded-xl border border-white/[0.06] bg-black/10 p-2.5">
                        <div className="text-[7px] font-semibold uppercase tracking-[.1em] text-slate-600">
                          Projetos
                        </div>
                        <div className="mt-1 text-xl font-semibold text-white">
                          {area.total}
                        </div>
                      </div>

                      <div className="rounded-xl border border-white/[0.06] bg-black/10 p-2.5">
                        <div className="text-[7px] font-semibold uppercase tracking-[.1em] text-slate-600">
                          Críticos
                        </div>
                        <div className="mt-1 text-xl font-semibold text-rose-300">
                          {area.criticos}
                        </div>
                      </div>

                      <div className="rounded-xl border border-white/[0.06] bg-black/10 p-2.5">
                        <div className="text-[7px] font-semibold uppercase tracking-[.1em] text-slate-600">
                          Atenção
                        </div>
                        <div className="mt-1 text-xl font-semibold text-amber-300">
                          {area.atencao}
                        </div>
                      </div>

                      <div className="rounded-xl border border-white/[0.06] bg-black/10 p-2.5">
                        <div className="text-[7px] font-semibold uppercase tracking-[.1em] text-slate-600">
                          Estáveis
                        </div>
                        <div className="mt-1 text-xl font-semibold text-emerald-300">
                          {area.estaveis}
                        </div>
                      </div>
                    </div>

                    <div className="mt-3 grid grid-cols-4 gap-2">
                      <div>
                        <div className="text-[8px] uppercase tracking-[.1em] text-slate-600">
                          Atrasados
                        </div>
                        <div className={`mt-1 text-sm font-semibold ${area.atrasados ? "text-rose-300" : "text-slate-400"}`}>
                          {area.atrasados}
                        </div>
                      </div>

                      <div>
                        <div className="text-[8px] uppercase tracking-[.1em] text-slate-600">
                          Bloqueados
                        </div>
                        <div className={`mt-1 text-sm font-semibold ${area.bloqueados ? "text-rose-300" : "text-slate-400"}`}>
                          {area.bloqueados}
                        </div>
                      </div>

                      <div>
                        <div className="text-[8px] uppercase tracking-[.1em] text-slate-600">
                          Sem prazo
                        </div>
                        <div className={`mt-1 text-sm font-semibold ${area.semPrazo ? "text-amber-300" : "text-slate-400"}`}>
                          {area.semPrazo}
                        </div>
                      </div>

                      <div>
                        <div className="text-[8px] uppercase tracking-[.1em] text-slate-600">
                          Ocorrências
                        </div>
                        <div className={`mt-1 text-sm font-semibold ${area.ocorrencias ? "text-amber-300" : "text-slate-400"}`}>
                          {area.ocorrencias}
                        </div>
                      </div>
                    </div>

                    <div className="mt-4">
                      <div className="flex items-center justify-between text-[8px] uppercase tracking-[.1em] text-slate-600">
                        <span>Pressão operacional</span>
                        <span>{percentualPressao}%</span>
                      </div>

                      <div className="mt-1.5 h-2 overflow-hidden rounded-full bg-black/30">
                        <div
                          className={`h-full rounded-full ${
                            statusArea === "Crítica"
                              ? "bg-rose-400"
                              : statusArea === "Atenção"
                                ? "bg-amber-400"
                                : "bg-emerald-400"
                          }`}
                          style={{
                            width: `${Math.max(
                              area.pressao > 0
                                ? 6
                                : 0,
                              percentualPressao
                            )}%`,
                          }}
                        />
                      </div>
                    </div>

                    <div className="mt-3 flex items-center justify-between border-t border-white/[0.06] pt-3">
                      <div className="text-[9px] text-slate-500">
                        Progresso médio
                      </div>

                      <div className="text-sm font-semibold text-sky-300">
                        {area.progresso}%
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </Panel>

          <div className="grid min-h-0 grid-rows-4 gap-3">
            {dadosAreas.map((area) => (
              <div
                key={area.area}
                className="
                  rounded-2xl
                  border
                  border-white/[0.08]
                  bg-black/[0.12]
                  p-4
                "
              >
                <div className="text-[9px] font-semibold uppercase tracking-[.14em] text-slate-500">
                  {area.area}
                </div>

                <div className="mt-2 flex items-end justify-between">
                  <div>
                    <div className="text-3xl font-semibold text-white">
                      {area.total}
                    </div>
                    <div className="mt-1 text-[9px] text-slate-500">
                      projetos
                    </div>
                  </div>

                  <div className="text-right">
                    <div
                      className={`text-xl font-semibold ${
                        area.criticos
                          ? "text-rose-300"
                          : area.atencao
                            ? "text-amber-300"
                            : "text-emerald-300"
                      }`}
                    >
                      {area.criticos
                        ? `${area.criticos} crítico(s)`
                        : area.atencao
                          ? `${area.atencao} atenção`
                          : "Estável"}
                    </div>

                    <div className="mt-1 text-[9px] text-slate-600">
                      {area.atrasados} atrasado(s) ·{" "}
                      {area.ocorrencias} ocorrência(s)
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    }
    if (current === "marcos") return <div className="grid min-h-0 flex-1 grid-cols-[1.35fr_.65fr] gap-3"><Panel title="Timeline — próximos marcos" subtitle="Somente marcos reais cadastrados"><div className="divide-y divide-white/[0.06]">{milestones.slice(0,14).map(m=><button key={m.id} onClick={()=>onOpenProjeto(m.projeto_id)} className="grid w-full grid-cols-[80px_1fr_auto] items-center gap-4 py-3 text-left hover:bg-white/[.025]"><span className="text-lg font-semibold text-sky-300">{fmtDate(m.data_prevista)}</span><span><b className="block text-sm text-white">{m.nome}</b><small className="text-slate-500">{m.projeto?.nome??"Projeto"} · {m.projeto?.cliente?.nome??"Sem cliente"}</small></span><span className="text-xs text-slate-400">{m.status}</span></button>)}{milestones.length===0&&<div className="py-14 text-center text-sm text-slate-500">Nenhum marco futuro cadastrado.</div>}</div></Panel><div className="grid grid-rows-3 gap-3"><Kpi label="Próximos marcos" value={summary.proximosMarcos} helper="Dados cadastrados"/><Kpi label="Marcos atrasados" value={summary.marcosAtrasados} helper="Prazo ultrapassado" tone="rose"/><Kpi label="Sem prazo" value={summary.semPrazo} helper="Projetos sem previsão" tone="amber"/></div></div>;

    if (current === "capacidade") return <div className="grid min-h-0 flex-1 grid-cols-[1.3fr_.7fr] gap-3"><Panel title="Capacidade e pressão por responsável" subtitle="Cruza carteira, atraso e criticidade"><div className="divide-y divide-white/[.06]">{owners.slice(0,12).map((o,i)=><div key={o.name} className="grid grid-cols-[36px_1fr_90px_90px_120px] items-center gap-3 py-3"><span className="text-xs text-slate-600">{String(i+1).padStart(2,"0")}</span><span className="font-semibold text-slate-200">{o.name}</span><span className="text-center text-xs text-slate-400">{o.total} projetos</span><span className="text-center text-xs text-rose-300">{o.critical} críticos</span><span><span className="block h-2 overflow-hidden rounded-full bg-black/30"><span className="block h-full bg-amber-400" style={{width:`${Math.min(100,o.pressure)}%`}}/></span><small className="mt-1 block text-right text-slate-600">pressão {o.pressure}</small></span></div>)}</div></Panel><Panel title="Maior pressão" subtitle="Responsáveis que exigem redistribuição"><div className="grid h-full content-center gap-3">{owners.slice(0,4).map(o=><Kpi key={o.name} label={o.name} value={o.total} helper={`${o.critical} críticos · ${o.delayed} atrasados`} tone={o.critical?"rose":"sky"}/>)}</div></Panel></div>;

    return <div className="grid min-h-0 flex-1 grid-cols-[1.35fr_.65fr] gap-3"><Panel title="Resumo de Guerra" subtitle="Projetos + ocorrências reais"><ProjectRows items={ranked.filter(p=>p.score>0)} limit={12}/></Panel><div className="grid min-h-0 grid-rows-4 gap-3"><Kpi label="Ação imediata" value={summary.criticos} helper="Projetos críticos" tone="rose"/><Kpi label="Pendências vencidas" value={summary.pendenciasVencidas} helper="Pendências reais" tone="amber"/><Kpi label="Ações vencidas" value={summary.acoesVencidas} helper="Ações reais" tone="rose"/><Kpi label="Próximos marcos" value={summary.proximosMarcos} helper="Marcos reais"/></div></div>;
  };

  return (
    <div className="fixed inset-0 z-[99999] isolate h-[100dvh] w-screen overflow-hidden bg-[#040713] text-slate-100">
      <div className="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(14,165,233,.12),transparent_30%),radial-gradient(circle_at_100%_10%,rgba(139,92,246,.10),transparent_32%),linear-gradient(180deg,#071021_0%,#040713_100%)]" />
      <div className="relative flex h-full min-h-0 flex-col gap-3 p-[clamp(10px,1vw,18px)]">
        <header className="flex shrink-0 items-center gap-4 rounded-2xl border border-white/[0.08] bg-[#081126] px-[clamp(14px,1.2vw,22px)] py-3 shadow-2xl shadow-black/20">
          <div className="flex min-w-0 items-center gap-3">
            <span className="flex h-9 w-9 items-center justify-center rounded-xl border border-emerald-400/20 bg-emerald-400/[0.08] text-emerald-300"><Activity size={17}/></span>
            <div className="min-w-0"><div className="flex items-center gap-2"><span className="rounded-full border border-emerald-400/20 bg-emerald-400/[0.08] px-2 py-0.5 text-[9px] font-bold uppercase tracking-[.14em] text-emerald-300">Ao vivo</span><span className="text-[10px] uppercase tracking-[.14em] text-slate-500">WMS Expert · Control Tower Live</span></div><h1 className="mt-1 text-[clamp(17px,1.45vw,28px)] font-semibold tracking-[-.035em] text-white">{slides[slide].label === "Agora" ? "Visão Executiva" : slides[slide].label}</h1></div>
          </div>
          <div className="ml-auto flex items-center gap-2">
            <button onClick={()=>void loadExecutive()} disabled={refreshing} title="Atualizar dados executivos" className="hidden rounded-xl border border-white/[.07] bg-black/20 px-3 py-2 text-right transition hover:bg-white/[.04] disabled:opacity-60 md:block"><div className="flex items-center justify-end gap-1 text-[8px] uppercase tracking-[.14em] text-slate-600"><RefreshCw size={9} className={refreshing?"animate-spin":""}/>Última atualização</div><div className="text-[10px] font-medium text-slate-300">{lastUpdate.toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"})}</div></button>
            <div className="rounded-xl border border-white/[.07] bg-black/20 px-3 py-2 text-right"><div className="text-[clamp(14px,1.15vw,21px)] font-semibold text-white">{now.toLocaleTimeString("pt-BR")}</div><div className="text-[8px] uppercase tracking-[.12em] text-slate-500">{now.toLocaleDateString("pt-BR",{weekday:"short",day:"2-digit",month:"short"})}</div></div>
            <button onClick={goFullscreen} title="Fullscreen do navegador" className="flex h-10 w-10 items-center justify-center rounded-xl border border-sky-400/20 bg-sky-400/[.07] text-sky-300 hover:bg-sky-400/[.13]"><Maximize2 size={16}/></button>
            <button onClick={exit} title="Sair do Control Tower Live (ESC)" className="flex h-10 items-center gap-2 rounded-xl border border-rose-400/25 bg-rose-400/[.08] px-3 text-[11px] font-semibold text-rose-300 hover:bg-rose-400/[.14]"><X size={16}/><span className="hidden sm:inline">Sair</span></button>
          </div>
        </header>

        <nav className="relative flex shrink-0 items-center gap-1 rounded-2xl border border-white/[.08] bg-[#0a1330] p-2">
          <div className="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto">{slides.map((s,i)=>{const Icon=s.icon;return <button key={s.key} onClick={()=>setSlide(i)} className={`flex shrink-0 items-center gap-1.5 rounded-xl px-[clamp(9px,.8vw,14px)] py-2 text-[clamp(9px,.72vw,12px)] transition ${slide===i?"border border-sky-400/30 bg-sky-400/[.12] text-sky-300":"text-slate-500 hover:bg-white/[.04] hover:text-slate-300"}`}><Icon size={13}/>{s.label}</button>})}</div>
          <div className="ml-2 flex shrink-0 items-center gap-1"><button onClick={prev} className="rounded-lg border border-white/[.08] p-2 text-slate-400"><ChevronLeft size={14}/></button><button onClick={()=>setAuto(v=>!v)} className={`flex items-center gap-1.5 rounded-lg border px-3 py-2 text-[10px] font-semibold ${auto?"border-emerald-400/20 bg-emerald-400/[.08] text-emerald-300":"border-white/[.08] text-slate-400"}`}>{auto?<Pause size={12}/>:<Play size={12}/>} {auto?"Pausar":"Auto"}</button><span className="w-9 text-center text-[9px] text-slate-500">{slide+1}/{slides.length}</span><button onClick={next} className="rounded-lg border border-white/[.08] p-2 text-slate-400"><ChevronRight size={14}/></button></div>
          {auto && <div className="absolute bottom-0 left-0 h-[2px] animate-[liveProgress_15s_linear_infinite] bg-cyan-400" />}
        </nav>

        {liveError && <div className="shrink-0 rounded-xl border border-rose-400/25 bg-rose-400/[.08] px-4 py-2 text-xs text-rose-300">Falha na atualização automática: {liveError}. Exibindo o último estado disponível.</div>}
        <main className="flex min-h-0 flex-1 flex-col gap-3 overflow-hidden">{renderSlide()}</main>
      </div>
      <style jsx global>{`@keyframes liveProgress{from{width:0}to{width:100%}} body:has(.control-tower-live-lock){overflow:hidden}`}</style>
      <div className="control-tower-live-lock hidden" />
    </div>
  );
}



