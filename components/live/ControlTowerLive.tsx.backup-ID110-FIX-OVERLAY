        <Kpi label="Críticos" value={summary.criticos} helper="Ação imediata" tone="rose" />
        <Kpi label="Em atenção" value={summary.atencao} helper="Monitorar de perto" tone="amber" />
        <Kpi label="Atrasados" value={summary.atrasados} helper="Prazo ultrapassado" tone="rose" />
        <Kpi label="Bloqueados" value={summary.bloqueados} helper="Fluxo interrompido" tone={summary.bloqueados ? "rose" : "emerald"} />
