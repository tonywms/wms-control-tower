      const abertas =
        ex?.indicadores.pendenciasAbertas ?? 0;

      const vencidas =
        ex?.indicadores.pendenciasVencidas ?? 0;

      const hoje =
        ex?.indicadores.pendenciasHoje ?? 0;

      const h48 =
        ex?.indicadores.pendencias48h ?? 0;

