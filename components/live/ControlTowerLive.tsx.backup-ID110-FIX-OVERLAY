            <div>
              <div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Ocorrências</div>
              <div className={`mt-1 text-sm font-semibold ${ocorrencias ? "text-amber-300" : "text-slate-400"}`}>
                {ocorrencias}
              </div>
              <div className="text-[9px] text-slate-600">P {pendencias} · I {impedimentos} · A {acoes} · M {marcos}</div>
            </div>

            <div className="min-w-0">
              <div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Responsável</div>
              <div className="mt-1 truncate text-xs font-medium text-slate-300">{p.responsavel_nome || "Sem responsável"}</div>
            </div>

            <div className="min-w-0">
              <div className="text-[9px] uppercase tracking-[.12em] text-slate-600">Próxima ação</div>
              <div className={`mt-1 truncate text-xs font-medium ${ex?.proximaAcao?.vencida ? "text-rose-300" : "text-sky-300"}`}>
                {ex?.proximaAcao?.titulo || "Nenhuma ação aberta"}
              </div>
              {ex?.proximaAcao?.prazo && (
                <div className="mt-0.5 text-[9px] text-slate-600">
                  {ex.proximaAcao.vencida ? "Vencida" : "Prazo"} · {fmtDate(ex.proximaAcao.prazo)}
                </div>
              )}
            </div>
          </button>
        );
      })}
    </div>
  );
}

export default function ControlTowerLive({ projetos, onOpenProjeto, onExit }: Props) {
  const [slide, setSlide] = useState(0);
  const [auto, setAuto] = useState(true);
  const [rotationSeconds, setRotationSeconds] = useState(15);
  const [now, setNow] = useState(new Date());
  const [lastUpdate, setLastUpdate] = useState(new Date());
  const [executive, setExecutive] = useState<ExecutiveDashboard | null>(null);
  const [liveError, setLiveError] = useState<string | null>(null);
  const [refreshing, setRefreshing] = useState(false);
  const [connected, setConnected] = useState(true);
  const [isFullscreen, setIsFullscreen] = useState(false);

  const loadExecutive = useCallback(async () => {
    try {
      setRefreshing(true);
      const response = await fetch("/api/dashboard/executivo", { cache: "no-store", credentials: "same-origin" });
      const body = await response.json();
      if (!response.ok || !body?.success) throw new Error(body?.error || `Falha HTTP ${response.status}`);
      setExecutive(body as ExecutiveDashboard);
      setLiveError(null);
      setConnected(true);
      setLastUpdate(new Date(body.atualizadoEm || Date.now()));
    } catch (error) {
      setLiveError(error instanceof Error ? error.message : "Falha ao atualizar dados executivos.");
      setConnected(false);
    } finally {
      setRefreshing(false);
    }
  }, []);

  const exit = useCallback(() => {
    if (document.fullscreenElement) document.exitFullscreen().catch(() => undefined);
    onExit();
  }, [onExit]);

  useEffect(() => {
    const key = (e: KeyboardEvent) => { if (e.key === "Escape") exit(); };
    window.addEventListener("keydown", key);
    return () => window.removeEventListener("keydown", key);
  }, [exit]);

  useEffect(() => {
    const saved = Number(
      window.localStorage.getItem("controlTowerLiveRotationSeconds")
    );

    if ([10, 15, 30, 60].includes(saved)) {
      setRotationSeconds(saved);
    }
  }, []);

  useEffect(() => {
    const syncFullscreen = () => {
      setIsFullscreen(Boolean(document.fullscreenElement));
    };

    const online = () => {
      setConnected(true);
      void loadExecutive();
    };

    const offline = () => {
      setConnected(false);
    };

    setConnected(navigator.onLine);
    syncFullscreen();

    document.addEventListener("fullscreenchange", syncFullscreen);
    window.addEventListener("online", online);
    window.addEventListener("offline", offline);

    return () => {
      document.removeEventListener("fullscreenchange", syncFullscreen);
      window.removeEventListener("online", online);
      window.removeEventListener("offline", offline);
    };
  }, [loadExecutive]);

  useEffect(() => {
    const t = window.setInterval(() => setNow(new Date()), 1000);
    return () => window.clearInterval(t);
  }, []);

  useEffect(() => {
    void loadExecutive();
    const t = window.setInterval(() => void loadExecutive(), 60000);
    return () => window.clearInterval(t);
  }, [loadExecutive]);

  useEffect(() => {
    if (!auto) return;

    const t = window.setInterval(
      () => {
        setSlide(
          (s) => (s + 1) % slides.length
        );
      },
      rotationSeconds * 1000
    );

    return () => window.clearInterval(t);
  }, [auto, rotationSeconds]);

  const localById = useMemo(() => new Map(projetos.map((p) => [p.id, p])), [projetos]);

  const ranked = useMemo<Ranked[]>(() => {
    if (!executive) return projetos.filter((p) => !isClosed(p)).map(rankProject).sort((a,b)=>b.score-a.score);
    return executive.projetos.map((item) => {
      const local = localById.get(item.id);
      if (!local) return null;
      const health: Health = item.saude === "Crítico" ? "critical" : item.saude === "Atenção" ? "attention" : "stable";
      return {
        ...local,
        status: item.status ?? local.status,
        prioridade: item.prioridade ?? local.prioridade,
        percentual: Number(item.percentual ?? local.percentual ?? 0),
        data_fim: item.data_fim ?? local.data_fim,
        responsavel_nome: item.responsavel?.nome ?? local.responsavel_nome,
        score: item.score, lateDays: item.lateDays ?? item.indicadores.diasAtraso,
        reasons: item.motivos ?? [], health,
      } as Ranked;
    }).filter((x): x is Ranked => x !== null).sort((a,b)=>b.score-a.score);
  }, [executive, localById, projetos]);

  const executiveById = useMemo(() => new Map((executive?.projetos ?? []).map(p=>[p.id,p])), [executive]);
  const critical = ranked.filter((p) => p.health === "critical");
  const attention = ranked.filter((p) => p.health === "attention");
  const stable = ranked.filter((p) => p.health === "stable");
  const delayed = ranked.filter((p) => p.lateDays > 0);
  const blocked = ranked.filter((p) => normalize(p.status) === "bloqueado");
  const noDeadline = ranked.filter((p) => !p.data_fim);
  const avg = ranked.length ? Math.round(ranked.reduce((a,p)=>a+(p.percentual||0),0)/ranked.length) : 0;
  const healthPct = ranked.length ? Math.round((stable.length/ranked.length)*100) : 100;
  const summary = executive?.resumo ?? {
    total: projetos.length, ativos: ranked.length, estaveis: stable.length, atencao: attention.length,
    criticos: critical.length, atrasados: delayed.length, bloqueados: blocked.length, semPrazo: noDeadline.length,
    pendenciasAbertas: 0,
    pendenciasVencidas: 0,
    pendenciasHoje: 0,
    pendencias48h: 0,
    pendencias72h: 0,
    pendenciasSemPrazo: 0,
    maiorAgingPendenciaDias: 0,
    impedimentos: 0,
    impedimentosCriticos: 0,
    marcosAtrasados: 0,
    acoesAbertas: 0,
    acoesVencidas: 0,
