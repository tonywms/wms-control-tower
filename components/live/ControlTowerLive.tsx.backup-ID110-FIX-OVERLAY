const normalize = (value?: string | null) =>
  (value ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

function localDate(value: string | null) {
  if (!value) return null;
  const [y, m, d] = value.slice(0, 10).split("-").map(Number);
  if (!y || !m || !d) return null;
  return new Date(y, m - 1, d);
}

function diffDays(value: string | null) {
  const date = localDate(value);
  if (!date) return null;
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  date.setHours(0, 0, 0, 0);
  return Math.round((date.getTime() - today.getTime()) / 86400000);
}

function fmtDate(value: string | null) {
  const d = localDate(value);
  return d ? d.toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit" }) : "Sem prazo";
}

function isClosed(p: Projeto) {
  const s = normalize(p.status);
  return s === "finalizado" || s === "cancelado";
}

function rankProject(p: Projeto): Ranked {
  const late =
    diffDays(p.data_fim);

  const lateDays =
    late !== null &&
    late < 0 &&
    !isClosed(p)
      ? Math.abs(late)
      : 0;

  const result =
    calculateOperationalHealth({
      status:
        p.status,

      prioridade:
        p.prioridade,

      lateDays,

      hasOwner:
        Boolean(
          p.responsavel_nome?.trim()
        ),

      hasDeadline:
        Boolean(
          p.data_fim
        ),

      pendenciasVencidas: 0,
      impedimentosAbertos: 0,
      impedimentosCriticos: 0,
      marcosAtrasados: 0,
      acoesVencidas: 0,
    });

  const health: Health =
    result.saude === "Crítico"
      ? "critical"
      : result.saude === "Atenção"
        ? "attention"
        : "stable";

  return {
    ...p,

    health,

    score:
      result.score,

    lateDays,

    reasons:
      result.motivos,
  };
}
