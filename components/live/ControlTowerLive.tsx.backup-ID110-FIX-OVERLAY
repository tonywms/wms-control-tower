        map.get(nome) ?? [];

      lista.push(p);
      map.set(nome, lista);
    });

    return [...map.entries()]
      .map(([name, items]) => {
        let pendencias = 0;
        let impedimentos = 0;
        let riscos = 0;
        let acoes = 0;
        let marcos = 0;

        items.forEach((p) => {
          const ex =
            executiveById.get(p.id);

          pendencias +=
            ex?.indicadores.pendenciasVencidas ?? 0;

          impedimentos +=
            ex?.indicadores.impedimentosAbertos ?? 0;

          riscos +=
            ex?.indicadores.impedimentosCriticos ?? 0;

          acoes +=
            ex?.indicadores.acoesVencidas ?? 0;

          marcos +=
            ex?.indicadores.marcosAtrasados ?? 0;
        });

        const critical =
          items.filter(
            (p) =>
              p.health === "critical"
          ).length;

        const attention =
          items.filter(
            (p) =>
              p.health === "attention"
          ).length;

        const delayed =
          items.filter(
            (p) =>
              p.lateDays > 0
          ).length;

        const occurrences =
          pendencias +
          impedimentos +
          acoes +
          marcos;

        /*
         * PRESSÃO OPERACIONAL
         *
         * Projeto em carteira       = 10
         * Projeto crítico           = +45
         * Projeto em atenção        = +20
         * Dias de atraso            = até +30
         * Pendência vencida         = +18
         * Impedimento aberto        = +22
         * Risco/impedimento crítico = +28
         * Ação vencida              = +15
         * Marco atrasado            = +12
         */
        const pressure =
          items.reduce(
            (total, p) => {
              const ex =
                executiveById.get(p.id);

              const pend =
                ex?.indicadores
                  .pendenciasVencidas ?? 0;

              const imped =
                ex?.indicadores
                  .impedimentosAbertos ?? 0;

              const riscosCriticos =
                ex?.indicadores
                  .impedimentosCriticos ?? 0;

              const actions =
                ex?.indicadores
                  .acoesVencidas ?? 0;

              const milestones =
                ex?.indicadores
                  .marcosAtrasados ?? 0;

              return (
                total +
                10 +
                (p.health === "critical"
                  ? 45
                  : p.health === "attention"
                    ? 20
                    : 0) +
                Math.min(
                  30,
                  p.lateDays
                ) +
                pend * 18 +
                imped * 22 +
                riscosCriticos * 28 +
                actions * 15 +
                milestones * 12
              );
            },
            0
          );

        return {
          name,
          total: items.length,
          critical,
          attention,
          delayed,
          pendencias,
          impedimentos,
          riscos,
          acoes,
          marcos,
          occurrences,
          pressure,
        };
      })
      .sort(
        (a, b) =>
          b.pressure -
          a.pressure
      );
  }, [ranked, executiveById]);
  const operationalProblems = useMemo(() => ranked.filter(p => {
    const x=executiveById.get(p.id);
    return !!x && (x.indicadores.pendenciasVencidas>0 || x.indicadores.impedimentosAbertos>0 || x.indicadores.marcosAtrasados>0 || x.indicadores.acoesVencidas>0);
  }),[executiveById,ranked]);

  const milestones = useMemo(() => executive?.proximosMarcos ?? [], [executive]);

  const goFullscreen = async () => {
    if (!document.fullscreenElement) {
      await document.documentElement
        .requestFullscreen()
        .catch(() => undefined);
    } else {
      await document
        .exitFullscreen()
        .catch(() => undefined);
    }
  };

  const goTvMode = async () => {
    setAuto(true);

    if (!document.fullscreenElement) {
      await document.documentElement
        .requestFullscreen()
        .catch(() => undefined);
    }

    void loadExecutive();
  };

  const openProjeto360 = useCallback(
