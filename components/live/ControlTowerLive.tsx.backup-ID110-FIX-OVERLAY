          </div>
        </Panel>
        <Panel title="Atenção imediata" subtitle="Projetos com maior criticidade neste momento"><ProjectRows items={ranked} limit={7}/></Panel>
      </div>
    </>;

    if (current === "problemas") return <div className="grid min-h-0 flex-1 grid-cols-1 gap-3 xl:grid-cols-[minmax(0,1.58fr)_minmax(250px,.42fr)]"><Panel title="Mapa de Problemas" subtitle="Ranking executivo: criticidade, motivo, atraso, ocorrências, responsável e próxima ação"><ProblemRanking items={ranked} executiveById={executiveById} onOpenProjeto={openProjeto360}/></Panel><div className="grid min-h-0 grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-1 xl:grid-rows-5"><Kpi label="Críticos" value={summary.criticos} helper="Decisão imediata" tone="rose"/><Kpi label="Atrasados" value={summary.atrasados} helper="Projetos fora do prazo" tone="rose"/><Kpi label="Pendências vencidas" value={summary.pendenciasVencidas} helper="Pendências reais" tone="amber"/><Kpi label="Ações vencidas" value={summary.acoesVencidas} helper="Ações reais" tone="amber"/><Kpi label="Marcos atrasados" value={summary.marcosAtrasados} helper="Marcos reais" tone="rose"/></div></div>;

