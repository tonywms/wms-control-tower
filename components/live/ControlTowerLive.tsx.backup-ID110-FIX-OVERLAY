      )[0];

    const proximosGoLivesGuerra =
      (executive?.proximosMarcos ?? [])
        .filter((marco) => {
          const nome =
            normalize(marco.nome);

          const proximosGoLivesGuerra =
      (executive?.proximosMarcos ?? [])
        .filter((marco) => {
