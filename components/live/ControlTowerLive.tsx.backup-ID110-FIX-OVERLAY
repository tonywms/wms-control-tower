      const aging =
        ex?.indicadores.maiorAgingPendenciaDias ?? 0;

      const impedimentos =
        ex?.indicadores.impedimentosAbertos ?? 0;

      const acoes =
        ex?.indicadores.acoesVencidas ?? 0;

      const marcos =
        ex?.indicadores.marcosAtrasados ?? 0;

      const totalOperacional =
        vencidas +
        impedimentos +
        acoes +
        marcos;

      return {
        p,
        ex,
        abertas,
        vencidas,
        hoje,
