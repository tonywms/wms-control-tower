          const db =
            b.data_prevista
              ? new Date(b.data_prevista).getTime()
              : Number.MAX_SAFE_INTEGER;

          return da - db;
        });

    const proximoGoLiveGuerra =
      proximosGoLivesGuerra[0] ?? null;
    return (
            nome.includes("go-live") ||
            nome.includes("go live") ||
            nome.includes("golive")
          );
        })
