      </div>

      <div
        className={[
          "mt-1 flex min-w-0 items-center gap-1 text-[10px] font-medium",
          danger
            ? "text-red-300"
            : "text-slate-400",
        ].join(" ")}
      >
        {icon}

        <span className="truncate">
          {value}
        </span>
      </div>
    </div>
  );
}
