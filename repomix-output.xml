-- ============================================================
-- ALTERAÇÃO DE STATUS DO PROJETO
-- ============================================================

CREATE OR REPLACE FUNCTION public.alterar_status_projeto(
    p_projeto_id uuid,
    p_novo_status text,
    p_motivo text DEFAULT NULL::text,
    p_usuario_id uuid DEFAULT NULL::uuid,
    p_usuario_nome text DEFAULT 'Sistema'::text
)
RETURNS public.projetos
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public'
AS $function$
DECLARE
    v_projeto public.projetos;
    v_status_anterior text;
    v_agora timestamptz := now();
    v_usuario_id uuid;
BEGIN
    SELECT *
    INTO v_projeto
    FROM public.projetos
    WHERE id = p_projeto_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Projeto não encontrado.';
    END IF;

    IF p_novo_status NOT IN (
        'Não iniciado',
        'Planejado',
        'Em andamento',
        'Pausado',
        'Bloqueado',
        'Finalizado',
        'Cancelado'
    ) THEN
        RAISE EXCEPTION 'Status inválido: %', p_novo_status;
    END IF;

    v_usuario_id := p_usuario_id;

    IF v_usuario_id IS NOT NULL THEN
        IF NOT EXISTS (
            SELECT 1
            FROM public.usuarios
            WHERE id = v_usuario_id
              AND ativo = true
        ) THEN
            RAISE EXCEPTION
                'Usuário interno não encontrado ou inativo: %',
                v_usuario_id;
        END IF;
    END IF;

    v_status_anterior := v_projeto.status;

    IF v_status_anterior = p_novo_status THEN
        RETURN v_projeto;
    END IF;

    UPDATE public.projetos
    SET
        status = p_novo_status,
        updated_at = v_agora,

        started_at =
            CASE
                WHEN p_novo_status = 'Em andamento'
                     AND started_at IS NULL
                THEN v_agora
                ELSE started_at
            END,

        started_by =
            CASE
                WHEN p_novo_status = 'Em andamento'
                     AND started_at IS NULL
                THEN v_usuario_id
                ELSE started_by
            END,

        paused_at =
            CASE
                WHEN p_novo_status = 'Pausado'
                THEN v_agora
                ELSE paused_at
            END,

        pausa_motivo =
            CASE
                WHEN p_novo_status = 'Pausado'
                THEN NULLIF(TRIM(p_motivo), '')
                ELSE pausa_motivo
            END,

        finished_at =
            CASE
                WHEN p_novo_status = 'Finalizado'
                THEN v_agora
                WHEN p_novo_status <> 'Finalizado'
                THEN NULL
                ELSE finished_at
            END,

        finished_by =
            CASE
                WHEN p_novo_status = 'Finalizado'
                THEN v_usuario_id
                WHEN p_novo_status <> 'Finalizado'
                THEN NULL
                ELSE finished_by
            END,

        percentual =
            CASE
                WHEN p_novo_status = 'Finalizado'
                THEN 100
                ELSE percentual
            END

    WHERE id = p_projeto_id
    RETURNING *
    INTO v_projeto;

    INSERT INTO public.historico_status (
        projeto_id,
        status_anterior,
        status_novo,
        motivo,
        usuario_id,
        usuario_nome,
        created_at
    )
    VALUES (
        p_projeto_id,
        v_status_anterior,
        p_novo_status,
        NULLIF(TRIM(p_motivo), ''),
        v_usuario_id,
        p_usuario_nome,
        v_agora
    );

    RETURN v_projeto;
END;
$function$;

