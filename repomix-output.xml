"use client";

import {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from "react";
import {
  Activity,
  AlertTriangle,
  ArrowLeft,
  ArrowRight,
  CalendarDays,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  CircleAlert,
  Clock3,
  Expand,
  Gauge,
  Layers3,
  MonitorPlay,
  Pause,
  Play,
  Radio,
  RefreshCw,
  ShieldAlert,
  ShieldCheck,
  Target,
  TrendingUp,
  UserRound,
  UsersRound,
  X,
  Zap,
} from "lucide-react";

type Projeto = {
  id: string;
  cliente_id: string;
  nome: string;
  plataforma: string | null;
  etapa_id: string | null;
  setor: string | null;
  responsavel_id: string | null;
  responsavel_nome: string | null;
  status: string;
  prioridade: string;
  data_inicio: string | null;
  data_fim: string | null;
  observacoes: string | null;
  fase_origem: string | null;
  percentual: number;
  created_at: string;
  updated_at: string;

  cliente: {
    id: string;
    nome: string;
    cidade: string | null;
  } | null;

  etapa: {
    id: string;
    nome: string;
    ordem: number;
  } | null;
};

type ControlTowerLiveProps = {
  projetos: Projeto[];
  onOpenProjeto: (id: string) => void;
};

type Tone =
  | "sky"
  | "emerald"
  | "amber"
  | "red"
  | "violet"
  | "slate";

type Saude = "CRÍTICO" | "ATENÇÃO" | "ESTÁVEL";

type SlideId =
  | "executivo"
  | "problemas"
  | "riscos"
  | "pendencias"
  | "areas"
  | "marcos"
  | "capacidade"
  | "guerra";

type Slide = {
  id: SlideId;
  label: string;
  shortLabel: string;
  icon: typeof Activity;
};

const SLIDE_INTERVAL = 15000;

const slides: Slide[] = [
  {
    id: "executivo",
    label: "Visão Executiva",
    shortLabel: "Agora",
    icon: Activity,
  },
  {
    id: "problemas",
    label: "Mapa de Problemas",
    shortLabel: "Problemas",
    icon: AlertTriangle,
  },
  {
    id: "riscos",
    label: "Riscos e Bloqueios",
    shortLabel: "Riscos",
    icon: ShieldAlert,
  },
  {
    id: "pendencias",
    label: "Pendências e Aging",
    shortLabel: "Pendências",
    icon: Clock3,
  },
  {
    id: "areas",
    label: "Radar das Áreas",
    shortLabel: "Áreas",
    icon: Layers3,
  },
  {
    id: "marcos",
    label: "Próximos Marcos",
    shortLabel: "Marcos",
    icon: CalendarDays,
  },
  {
    id: "capacidade",
    label: "Capacidade da Equipe",
    shortLabel: "Capacidade",
    icon: UsersRound,
  },
  {
    id: "guerra",
    label: "Resumo de Guerra",
    shortLabel: "Guerra",
    icon: Zap,
  },
];

const toneClasses: Record<Tone, string> = {
  sky:
    "border-sky-400/10 bg-sky-400/[0.06] text-sky-300",
  emerald:
    "border-emerald-400/10 bg-emerald-400/[0.06] text-emerald-300",
  amber:
    "border-amber-400/10 bg-amber-400/[0.06] text-amber-300",
  red:
    "border-red-400/10 bg-red-400/[0.06] text-red-300",
  violet:
    "border-violet-400/10 bg-violet-400/[0.06] text-violet-300",
  slate:
    "border-white/[0.07] bg-white/[0.035] text-slate-400",
};

const normalize = (value?: string | null) =>
  (value ?? "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .trim()
    .toLowerCase();

const parseLocalDate = (value?: string | null) => {
  if (!value) return null;

  const [year, month, day] = value
    .slice(0, 10)
    .split("-")
    .map(Number);

  if (!year || !month || !day) return null;

  return new Date(year, month - 1, day);
};

const formatDate = (value?: string | null) => {
  if (!value) return "Sem prazo";

  const [year, month, day] = value.slice(0, 10).split("-");

  if (!year || !month || !day) return "Sem prazo";

  return `${day}/${month}/${year}`;
};

const getToday = () => {
  const now = new Date();

  return new Date(
    now.getFullYear(),
    now.getMonth(),
    now.getDate(),
  );
};

const diffDays = (from: Date, to: Date) => {
  const day = 1000 * 60 * 60 * 24;

  return Math.ceil(
    (to.getTime() - from.getTime()) / day,
  );
};

const isFinalizado = (status?: string | null) => {
  const value = normalize(status);

  return (
    value === "finalizado" ||
    value === "concluido" ||
    value === "concluida" ||
    value === "encerrado" ||
    value === "encerrada" ||
    value === "cancelado" ||
    value === "cancelada"
  );
};

const isBloqueado = (status?: string | null) =>
  normalize(status).includes("bloque");

const isPausado = (status?: string | null) =>
  normalize(status).includes("paus");

const isPrioridadeCritica = (
  prioridade?: string | null,
) => {
  const value = normalize(prioridade);

  return value.includes("crit");
};

const isPrioridadeAlta = (
  prioridade?: string | null,
) => {
  const value = normalize(prioridade);

  return value.includes("alta");
};

const getArea = (projeto: Projeto) => {
  const setor = normalize(projeto.setor);
  const origem = normalize(projeto.fase_origem);
  const etapa = normalize(projeto.etapa?.nome);

  if (
    setor.includes("comercial") ||
    origem.includes("comercial") ||
    etapa.includes("comercial")
  ) {
    return "Comercial";
  }

  if (
    setor.includes("desenvolvimento") ||
    origem.includes("desenvolvimento")
  ) {
    return "Desenvolvimento";
  }

  if (
    setor.includes("suporte") ||
    origem.includes("suporte")
  ) {
    return "Suporte";
  }

  if (
    setor.includes("implantacao") ||
    origem.includes("implantacao") ||
    etapa.includes("planejamento") ||
    etapa.includes("configuracao") ||
    etapa.includes("homologacao") ||
    etapa.includes("treinamento") ||
    etapa.includes("go-live") ||
    etapa.includes("go live")
  ) {
    return "Implantação";
  }

  return projeto.setor || projeto.fase_origem || "Outros";
};

const getProblemInfo = (projeto: Projeto) => {
  const hoje = getToday();
  const prazo = parseLocalDate(projeto.data_fim);

  const atrasado =
    Boolean(prazo) &&
    !isFinalizado(projeto.status) &&
    prazo! < hoje;

  const diasAtraso =
    atrasado && prazo
      ? Math.max(1, diffDays(prazo, hoje))
      : 0;

  const bloqueado = isBloqueado(projeto.status);
  const pausado = isPausado(projeto.status);
  const critica = isPrioridadeCritica(projeto.prioridade);
  const alta = isPrioridadeAlta(projeto.prioridade);
  const semPrazo =
    !projeto.data_fim && !isFinalizado(projeto.status);

  let score = 0;
  const motivos: string[] = [];

  if (bloqueado) {
    score += 50;
    motivos.push("Projeto bloqueado");
  }

  if (atrasado) {
    score += 35 + Math.min(diasAtraso, 20);
    motivos.push(
      `${diasAtraso} dia${diasAtraso === 1 ? "" : "s"} de atraso`,
    );
  }

  if (critica) {
    score += 30;
    motivos.push("Prioridade crítica");
  } else if (alta) {
    score += 18;
    motivos.push("Prioridade alta");
  }

  if (pausado) {
    score += 15;
    motivos.push("Projeto pausado");
  }

  if (semPrazo) {
    score += 10;
    motivos.push("Sem previsão definida");
  }

  let saude: Saude = "ESTÁVEL";

  if (score >= 50) {
    saude = "CRÍTICO";
  } else if (score >= 18) {
    saude = "ATENÇÃO";
  }

  return {
    score,
    saude,
    motivos,
    atrasado,
    diasAtraso,
    bloqueado,
    pausado,
    semPrazo,
  };
};

const getSaudeTone = (saude: Saude): Tone => {
  if (saude === "CRÍTICO") return "red";
  if (saude === "ATENÇÃO") return "amber";

  return "emerald";
};

export default function ControlTowerLive({
  projetos,
  onOpenProjeto,
}: ControlTowerLiveProps) {
  const [slideIndex, setSlideIndex] = useState(0);
  const [autoPlay, setAutoPlay] = useState(false);
  const [tvMode, setTvMode] = useState(false);
  const [agora, setAgora] = useState(new Date());
  const [lastUpdate, setLastUpdate] = useState(new Date());

  const currentSlide = slides[slideIndex];

  useEffect(() => {
    const timer = window.setInterval(() => {
      setAgora(new Date());
    }, 1000);

    return () => window.clearInterval(timer);
  }, []);

  useEffect(() => {
    setLastUpdate(new Date());
  }, [projetos]);

  const nextSlide = useCallback(() => {
    setSlideIndex((current) =>
      current >= slides.length - 1 ? 0 : current + 1,
    );
  }, []);

  const previousSlide = useCallback(() => {
    setSlideIndex((current) =>
      current <= 0 ? slides.length - 1 : current - 1,
    );
  }, []);

  useEffect(() => {
    if (!autoPlay) return;

    const timer = window.setInterval(
      nextSlide,
      SLIDE_INTERVAL,
    );

    return () => window.clearInterval(timer);
  }, [autoPlay, nextSlide]);

  const enterTvMode = async () => {
    setTvMode(true);
    setAutoPlay(true);

    try {
      if (!document.fullscreenElement) {
        await document.documentElement.requestFullscreen();
      }
    } catch {
      // O navegador pode bloquear fullscreen.
      // O layout de TV continua funcionando mesmo assim.
    }
  };

  const exitTvMode = async () => {
    setTvMode(false);
    setAutoPlay(false);

    try {
      if (document.fullscreenElement) {
        await document.exitFullscreen();
      }
    } catch {
      // Mantém a interface funcional caso o navegador negue.
    }
  };

  useEffect(() => {
    const handleFullscreen = () => {
      if (!document.fullscreenElement) {
        setTvMode(false);
      }
    };

    document.addEventListener(
      "fullscreenchange",
      handleFullscreen,
    );

    return () =>
      document.removeEventListener(
        "fullscreenchange",
        handleFullscreen,
      );
  }, []);

  const dados = useMemo(() => {
    const ativos = projetos.filter(
      (projeto) => !isFinalizado(projeto.status),
    );

    const analisados = ativos
      .map((projeto) => ({
        projeto,
        ...getProblemInfo(projeto),
      }))
      .sort((a, b) => b.score - a.score);

    const criticos = analisados.filter(
      (item) => item.saude === "CRÍTICO",
    );

    const atencao = analisados.filter(
      (item) => item.saude === "ATENÇÃO",
    );

    const estaveis = analisados.filter(
      (item) => item.saude === "ESTÁVEL",
    );

    const bloqueados = analisados.filter(
      (item) => item.bloqueado,
    );

    const atrasados = analisados.filter(
      (item) => item.atrasado,
    );

    const semPrazo = analisados.filter(
      (item) => item.semPrazo,
    );

    const prioridadeCritica = ativos.filter(
      (projeto) =>
        isPrioridadeCritica(projeto.prioridade) ||
        isPrioridadeAlta(projeto.prioridade),
    );

    const progressoMedio =
      ativos.length > 0
        ? Math.round(
            ativos.reduce(
              (total, projeto) =>
                total +
                Math.min(
                  100,
                  Math.max(
                    0,
                    Number(projeto.percentual || 0),
                  ),
                ),
              0,
            ) / ativos.length,
          )
        : 0;

    const areasMap = new Map<
      string,
      {
        nome: string;
        total: number;
        criticos: number;
        atencao: number;
        atrasados: number;
        bloqueados: number;
      }
    >();

    analisados.forEach((item) => {
      const nome = getArea(item.projeto);

      const atual = areasMap.get(nome) ?? {
        nome,
        total: 0,
        criticos: 0,
        atencao: 0,
        atrasados: 0,
        bloqueados: 0,
      };

      atual.total += 1;

      if (item.saude === "CRÍTICO") atual.criticos += 1;
      if (item.saude === "ATENÇÃO") atual.atencao += 1;
      if (item.atrasado) atual.atrasados += 1;
      if (item.bloqueado) atual.bloqueados += 1;

      areasMap.set(nome, atual);
    });

    const areas = Array.from(areasMap.values()).sort(
      (a, b) => {
        const pesoA =
          a.criticos * 10 +
          a.bloqueados * 8 +
          a.atrasados * 5 +
          a.atencao * 2;

        const pesoB =
          b.criticos * 10 +
          b.bloqueados * 8 +
          b.atrasados * 5 +
          b.atencao * 2;

        return pesoB - pesoA;
      },
    );

    const responsaveisMap = new Map<
      string,
      {
        nome: string;
        projetos: number;
        criticos: number;
        atencao: number;
        atrasados: number;
        score: number;
      }
    >();

    analisados.forEach((item) => {
      const nome =
        item.projeto.responsavel_nome?.trim() ||
        "Sem responsável";

      const atual = responsaveisMap.get(nome) ?? {
        nome,
        projetos: 0,
        criticos: 0,
        atencao: 0,
        atrasados: 0,
        score: 0,
      };

      atual.projetos += 1;
      atual.score += item.score;

      if (item.saude === "CRÍTICO") atual.criticos += 1;
      if (item.saude === "ATENÇÃO") atual.atencao += 1;
      if (item.atrasado) atual.atrasados += 1;

      responsaveisMap.set(nome, atual);
    });

    const responsaveis = Array.from(
      responsaveisMap.values(),
    ).sort(
      (a, b) =>
        b.score - a.score ||
        b.projetos - a.projetos,
    );

    const hoje = getToday();

    const proximosMarcos = ativos
      .filter((projeto) => {
        const prazo = parseLocalDate(projeto.data_fim);

        if (!prazo) return false;

        const dias = diffDays(hoje, prazo);

        return dias >= 0 && dias <= 15;
      })
      .sort((a, b) => {
        const aDate =
          parseLocalDate(a.data_fim)?.getTime() ?? Infinity;

        const bDate =
          parseLocalDate(b.data_fim)?.getTime() ?? Infinity;

        return aDate - bDate;
      });

    return {
      ativos,
      analisados,
      criticos,
      atencao,
      estaveis,
      bloqueados,
      atrasados,
      semPrazo,
      prioridadeCritica,
      progressoMedio,
      areas,
      responsaveis,
      proximosMarcos,
    };
  }, [projetos]);

  const hora = agora.toLocaleTimeString("pt-BR", {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
  });

  const data = agora.toLocaleDateString("pt-BR", {
    weekday: "short",
    day: "2-digit",
    month: "short",
  });

  const updatedTime = lastUpdate.toLocaleTimeString(
    "pt-BR",
    {
      hour: "2-digit",
      minute: "2-digit",
    },
  );

  return (
    <div
      className={[
        "space-y-4",
        tvMode
          ? "fixed inset-0 z-[9999] overflow-y-auto bg-[#060b12] p-5"
          : "mt-5",
      ].join(" ")}
    >
      {/* =====================================================
          CONTROL TOWER LIVE — HEADER
         ===================================================== */}

      <section className="relative overflow-hidden rounded-2xl border border-white/[0.07] bg-gradient-to-br from-white/[0.05] via-white/[0.025] to-transparent p-5">
        <div className="absolute right-[-80px] top-[-100px] h-[300px] w-[300px] rounded-full bg-sky-400/[0.05] blur-[100px]" />
        <div className="absolute bottom-[-100px] left-[30%] h-[240px] w-[240px] rounded-full bg-violet-400/[0.025] blur-[100px]" />

        <div className="relative flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">
          <div>
            <div className="flex flex-wrap items-center gap-2">
              <span className="flex items-center gap-1.5 rounded-full border border-emerald-400/15 bg-emerald-400/[0.07] px-2.5 py-1 text-[9px] font-semibold uppercase tracking-[0.14em] text-emerald-300">
                <span className="relative flex h-2 w-2">
                  <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-40" />
                  <span className="relative inline-flex h-2 w-2 rounded-full bg-emerald-400" />
                </span>
                Ao vivo
              </span>

              <span className="text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-500">
                WMS Expert · Control Tower Live
              </span>
            </div>

            <h2 className="mt-2 text-xl font-semibold tracking-[-0.035em] text-white">
              {currentSlide.label}
            </h2>

            <p className="mt-1 max-w-3xl text-[11px] leading-5 text-slate-500">
              Monitoramento contínuo da operação, criticidade,
              prazos, responsáveis e projetos que exigem atenção.
            </p>
          </div>

          <div className="flex flex-wrap items-center gap-2">
            <div className="rounded-xl border border-white/[0.06] bg-black/20 px-3 py-2">
              <div className="flex items-center gap-2">
                <Radio
                  size={12}
                  className="text-emerald-300"
                />

                <div>
                  <div className="text-[8px] font-semibold uppercase tracking-[0.12em] text-slate-600">
                    Última atualização
                  </div>

                  <div className="mt-0.5 text-[10px] font-medium text-slate-300">
                    {updatedTime}
                  </div>
                </div>
              </div>
            </div>

            <div className="rounded-xl border border-white/[0.06] bg-black/20 px-3 py-2">
              <div className="text-right">
                <div className="text-sm font-semibold tabular-nums text-white">
                  {hora}
                </div>

                <div className="text-[8px] uppercase tracking-[0.1em] text-slate-600">
                  {data}
                </div>
              </div>
            </div>

            {!tvMode ? (
              <button
                type="button"
                onClick={enterTvMode}
                className="flex h-10 items-center gap-2 rounded-xl border border-sky-400/15 bg-sky-400/[0.07] px-4 text-[10px] font-semibold text-sky-300 transition hover:bg-sky-400/[0.12]"
              >
                <MonitorPlay size={14} />
                Modo TV
              </button>
            ) : (
              <button
                type="button"
                onClick={exitTvMode}
                className="flex h-10 items-center gap-2 rounded-xl border border-red-400/15 bg-red-400/[0.07] px-4 text-[10px] font-semibold text-red-300 transition hover:bg-red-400/[0.12]"
              >
                <X size={14} />
                Sair da TV
              </button>
            )}
          </div>
        </div>
      </section>

      {/* =====================================================
          CONTROLE DOS SLIDES
         ===================================================== */}

      <section className="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-3">
        <div className="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
          <div className="flex min-w-0 flex-1 gap-1 overflow-x-auto">
            {slides.map((slide, index) => {
              const Icon = slide.icon;
              const active = index === slideIndex;

              return (
                <button
                  key={slide.id}
                  type="button"
                  onClick={() => {
                    setSlideIndex(index);
                    setAutoPlay(false);
                  }}
                  className={[
                    "flex shrink-0 items-center gap-1.5 rounded-xl border px-3 py-2 text-[9px] font-medium transition",
                    active
                      ? "border-sky-400/15 bg-sky-400/[0.08] text-sky-300"
                      : "border-transparent text-slate-600 hover:border-white/[0.06] hover:bg-white/[0.025] hover:text-slate-400",
                  ].join(" ")}
                >
                  <Icon size={12} />
                  {slide.shortLabel}
                </button>
              );
            })}
          </div>

          <div className="flex shrink-0 items-center gap-2">
            <button
              type="button"
              onClick={previousSlide}
              className="flex h-8 w-8 items-center justify-center rounded-lg border border-white/[0.06] bg-white/[0.025] text-slate-500 transition hover:text-white"
              title="Tela anterior"
            >
              <ChevronLeft size={14} />
            </button>

            <button
              type="button"
              onClick={() => setAutoPlay((value) => !value)}
              className={[
                "flex h-8 items-center gap-1.5 rounded-lg border px-3 text-[9px] font-semibold transition",
                autoPlay
                  ? "border-emerald-400/15 bg-emerald-400/[0.07] text-emerald-300"
                  : "border-white/[0.06] bg-white/[0.025] text-slate-500",
              ].join(" ")}
            >
              {autoPlay ? (
                <Pause size={11} />
              ) : (
                <Play size={11} />
              )}

              {autoPlay ? "Pausar" : "Auto"}
            </button>

            <span className="min-w-12 text-center text-[9px] font-medium tabular-nums text-slate-600">
              {slideIndex + 1} / {slides.length}
            </span>

            <button
              type="button"
              onClick={nextSlide}
              className="flex h-8 w-8 items-center justify-center rounded-lg border border-white/[0.06] bg-white/[0.025] text-slate-500 transition hover:text-white"
              title="Próxima tela"
            >
              <ChevronRight size={14} />
            </button>
          </div>
        </div>

        {autoPlay && (
          <div className="mt-3 h-0.5 overflow-hidden rounded-full bg-white/[0.04]">
            <div
              key={`${slideIndex}-${autoPlay}`}
              className="h-full bg-emerald-400/60"
              style={{
                animation: `controlTowerProgress ${SLIDE_INTERVAL}ms linear forwards`,
              }}
            />
          </div>
        )}
      </section>

      {/* =====================================================
          SLIDE 01 — VISÃO EXECUTIVA
         ===================================================== */}

      {currentSlide.id === "executivo" && (
        <ExecutiveSlide
          dados={dados}
          onOpenProjeto={onOpenProjeto}
        />
      )}

      {/* =====================================================
          SLIDE 02 — MAPA DE PROBLEMAS
         ===================================================== */}

      {currentSlide.id === "problemas" && (
        <ProblemsSlide
          projetos={dados.analisados}
          onOpenProjeto={onOpenProjeto}
        />
      )}

      {/* =====================================================
          SLIDE 03 — RISCOS E BLOQUEIOS
         ===================================================== */}

      {currentSlide.id === "riscos" && (
        <RisksSlide
          projetos={dados.analisados}
          onOpenProjeto={onOpenProjeto}
        />
      )}

      {/* =====================================================
          SLIDE 04 — PENDÊNCIAS
         ===================================================== */}

      {currentSlide.id === "pendencias" && (
        <DataSourcePendingSlide />
      )}

      {/* =====================================================
          SLIDE 05 — RADAR DAS ÁREAS
         ===================================================== */}

      {currentSlide.id === "areas" && (
        <AreasSlide areas={dados.areas} />
      )}

      {/* =====================================================
          SLIDE 06 — MARCOS
         ===================================================== */}

      {currentSlide.id === "marcos" && (
        <MilestonesSlide
          projetos={dados.proximosMarcos}
          onOpenProjeto={onOpenProjeto}
        />
      )}

      {/* =====================================================
          SLIDE 07 — CAPACIDADE
         ===================================================== */}

      {currentSlide.id === "capacidade" && (
        <CapacitySlide
          responsaveis={dados.responsaveis}
        />
      )}

      {/* =====================================================
          SLIDE 08 — GUERRA
         ===================================================== */}

      {currentSlide.id === "guerra" && (
        <WarRoomSlide
          dados={dados}
          onOpenProjeto={onOpenProjeto}
        />
      )}

      <style jsx global>{`
        @keyframes controlTowerProgress {
          from {
            width: 0%;
          }

          to {
            width: 100%;
          }
        }
      `}</style>
    </div>
  );
}

function ExecutiveSlide({
  dados,
  onOpenProjeto,
}: {
  dados: any;
  onOpenProjeto: (id: string) => void;
}) {
  const totalSaude =
    dados.criticos.length +
    dados.atencao.length +
    dados.estaveis.length;

  const percentualSaudavel =
    totalSaude > 0
      ? Math.round(
          (dados.estaveis.length / totalSaude) * 100,
        )
      : 100;

  return (
    <div className="space-y-4">
      <section className="grid gap-3 sm:grid-cols-2 xl:grid-cols-6">
        <MetricCard
          label="Projetos ativos"
          value={dados.ativos.length}
          helper={`${dados.progressoMedio}% progresso médio`}
          icon={Layers3}
          tone="sky"
        />

        <MetricCard
          label="Críticos"
          value={dados.criticos.length}
          helper="Ação imediata"
          icon={ShieldAlert}
          tone={
            dados.criticos.length > 0
              ? "red"
              : "emerald"
          }
        />

        <MetricCard
          label="Em atenção"
          value={dados.atencao.length}
          helper="Monitorar de perto"
          icon={AlertTriangle}
          tone={
            dados.atencao.length > 0
              ? "amber"
              : "emerald"
          }
        />

        <MetricCard
          label="Atrasados"
          value={dados.atrasados.length}
          helper="Prazo ultrapassado"
          icon={Clock3}
          tone={
            dados.atrasados.length > 0
              ? "red"
              : "emerald"
          }
        />

        <MetricCard
          label="Bloqueados"
          value={dados.bloqueados.length}
          helper="Fluxo interrompido"
          icon={CircleAlert}
          tone={
            dados.bloqueados.length > 0
              ? "red"
              : "emerald"
          }
        />

        <MetricCard
          label="Sem prazo"
          value={dados.semPrazo.length}
          helper="Previsão necessária"
          icon={CalendarDays}
          tone={
            dados.semPrazo.length > 0
              ? "amber"
              : "emerald"
          }
        />
      </section>

      <section className="grid gap-4 xl:grid-cols-[0.72fr_1.28fr]">
        <div className="relative overflow-hidden rounded-2xl border border-white/[0.06] bg-white/[0.025] p-5">
          <div className="absolute right-[-50px] top-[-60px] h-[180px] w-[180px] rounded-full bg-emerald-400/[0.035] blur-[70px]" />

          <div className="relative">
            <div className="flex items-center gap-2">
              <Gauge
                size={14}
                className="text-emerald-300"
              />

              <span className="text-[9px] font-semibold uppercase tracking-[0.14em] text-slate-600">
                Saúde da carteira
              </span>
            </div>

            <div className="mt-5 flex items-end gap-2">
              <span className="text-5xl font-semibold tracking-[-0.06em] text-white">
                {percentualSaudavel}
              </span>

              <span className="mb-1 text-lg font-medium text-slate-600">
                %
              </span>
            </div>

            <div className="mt-2 text-[10px] text-slate-500">
              dos projetos ativos classificados como estáveis
            </div>

            <div className="mt-6 h-2 overflow-hidden rounded-full bg-white/[0.05]">
              <div
                className="h-full rounded-full bg-emerald-400/70"
                style={{
                  width: `${percentualSaudavel}%`,
                }}
              />
            </div>

            <div className="mt-5 grid grid-cols-3 gap-2">
              <HealthBox
                label="Crítico"
                value={dados.criticos.length}
                tone="red"
              />

              <HealthBox
                label="Atenção"
                value={dados.atencao.length}
                tone="amber"
              />

              <HealthBox
                label="Estável"
                value={dados.estaveis.length}
                tone="emerald"
              />
            </div>
          </div>
        </div>

        <div className="rounded-2xl border border-white/[0.06] bg-white/[0.02]">
          <div className="flex items-center justify-between border-b border-white/[0.05] px-5 py-4">
            <div>
              <div className="text-[10px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                Atenção imediata
              </div>

              <div className="mt-1 text-[10px] text-slate-600">
                Projetos com maior criticidade neste momento
              </div>
            </div>

            <AlertTriangle
              size={16}
              className="text-red-300"
            />
          </div>

          <div className="divide-y divide-white/[0.04]">
            {dados.analisados
              .filter((item: any) => item.score > 0)
              .slice(0, 6)
              .map((item: any, index: number) => (
                <ProblemRow
                  key={item.projeto.id}
                  item={item}
                  position={index + 1}
                  onOpenProjeto={onOpenProjeto}
