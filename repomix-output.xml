<file path="components/projetos/ProjetoActions.tsx">
"use client";

import {
  CheckCircle2,
  CirclePause,
  Play,
  RotateCcw,
  ShieldAlert,
  XCircle,
  Pencil,
  MoreHorizontal,
} from "lucide-react";
import {
  useEffect,
  useRef,
  useState,
} from "react";
import { createPortal } from "react-dom";
import { usePermissions } from "@/components/auth/usePermissions";

type Status =
  | "Não iniciado"
  | "Planejado"
  | "Em andamento"
  | "Pausado"
  | "Bloqueado"
  | "Finalizado"
  | "Cancelado";

type ProjetoActionsProps = {
  projetoId: string;
  status: Status;
  onEdit?: () => void;
  onUpdated?: () => void;
};

type MenuPosition = {
  top: number;
  left: number;
};

const MENU_WIDTH = 224;
const MENU_GAP = 8;
const VIEWPORT_MARGIN = 12;

const STATUS_ACTIONS: Record<
  Status,
  Array<{
    label: string;
    status: Status;
    icon: typeof Play;
    danger?: boolean;
  }>
> = {
  "Não iniciado": [
    {
      label: "Iniciar projeto",
      status: "Em andamento",
      icon: Play,
    },
    {
      label: "Bloquear",
      status: "Bloqueado",
      icon: ShieldAlert,
      danger: true,
    },
  ],

  Planejado: [
    {
      label: "Iniciar projeto",
      status: "Em andamento",
      icon: Play,
    },
    {
      label: "Bloquear",
      status: "Bloqueado",
      icon: ShieldAlert,
      danger: true,
    },
  ],

  "Em andamento": [
    {
      label: "Pausar",
      status: "Pausado",
      icon: CirclePause,
    },
    {
      label: "Bloquear",
      status: "Bloqueado",
      icon: ShieldAlert,
      danger: true,
    },
    {
      label: "Finalizar",
      status: "Finalizado",
      icon: CheckCircle2,
    },
  ],

  Pausado: [
    {
      label: "Retomar",
      status: "Em andamento",
      icon: RotateCcw,
    },
    {
      label: "Bloquear",
      status: "Bloqueado",
      icon: ShieldAlert,
      danger: true,
    },
  ],

  Bloqueado: [
    {
      label: "Retomar",
      status: "Em andamento",
      icon: RotateCcw,
    },
    {
      label: "Cancelar",
      status: "Cancelado",
      icon: XCircle,
      danger: true,
    },
  ],

  Finalizado: [],
  Cancelado: [],
};

export default function ProjetoActions({
  projetoId,
  status,
  onEdit,
  onUpdated,
}: ProjetoActionsProps) {
  const [open, setOpen] = useState(false);
  const [loading, setLoading] = useState(false);
  const [motivoOpen, setMotivoOpen] = useState(false);
  const [motivo, setMotivo] = useState("");
  const [pendingStatus, setPendingStatus] =
    useState<Status | null>(null);
  const [error, setError] = useState("");
  const [mounted, setMounted] = useState(false);

  const [menuPosition, setMenuPosition] =
    useState<MenuPosition>({
      top: 0,
      left: 0,
    });

  const buttonRef = useRef<HTMLButtonElement | null>(null);
  const menuRef = useRef<HTMLDivElement | null>(null);

  const {
    can,
    loading: permissionsLoading,
  } = usePermissions();

  const canEdit = can("editar");
  const canChangeStatus = can("alterar_status");

  const actions = canChangeStatus
    ? STATUS_ACTIONS[status] ?? []
    : [];

  const hasPermission =
    permissionsLoading ||
    canEdit ||
    canChangeStatus;

  useEffect(() => {
    setMounted(true);
  }, []);

  function atualizarPosicaoMenu() {
    const button = buttonRef.current;

    if (!button) {
      return;
    }

    const rect = button.getBoundingClientRect();

    let left = rect.right - MENU_WIDTH;

    if (left < VIEWPORT_MARGIN) {
      left = VIEWPORT_MARGIN;
    }

    if (
      left + MENU_WIDTH >
      window.innerWidth - VIEWPORT_MARGIN
    ) {
      left =
        window.innerWidth -
        MENU_WIDTH -
        VIEWPORT_MARGIN;
    }

    setMenuPosition({
      top: rect.bottom + MENU_GAP,
      left,
    });
  }

  useEffect(() => {
    if (!open) {
      return;
    }

    atualizarPosicaoMenu();

    function handleResize() {
      atualizarPosicaoMenu();
    }

    function handleScroll() {
      atualizarPosicaoMenu();
    }

    function handleMouseDown(event: MouseEvent) {
      const target = event.target as Node;

      if (
        buttonRef.current?.contains(target) ||
        menuRef.current?.contains(target)
      ) {
        return;
      }

      setOpen(false);
    }

    window.addEventListener("resize", handleResize);
    window.addEventListener("scroll", handleScroll, true);
    document.addEventListener(
      "mousedown",
      handleMouseDown,
    );

    return () => {
      window.removeEventListener(
        "resize",
        handleResize,
      );
      window.removeEventListener(
        "scroll",
        handleScroll,
        true,
      );
      document.removeEventListener(
        "mousedown",
        handleMouseDown,
      );
    };
  }, [open]);

  function selecionarStatus(novoStatus: Status) {
    if (!canChangeStatus) {
      return;
    }

    setError("");

    if (
      novoStatus === "Pausado" ||
      novoStatus === "Bloqueado" ||
      novoStatus === "Cancelado"
    ) {
      setPendingStatus(novoStatus);
      setMotivo("");
      setMotivoOpen(true);
      setOpen(false);
      return;
    }

    executarStatus(novoStatus);
  }

  async function executarStatus(
    novoStatus: Status,
    motivoAtual = "",
  ) {
    if (!canChangeStatus) {
      return;
    }

    try {
      setLoading(true);
      setError("");

      const response = await fetch(
        `/api/projetos/${projetoId}/status`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            status: novoStatus,
            motivo: motivoAtual || null,
            usuario_nome: "Tony Moreira",
          }),
        },
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.error ||
            "Não foi possível alterar o status.",
        );
      }

      setMotivoOpen(false);
      setPendingStatus(null);
      setMotivo("");
      setOpen(false);

      onUpdated?.();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Erro ao alterar status.",
      );
    } finally {
      setLoading(false);
    }
  }

  if (!hasPermission) {
    return null;
  }

  const menu =
    mounted &&
    open &&
    !permissionsLoading
      ? createPortal(
          <div
            ref={menuRef}
            style={{
              position: "fixed",
              top: menuPosition.top,
              left: menuPosition.left,
              width: MENU_WIDTH,
            }}
            className="z-[9999] overflow-hidden rounded-2xl border border-white/[0.09] bg-[#0a0f18]/95 p-1.5 shadow-2xl shadow-black/70 backdrop-blur-xl"
          >
            {canEdit && (
              <button
                type="button"
                onClick={() => {
                  setOpen(false);
                  onEdit?.();
                }}
                className="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm text-slate-300 transition hover:bg-white/[0.06] hover:text-white"
              >
                <Pencil size={15} />
                Editar projeto
              </button>
            )}

            {canEdit && actions.length > 0 && (
              <div className="my-1 border-t border-white/[0.06]" />
            )}

            {actions.map((action) => {
              const Icon = action.icon;

              return (
                <button
                  key={action.label}
                  type="button"
                  disabled={loading}
                  onClick={() =>
                    selecionarStatus(action.status)
                  }
                  className={`flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm transition ${
                    action.danger
                      ? "text-red-300 hover:bg-red-500/[0.08] hover:text-red-200"
                      : "text-slate-300 hover:bg-white/[0.06] hover:text-white"
                  } disabled:cursor-not-allowed disabled:opacity-50`}
                >
                  <Icon size={15} />
                  {action.label}
                </button>
              );
            })}

            {!canEdit &&
              !canChangeStatus && (
                <div className="px-3 py-2.5 text-sm text-slate-500">
                  Você não possui ações disponíveis.
                </div>
              )}
          </div>,
          document.body,
        )
      : null;

  const motivoModal =
    mounted &&
    motivoOpen &&
    pendingStatus &&
    canChangeStatus
      ? createPortal(
          <div className="fixed inset-0 z-[10000] flex items-center justify-center bg-black/70 p-4 backdrop-blur-sm">
            <div className="w-full max-w-md rounded-3xl border border-white/[0.09] bg-[#090e17] p-6 shadow-2xl shadow-black/70">
              <div className="mb-5">
                <div className="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-sky-400">
                  Alteração de status
                </div>

                <h3 className="text-xl font-semibold text-white">
                  {pendingStatus}
                </h3>

                <p className="mt-2 text-sm leading-6 text-slate-400">
                  Registre o motivo desta alteração. Essa
                  informação ficará salva no histórico do projeto.
                </p>
              </div>

              <textarea
                value={motivo}
                onChange={(event) =>
                  setMotivo(event.target.value)
                }
                rows={4}
                autoFocus
                placeholder="Informe o motivo..."
                className="w-full resize-none rounded-2xl border border-white/[0.08] bg-white/[0.03] px-4 py-3 text-sm text-white outline-none transition placeholder:text-slate-600 focus:border-sky-500/40 focus:bg-white/[0.045]"
              />

              {error && (
                <div className="mt-3 rounded-xl border border-red-500/20 bg-red-500/[0.07] px-3 py-2 text-sm text-red-300">
                  {error}
                </div>
              )}

              <div className="mt-5 flex justify-end gap-2">
                <button
                  type="button"
                  disabled={loading}
                  onClick={() => {
                    setMotivoOpen(false);
                    setPendingStatus(null);
                    setMotivo("");
                    setError("");
                  }}
                  className="rounded-xl border border-white/[0.08] bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-slate-300 transition hover:bg-white/[0.06] hover:text-white"
                >
                  Cancelar
                </button>

                <button
                  type="button"
                  disabled={
                    loading ||
                    !motivo.trim()
                  }
                  onClick={() =>
                    executarStatus(
                      pendingStatus,
                      motivo.trim(),
                    )
                  }
                  className="rounded-xl bg-sky-500 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-sky-400 disabled:cursor-not-allowed disabled:opacity-40"
                >
                  {loading
                    ? "Salvando..."
                    : "Confirmar"}
                </button>
              </div>
            </div>
          </div>,
          document.body,
        )
      : null;

  return (
    <>
      <div className="relative">
        <button
          ref={buttonRef}
          type="button"
          disabled={permissionsLoading}
          onClick={() => {
            if (permissionsLoading) {
              return;
            }

            if (!open) {
              atualizarPosicaoMenu();
            }

            setOpen((value) => !value);
          }}
          className="flex h-9 w-9 items-center justify-center rounded-xl border border-white/[0.08] bg-white/[0.03] text-slate-400 transition hover:border-white/[0.14] hover:bg-white/[0.06] hover:text-white disabled:cursor-wait disabled:opacity-50"
          title={
            permissionsLoading
              ? "Carregando permissões..."
              : "Ações"
          }
        >
          <MoreHorizontal size={17} />
        </button>
      </div>

      {menu}
      {motivoModal}
    </>
  );
}
</file>

<file path="components/projetos/ProjetoMarcos.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import {
  AlertTriangle,
  CalendarDays,
  CheckCircle2,
  Circle,
  Clock3,
  Flag,
  Loader2,
  Pencil,
  Plus,
  RefreshCw,
  Trash2,
  UserRound,
  X,
  XCircle,
} from "lucide-react";
import MarcoModal, { type Marco } from "./MarcoModal";

type Responsavel = {
  id: string;
  nome: string;
};

type Props = {
  projetoId: string;
  onChanged?: (marcos: Marco[]) => void;
};

function formatDate(value?: string | null) {
  if (!value) return "Não definida";
  const date = new Date(`${value}T12:00:00`);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat("pt-BR").format(date);
}

function marcoAtrasado(item: Marco) {
  if (!item.data_prevista) return false;
  if (item.status === "Concluído" || item.status === "Cancelado") return false;
  return new Date(`${item.data_prevista}T23:59:59`).getTime() < Date.now();
}

function StatusIcon({ marco }: { marco: Marco }) {
  if (marco.status === "Concluído") {
    return <CheckCircle2 size={18} className="text-emerald-400" />;
  }
  if (marco.status === "Cancelado") {
    return <XCircle size={18} className="text-slate-500" />;
  }
  if (marcoAtrasado(marco)) {
    return <AlertTriangle size={18} className="text-rose-400" />;
  }
  if (marco.status === "Em andamento") {
    return <Clock3 size={18} className="text-sky-400" />;
  }
  return <Circle size={18} className="text-slate-500" />;
}

function statusClass(item: Marco) {
  if (marcoAtrasado(item)) {
    return "border-rose-400/25 bg-rose-500/10 text-rose-300";
  }
  if (item.status === "Concluído") {
    return "border-emerald-400/25 bg-emerald-500/10 text-emerald-300";
  }
  if (item.status === "Em andamento") {
    return "border-sky-400/25 bg-sky-500/10 text-sky-300";
  }
  return "border-white/[0.08] bg-white/[0.03] text-slate-400";
}

export default function ProjetoMarcos({ projetoId, onChanged }: Props) {
  const [marcos, setMarcos] = useState<Marco[]>([]);
  const [responsaveis, setResponsaveis] = useState<Responsavel[]>([]);
  const [loading, setLoading] = useState(true);
  const [erro, setErro] = useState("");
  const [modalOpen, setModalOpen] = useState(false);
  const [editando, setEditando] = useState<Marco | null>(null);
  const [excluindoId, setExcluindoId] = useState<string | null>(null);
  const [marcoParaExcluir, setMarcoParaExcluir] = useState<Marco | null>(null);

  const carregar = useCallback(async () => {
    try {
      setLoading(true);
      setErro("");

      const [marcosResponse, opcoesResponse] = await Promise.all([
        fetch(`/api/projetos/${projetoId}/marcos`, {
          cache: "no-store",
          credentials: "same-origin",
        }),
        fetch("/api/opcoes", {
          cache: "no-store",
          credentials: "same-origin",
        }),
      ]);

      const marcosResult = await marcosResponse.json();
      const opcoesResult = await opcoesResponse.json();

      if (!marcosResponse.ok || !marcosResult.success) {
        throw new Error(
          marcosResult.error || "Não foi possível carregar os marcos.",
        );
      }

      const lista = (marcosResult.marcos ?? []) as Marco[];
      setMarcos(lista);
      onChanged?.(lista);

      if (opcoesResponse.ok && opcoesResult.success) {
        setResponsaveis(opcoesResult.responsaveis ?? []);
      }
    } catch (error) {
      setMarcos([]);
      setErro(
        error instanceof Error
          ? error.message
          : "Erro inesperado ao carregar marcos.",
      );
    } finally {
      setLoading(false);
    }
  }, [projetoId, onChanged]);

  useEffect(() => {
    void carregar();
  }, [carregar]);

  const contadores = useMemo(
    () => ({
      total: marcos.length,
      concluidos: marcos.filter((item) => item.status === "Concluído").length,
      atrasados: marcos.filter(marcoAtrasado).length,
    }),
    [marcos],
  );

  const proximaOrdem = useMemo(() => {
    if (marcos.length === 0) return 1;
    return Math.max(...marcos.map((item) => Number(item.ordem) || 0)) + 1;
  }, [marcos]);

  async function excluir(item: Marco) {
    try {
      setExcluindoId(item.id);
      setErro("");

      const response = await fetch(
        `/api/projetos/${projetoId}/marcos/${item.id}`,
        {
          method: "DELETE",
          credentials: "same-origin",
        },
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.error || "Não foi possível excluir o marco.");
      }

      setMarcoParaExcluir(null);
      await carregar();
    } catch (error) {
      setErro(
        error instanceof Error
          ? error.message
          : "Erro inesperado ao excluir marco.",
      );
    } finally {
      setExcluindoId(null);
    }
  }

  return (
    <>
      <section className="rounded-[22px] border border-white/[0.07] bg-white/[0.025] p-5">
        <div className="mb-5 flex flex-wrap items-center justify-between gap-4">
          <div>
            <div className="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500">
              Cronograma
            </div>
            <h3 className="mt-1 flex items-center gap-2 text-base font-bold text-white">
              <Flag size={17} className="text-sky-400" />
              Marcos do projeto
            </h3>
          </div>

          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={() => void carregar()}
              disabled={loading}
              className="rounded-xl border border-white/[0.08] bg-white/[0.03] p-2.5 text-slate-400 transition hover:bg-white/[0.07] hover:text-white disabled:opacity-50"
              title="Atualizar marcos"
            >
              <RefreshCw size={16} className={loading ? "animate-spin" : ""} />
            </button>

            <button
              type="button"
              onClick={() => {
                setEditando(null);
                setModalOpen(true);
              }}
              className="flex items-center gap-2 rounded-xl bg-sky-400 px-3.5 py-2.5 text-sm font-bold text-slate-950 transition hover:bg-sky-300"
            >
              <Plus size={17} />
              Novo marco
            </button>
          </div>
        </div>

        <div className="mb-5 grid grid-cols-3 gap-3">
          <div className="rounded-xl border border-white/[0.06] bg-black/15 px-3 py-3">
            <div className="text-xl font-bold text-white">{contadores.total}</div>
            <div className="text-[11px] uppercase tracking-wide text-slate-500">Total</div>
          </div>
          <div className="rounded-xl border border-emerald-400/10 bg-emerald-500/[0.04] px-3 py-3">
            <div className="text-xl font-bold text-emerald-300">{contadores.concluidos}</div>
            <div className="text-[11px] uppercase tracking-wide text-slate-500">Concluídos</div>
          </div>
          <div className="rounded-xl border border-rose-400/10 bg-rose-500/[0.04] px-3 py-3">
            <div className="text-xl font-bold text-rose-300">{contadores.atrasados}</div>
            <div className="text-[11px] uppercase tracking-wide text-slate-500">Atrasados</div>
          </div>
        </div>

        {erro && (
          <div className="mb-4 flex items-start gap-3 rounded-xl border border-rose-400/20 bg-rose-500/10 p-3 text-sm text-rose-200">
            <AlertTriangle className="mt-0.5 shrink-0" size={17} />
            <span>{erro}</span>
          </div>
        )}

        {loading && marcos.length === 0 ? (
          <div className="flex min-h-28 items-center justify-center gap-2 text-sm text-slate-500">
            <Loader2 className="animate-spin" size={17} />
            Carregando marcos...
          </div>
        ) : marcos.length === 0 ? (
          <div className="rounded-xl border border-dashed border-white/[0.08] bg-black/10 px-4 py-7 text-center">
            <Flag className="mx-auto mb-2 text-sky-400/70" size={25} />
            <div className="text-sm font-semibold text-slate-300">
              Nenhum marco cadastrado
            </div>
            <div className="mt-1 text-xs text-slate-600">
              Use “Novo marco” para montar o cronograma do projeto.
            </div>
          </div>
        ) : (
          <div className="relative">
            <div className="absolute bottom-4 left-[9px] top-4 w-px bg-white/[0.08]" />

            <div className="space-y-3">
              {marcos.map((item) => {
                const atrasado = marcoAtrasado(item);

                return (
                  <article key={item.id} className="relative pl-8">
                    <div className="absolute left-0 top-4 z-10 rounded-full bg-[#0b1326]">
                      <StatusIcon marco={item} />
                    </div>

                    <div className="rounded-xl border border-white/[0.07] bg-black/10 p-4">
                      <div className="flex items-start justify-between gap-3">
                        <div className="min-w-0 flex-1">
                          <div className="flex flex-wrap items-center gap-2">
                            <h4 className="text-sm font-semibold text-white">
                              {item.nome}
                            </h4>

                            <span className={`rounded-md border px-2 py-1 text-[10px] font-semibold ${statusClass(item)}`}>
                              {atrasado ? "Atrasado" : item.status}
                            </span>
                          </div>

                          {item.descricao && (
                            <p className="mt-2 text-xs leading-5 text-slate-500">
                              {item.descricao}
                            </p>
                          )}

                          <div className="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] text-slate-500">
                            <span className="flex items-center gap-1">
                              <UserRound size={12} />
                              {item.responsavel?.nome ?? "Sem responsável"}
                            </span>

                            <span className={atrasado ? "flex items-center gap-1 font-semibold text-rose-300" : "flex items-center gap-1"}>
                              <CalendarDays size={12} />
                              Previsto: {formatDate(item.data_prevista)}
                            </span>

                            {item.data_realizada && (
                              <span className="flex items-center gap-1 text-emerald-400">
                                <CheckCircle2 size={12} />
