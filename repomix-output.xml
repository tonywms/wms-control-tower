   {itens.length===0?<div className="flex min-h-[260px] items-center justify-center p-8 text-center"><div><CheckCircle2 size={30} className="mx-auto text-emerald-300"/><div className="mt-3 text-sm font-semibold text-slate-300">Nenhuma inconsistência neste filtro</div></div></div>:<div className="divide-y divide-white/[.045]">{itens.map(x=><article key={x.id} className="grid gap-4 px-5 py-4 hover:bg-white/[.018] xl:grid-cols-[190px_1fr_250px_210px]"><div><div className="flex items-center gap-2">{x.severidade==="Crítico"?<CircleAlert size={14} className="text-red-300"/>:<TriangleAlert size={14} className="text-amber-300"/>}<span className={`rounded-full border px-2 py-.5 text-[8px] font-semibold ${x.severidade==="Crítico"?"border-red-400/15 bg-red-400/[.05] text-red-300":"border-amber-400/15 bg-amber-400/[.05] text-amber-300"}`}>{x.severidade}</span></div><div className="mt-2 text-[11px] font-semibold text-slate-200">{x.projeto_nome}</div><div className="mt-1 text-[8px] uppercase tracking-[.1em] text-slate-700">{x.categoria}</div></div><div><div className="text-[11px] font-semibold text-slate-300">{x.titulo}</div><div className="mt-1 text-[9px] leading-4 text-slate-600">{x.descricao}</div><div className="mt-2 flex gap-4 text-[8px] text-slate-700"><span>Owner: {x.responsavel_nome||"Sem responsável"}</span><span>Prazo: {dataBR(x.prazo)}</span></div></div><div className="rounded-xl border border-sky-400/[.08] bg-sky-400/[.025] p-3"><div className="text-[8px] font-semibold uppercase tracking-[.12em] text-sky-400/70">Ação recomendada</div><div className="mt-1.5 text-[9px] leading-4 text-slate-500">{x.recomendacao}</div></div><div className="flex items-center justify-end gap-2"><button onClick={()=>setItemSelecionado(x)} className="flex items-center gap-1.5 rounded-xl border border-amber-400/20 bg-amber-400/[.06] px-3 py-2 text-[9px] font-semibold text-amber-200 hover:bg-amber-400/[.11]"><Wrench size={12}/>Sanear</button><button onClick={()=>void onOpenProjeto(x.projeto_id)} className="flex items-center gap-1.5 rounded-xl border border-sky-400/15 bg-sky-400/[.05] px-3 py-2 text-[9px] text-sky-300 hover:bg-sky-400/[.10]">360<ChevronRight size={12}/></button></div></article>)}</div>}
  </div>
  <HistoricoSaneamentosModal open={historicoOpen} onClose={()=>setHistoricoOpen(false)} onOpenProjeto={onOpenProjeto}/>
  {itemSelecionado&&<SaneamentoModal item={itemSelecionado} responsaveis={responsaveis} saving={saving} onClose={()=>setItemSelecionado(null)} onApply={aplicar} onOpenProjeto={()=>void onOpenProjeto(itemSelecionado.projeto_id)}/>}
 </section>
}

function SaneamentoModal({item,responsaveis,saving,onClose,onApply,onOpenProjeto}:{item:Item;responsaveis:Responsavel[];saving:boolean;onClose:()=>void;onApply:(op:Operacao,v?:string)=>Promise<void>;onOpenProjeto:()=>void}){
 const[prazo,setPrazo]=useState("");
 const[responsavel,setResponsavel]=useState("");
 const podeStatus=item.item_tipo!=="projeto";
 const precisaPrazo=item.categoria==="Prazo"||item.titulo.toLowerCase().includes("prazo");
