                  {dias}
                </span>

                <span className="text-[7px] uppercase text-slate-600">
                  dias
                </span>
              </div>

              <div className="min-w-0 flex-1">
                <div className="truncate text-[11px] font-semibold text-slate-300">
                  {projeto.nome}
                </div>

                <div className="mt-1 truncate text-[9px] text-slate-600">
                  {projeto.cliente?.nome ??
                    "Cliente não informado"}{" "}
