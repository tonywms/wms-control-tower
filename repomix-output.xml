  --text: #f3f6ff;
  --text-soft: #cdd5f5;
  --text-muted: #a1acd9;
  --text-faint: #8794c7;

  /* Linhas */
  --line: rgba(142, 160, 255, 0.16);
  --line-strong: rgba(142, 160, 255, 0.28);

  /* Gradientes de marca */
  --brand: linear-gradient(120deg, #22d3ee 0%, #4f8bff 42%, #8b5cf6 78%, #d946ef 100%);
  --brand-soft: linear-gradient(120deg, rgba(34, 211, 238, 0.22), rgba(99, 102, 241, 0.22) 55%, rgba(217, 70, 239, 0.18));

  /* Vidro */
  --glass-fill: linear-gradient(160deg, rgba(34, 48, 112, 0.70) 0%, rgba(14, 22, 62, 0.66) 100%);
  --glass-fill-hi: linear-gradient(160deg, rgba(48, 66, 148, 0.78) 0%, rgba(20, 30, 80, 0.72) 100%);
  --glass-edge: linear-gradient(145deg, rgba(125, 211, 252, 0.40) 0%, rgba(129, 140, 248, 0.16) 38%, rgba(217, 70, 239, 0.22) 100%);
  --glass-edge-hot: linear-gradient(145deg, rgba(34, 211, 238, 0.85) 0%, rgba(99, 102, 241, 0.55) 50%, rgba(217, 70, 239, 0.75) 100%);

  --shadow-card: 0 18px 44px -18px rgba(2, 4, 24, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  --shadow-lift: 0 28px 60px -20px rgba(2, 4, 24, 0.85), 0 0 0 1px rgba(125, 211, 252, 0.12), 0 0 40px -10px rgba(79, 139, 255, 0.35);

