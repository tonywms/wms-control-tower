                  selectedMenu === item.label;
                const hasChildren =
                  "children" in item &&
                  Array.isArray(item.children);

                return (
                  <div key={item.label}>
                    <button
                      type="button"
                      onClick={() => {
                        if (hasChildren) {
                          setSelectedMenu(item.label);
                          setConfiguracoesOpen(
                            (open) => !open,
                          );
                          return;
                        }

                        setSelectedMenu(item.label);
                        setSidebarOpen(false);
                      }}
                      className={[
                        "flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-[13px] transition",
                        active
                          ? "bg-white/[0.06] text-white"
                          : "text-slate-500 hover:bg-white/[0.035] hover:text-slate-200",
                      ].join(" ")}
                    >
                      <Icon size={16} />

                      <span className="flex-1">
                        {item.label}
                      </span>

                      {hasChildren && (
                        <ChevronDown
                          size={14}
                          className={[
                            "transition-transform duration-200",
                            configuracoesOpen
                              ? "rotate-180"
                              : "",
                          ].join(" ")}
                        />
                      )}
                    </button>

                    {hasChildren &&
                      configuracoesOpen && (
                        <div className="ml-4 mt-1 space-y-1 border-l border-white/[0.06] pl-3">
                          {item.children?.map(
                            (child) => (
                              <button
                                key={child.href}
                                type="button"
                                onClick={() => {
                                  setSidebarOpen(false);
                                  router.push(
                                    child.href,
                                  );
                                }}
                                className="flex w-full items-center rounded-lg px-3 py-2 text-left text-[12px] text-slate-500 transition hover:bg-white/[0.035] hover:text-sky-200"
                              >
                                {child.label}
                              </button>
                            ),
                          )}
                        </div>
                      )}
                  </div>
                );
              })}
            </nav>

            <div className="mt-5 rounded-2xl border border-white/[0.06] bg-white/[0.025] p-3">
              <div className="flex items-center gap-2">
                <div className="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.45)]" />

                <span className="text-[11px] font-medium text-slate-300">
                  Supabase conectado
                </span>
              </div>

              <div className="mt-2 text-[10px] leading-4 text-slate-600">
                Dados operacionais sincronizados
                com a base central.
              </div>
            </div>
          </div>
        </aside>

        {/* MAIN */}

        <section className="min-w-0 flex-1">
          {/* TOPBAR */}

          <header className="flex h-[76px] items-center gap-4 border-b border-white/[0.06] px-4 sm:px-6 lg:px-8">
            <button
              onClick={() =>
                setSidebarOpen(true)
              }
              className="rounded-xl border border-white/[0.06] bg-white/[0.025] p-2.5 text-slate-400 hover:text-white lg:hidden"
