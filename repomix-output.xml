              >
                360
                <ArrowRight size={10} />
              </button>
            </div>
          );
        })}

        {projetos.length === 0 && (
          <EmptyState
            title="Nenhum marco nos próximos 15 dias"
            description="Não existem projetos ativos com data final prevista dentro desta janela."
          />
        )}
      </div>
    </section>
  );
}

function CapacitySlide({
  responsaveis,
}: {
  responsaveis: Array<{
    nome: string;
    projetos: number;
    criticos: number;
    atencao: number;
    atrasados: number;
    score: number;
  }>;
}) {
  const maxScore = Math.max(
    1,
    ...responsaveis.map((item) => item.score),
  );

  return (
    <section className="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-5">
      <div>
        <div className="text-[10px] font-semibold uppercase tracking-[0.15em] text-slate-500">
          Pressão por responsável
        </div>

        <div className="mt-1 text-[11px] text-slate-600">
          Indicador provisório baseado em projetos, criticidade
          e atrasos
        </div>
      </div>

      <div className="mt-5 space-y-2">
        {responsaveis.slice(0, 12).map((item, index) => {
          const percentual = Math.round(
            (item.score / maxScore) * 100,
          );

          return (
