                    <Check className="h-4 w-4" />
                  )}
                  Confirmar alteração
                </button>
              </div>
            </div>
          </div>
        )}
    </section>
  );
}
</file>

<file path="components/projetos/ProjetoActions.tsx">
"use client";

import {
  CheckCircle2,
  CirclePause,
  Play,
  RotateCcw,
  ShieldAlert,
  XCircle,
  Pencil,
  MoreHorizontal,
} from "lucide-react";
import { useState } from "react";
import { usePermissions } from "@/components/auth/usePermissions";

type Status =
  | "Não iniciado"
  | "Planejado"
  | "Em andamento"
  | "Pausado"
  | "Bloqueado"
  | "Finalizado"
  | "Cancelado";

type ProjetoActionsProps = {
  projetoId: string;
  status: Status;
  onEdit?: () => void;
  onUpdated?: () => void;
};

const STATUS_ACTIONS: Record<
  Status,
  Array<{
    label: string;
    status: Status;
    icon: typeof Play;
    danger?: boolean;
  }>
> = {
  "Não iniciado": [
    {
      label: "Iniciar projeto",
      status: "Em andamento",
      icon: Play,
    },
    {
      label: "Bloquear",
      status: "Bloqueado",
      icon: ShieldAlert,
      danger: true,
    },
  ],

  Planejado: [
    {
      label: "Iniciar projeto",
      status: "Em andamento",
      icon: Play,
    },
    {
      label: "Bloquear",
      status: "Bloqueado",
      icon: ShieldAlert,
      danger: true,
    },
  ],

  "Em andamento": [
    {
      label: "Pausar",
      status: "Pausado",
      icon: CirclePause,
    },
    {
      label: "Bloquear",
      status: "Bloqueado",
      icon: ShieldAlert,
      danger: true,
    },
    {
      label: "Finalizar",
      status: "Finalizado",
      icon: CheckCircle2,
    },
  ],

  Pausado: [
    {
      label: "Retomar",
      status: "Em andamento",
      icon: RotateCcw,
    },
    {
      label: "Bloquear",
      status: "Bloqueado",
      icon: ShieldAlert,
      danger: true,
    },
  ],

  Bloqueado: [
    {
      label: "Retomar",
      status: "Em andamento",
      icon: RotateCcw,
    },
    {
      label: "Cancelar",
      status: "Cancelado",
      icon: XCircle,
      danger: true,
    },
  ],

  Finalizado: [],

  Cancelado: [],
};

export default function ProjetoActions({
  projetoId,
  status,
  onEdit,
  onUpdated,
}: ProjetoActionsProps) {
  const [open, setOpen] = useState(false);
  const [loading, setLoading] = useState(false);
  const [motivoOpen, setMotivoOpen] = useState(false);
  const [motivo, setMotivo] = useState("");
  const [pendingStatus, setPendingStatus] =
    useState<Status | null>(null);
  const [error, setError] = useState("");

  const {
    can,
    loading: permissionsLoading,
  } = usePermissions();

  const canEdit = can("editar");
  const canChangeStatus = can("alterar_status");

  const actions = canChangeStatus
    ? STATUS_ACTIONS[status] ?? []
    : [];

  const hasPermission =
    permissionsLoading ||
    canEdit ||
    canChangeStatus;

  function selecionarStatus(novoStatus: Status) {
    if (!canChangeStatus) {
      return;
    }

    setError("");

    if (
      novoStatus === "Pausado" ||
      novoStatus === "Bloqueado" ||
      novoStatus === "Cancelado"
    ) {
      setPendingStatus(novoStatus);
      setMotivo("");
      setMotivoOpen(true);
      setOpen(false);
      return;
    }

    executarStatus(novoStatus);
  }

  async function executarStatus(
    novoStatus: Status,
    motivoAtual = "",
  ) {
    if (!canChangeStatus) {
      return;
    }

    try {
      setLoading(true);
      setError("");

      const response = await fetch(
        `/api/projetos/${projetoId}/status`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            status: novoStatus,
            motivo: motivoAtual || null,
            usuario_nome: "Tony Moreira",
          }),
        },
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.error ||
            "Não foi possível alterar o status.",
        );
      }

      setMotivoOpen(false);
      setPendingStatus(null);
      setMotivo("");
      setOpen(false);

      onUpdated?.();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Erro ao alterar status.",
      );
    } finally {
      setLoading(false);
    }
  }

  if (!hasPermission) {
    return null;
  }

  return (
    <>
      <div className="relative">
        <button
          type="button"
          disabled={permissionsLoading}
          onClick={() => {
            if (!permissionsLoading) {
              setOpen((value) => !value);
            }
          }}
          className="flex h-9 w-9 items-center justify-center rounded-xl border border-white/[0.08] bg-white/[0.03] text-slate-400 transition hover:border-white/[0.14] hover:bg-white/[0.06] hover:text-white disabled:cursor-wait disabled:opacity-50"
          title={
            permissionsLoading
              ? "Carregando permissões..."
              : "Ações"
          }
        >
          <MoreHorizontal size={17} />
        </button>

        {open && !permissionsLoading && (
          <div className="absolute right-0 top-11 z-50 w-56 overflow-hidden rounded-2xl border border-white/[0.09] bg-[#0a0f18]/95 p-1.5 shadow-2xl shadow-black/50 backdrop-blur-xl">
            {canEdit && (
              <button
                type="button"
                onClick={() => {
                  setOpen(false);
                  onEdit?.();
                }}
                className="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm text-slate-300 transition hover:bg-white/[0.06] hover:text-white"
              >
                <Pencil size={15} />
                Editar projeto
              </button>
            )}

            {canEdit && actions.length > 0 && (
              <div className="my-1 border-t border-white/[0.06]" />
            )}

            {actions.map((action) => {
              const Icon = action.icon;

              return (
                <button
                  key={action.label}
                  type="button"
                  disabled={loading}
                  onClick={() =>
                    selecionarStatus(action.status)
                  }
                  className={`flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm transition ${
                    action.danger
                      ? "text-red-300 hover:bg-red-500/[0.08] hover:text-red-200"
                      : "text-slate-300 hover:bg-white/[0.06] hover:text-white"
                  } disabled:cursor-not-allowed disabled:opacity-50`}
                >
                  <Icon size={15} />
                  {action.label}
                </button>
              );
            })}

            {!canEdit &&
              !canChangeStatus && (
                <div className="px-3 py-2.5 text-sm text-slate-500">
                  Você não possui ações disponíveis.
                </div>
              )}
          </div>
        )}
      </div>

      {motivoOpen && pendingStatus && canChangeStatus && (
        <div className="fixed inset-0 z-[100] flex items-center justify-center bg-black/70 p-4 backdrop-blur-sm">
          <div className="w-full max-w-md rounded-3xl border border-white/[0.09] bg-[#090e17] p-6 shadow-2xl shadow-black/70">
            <div className="mb-5">
              <div className="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-sky-400">
                Alteração de status
              </div>

              <h3 className="text-xl font-semibold text-white">
                {pendingStatus}
              </h3>

              <p className="mt-2 text-sm leading-6 text-slate-400">
                Registre o motivo desta alteração. Essa
                informação ficará salva no histórico do projeto.
              </p>
            </div>

            <textarea
              value={motivo}
              onChange={(event) =>
                setMotivo(event.target.value)
              }
              rows={4}
              autoFocus
              placeholder="Informe o motivo..."
              className="w-full resize-none rounded-2xl border border-white/[0.08] bg-white/[0.03] px-4 py-3 text-sm text-white outline-none transition placeholder:text-slate-600 focus:border-sky-500/40 focus:bg-white/[0.045]"
            />

            {error && (
              <div className="mt-3 rounded-xl border border-red-500/20 bg-red-500/[0.07] px-3 py-2 text-sm text-red-300">
                {error}
              </div>
            )}

            <div className="mt-5 flex justify-end gap-2">
              <button
                type="button"
                disabled={loading}
                onClick={() => {
                  setMotivoOpen(false);
                  setPendingStatus(null);
                  setMotivo("");
                }}
                className="rounded-xl border border-white/[0.08] bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-slate-300 transition hover:bg-white/[0.06] hover:text-white"
              >
                Cancelar
              </button>

              <button
                type="button"
                disabled={
                  loading ||
                  !motivo.trim()
                }
                onClick={() =>
                  executarStatus(
                    pendingStatus,
                    motivo.trim(),
                  )
                }
                className="rounded-xl bg-sky-500 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-sky-400 disabled:cursor-not-allowed disabled:opacity-40"
              >
                {loading
                  ? "Salvando..."
                  : "Confirmar"}
              </button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}
</file>

<file path="components/projetos/ProjetoModal.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  X,
  Save,
  Loader2,
} from "lucide-react";

type Projeto = {
  id: string;
  nome: string;
  plataforma?: string | null;
  etapa_id?: string | null;
  setor?: string | null;
  responsavel_id?: string | null;
  responsavel_nome?: string | null;
  status: string;
  prioridade: string;
  data_inicio?: string | null;
  data_fim?: string | null;
  observacoes?: string | null;
  fase_origem?: string | null;
  percentual: number;
};

type Etapa = {
  id: string;
  nome: string;
  ordem?: number;
};

type Responsavel = {
  id: string;
  nome: string;
};

type ProjetoModalProps = {
  projeto: Projeto | null;
  open: boolean;
  onClose: () => void;
  onSaved?: () => void;
};

const STATUS = [
  "Não iniciado",
  "Planejado",
  "Em andamento",
  "Pausado",
  "Bloqueado",
  "Finalizado",
  "Cancelado",
];

const PRIORIDADES = [
  "Baixa",
  "Normal",
  "Alta",
  "Crítica",
];

const PLATAFORMAS = [
  "Web SaaS",
  "LegaWeb",
  "Legado",
];

const SETORES = [
  "Comercial",
  "Planejamento",
  "Implantação",
  "Desenvolvimento",
  "Suporte",
];

export default function ProjetoModal({
  projeto,
  open,
  onClose,
  onSaved,
}: ProjetoModalProps) {
  const [form, setForm] = useState({
    nome: "",
    plataforma: "",
    etapa_id: "",
    setor: "",
    responsavel_id: "",
    responsavel_nome: "",
    status: "Não iniciado",
    prioridade: "Normal",
    data_inicio: "",
    data_fim: "",
    observacoes: "",
    fase_origem: "",
    percentual: 0,
  });

  const [etapas, setEtapas] = useState<Etapa[]>([]);
  const [responsaveis, setResponsaveis] = useState<
    Responsavel[]
  >([]);

  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");

  /*
   * ============================================================
   * CARREGAR DADOS DO PROJETO
   * ============================================================
   */

  useEffect(() => {
    if (!projeto || !open) return;

    setForm({
      nome: projeto.nome ?? "",
      plataforma: projeto.plataforma ?? "",
      etapa_id: projeto.etapa_id ?? "",
      setor: projeto.setor ?? "",
      responsavel_id: projeto.responsavel_id ?? "",
      responsavel_nome: projeto.responsavel_nome ?? "",
      status: projeto.status ?? "Não iniciado",
      prioridade: projeto.prioridade ?? "Normal",
      data_inicio: projeto.data_inicio ?? "",
      data_fim: projeto.data_fim ?? "",
      observacoes: projeto.observacoes ?? "",
      fase_origem: projeto.fase_origem ?? "",
      percentual: projeto.percentual ?? 0,
    });

    setError("");
  }, [projeto, open]);

  /*
   * ============================================================
   * CARREGAR ETAPAS E RESPONSÁVEIS
   * ============================================================
   */

  useEffect(() => {
    if (!open) return;

    async function carregarOpcoes() {
      try {
        const response = await fetch("/api/opcoes", {
          cache: "no-store",
        });

        if (!response.ok) {
          throw new Error(
            "Não foi possível carregar as opções.",
          );
        }

        const result = await response.json();

        setEtapas(result.etapas ?? []);
        setResponsaveis(result.responsaveis ?? []);
      } catch {
        setEtapas([]);
        setResponsaveis([]);
      }
    }

    carregarOpcoes();
  }, [open]);

  if (!open || !projeto) {
    return null;
  }

  /*
   * ============================================================
   * ATUALIZAR CAMPO
   * ============================================================
   */

  function atualizar(
    campo: keyof typeof form,
    valor: string | number,
  ) {
    setForm((atual) => ({
      ...atual,
      [campo]: valor,
    }));
  }

  /*
   * ============================================================
   * ALTERAÇÃO DA ETAPA
   *
   * A ETAPA é a fase atual do projeto.
   *
   * Exemplo:
   * Go-Live -> Suporte
   *
   * significa:
   *
   * etapa_id = UUID da etapa Suporte
   *
   * ============================================================
   */

  function alterarEtapa(etapaId: string) {
    const etapaSelecionada = etapas.find(
      (etapa) => etapa.id === etapaId,
    );

    setForm((atual) => ({
      ...atual,

      etapa_id: etapaId,

      /*
       * Mantemos fase_origem sincronizada com a etapa atual.
       * Isso evita que a tela fique mostrando uma origem antiga
       * depois que o projeto mudou de fase.
       */
      fase_origem:
        etapaSelecionada?.nome ?? atual.fase_origem,
    }));
  }

  /*
   * ============================================================
   * ALTERAÇÃO DA FASE DE ORIGEM
   *
   * Compatibilidade com o campo antigo.
   *
   * Se o usuário digitar/selecionar o nome de uma etapa existente,
   * encontramos automaticamente o UUID correspondente e também
   * alteramos etapa_id.
   * ============================================================
   */

  function alterarFaseOrigem(valor: string) {
    const etapaCorrespondente = etapas.find(
      (etapa) =>
        etapa.nome.toLowerCase().trim() ===
        valor.toLowerCase().trim(),
    );

    setForm((atual) => ({
      ...atual,

      fase_origem: valor,

      ...(etapaCorrespondente
        ? {
            etapa_id: etapaCorrespondente.id,
          }
        : {}),
    }));
  }

  /*
   * ============================================================
   * SALVAR
   * ============================================================
   */

  async function salvar() {
    try {
      setSaving(true);
      setError("");

      if (!form.nome.trim()) {
        throw new Error(
          "Informe o nome do projeto.",
        );
      }

      /*
       * Garante que o etapa_id realmente corresponda
       * à etapa selecionada.
       */
      let etapaIdFinal = form.etapa_id;

      /*
       * Se por algum motivo o etapa_id estiver vazio,
       * mas a fase_origem corresponder a uma etapa existente,
       * recuperamos automaticamente o ID.
       */
      if (!etapaIdFinal && form.fase_origem.trim()) {
        const etapaCorrespondente = etapas.find(
          (etapa) =>
            etapa.nome.toLowerCase().trim() ===
            form.fase_origem
              .toLowerCase()
              .trim(),
        );

        if (etapaCorrespondente) {
          etapaIdFinal = etapaCorrespondente.id;
        }
      }

      /*
       * Se existe etapa_id, buscamos o nome real da etapa
       * para manter fase_origem coerente.
       */
      let faseOrigemFinal = form.fase_origem;

      if (etapaIdFinal) {
        const etapaSelecionada = etapas.find(
          (etapa) => etapa.id === etapaIdFinal,
        );

        if (etapaSelecionada) {
          faseOrigemFinal = etapaSelecionada.nome;
        }
      }

      const payload = {
        ...form,

        /*
         * ESTE É O CAMPO PRINCIPAL DA FASE ATUAL.
         */
        etapa_id: etapaIdFinal || null,

        /*
         * Mantém compatibilidade com o campo existente.
         */
        fase_origem:
          faseOrigemFinal.trim() || null,

        usuario_nome: "Tony Moreira",
      };

      console.log(
        "[ProjetoModal] Salvando projeto:",
        {
          projeto_id: projeto.id,
          etapa_id: payload.etapa_id,
          fase_origem: payload.fase_origem,
        },
      );

      const response = await fetch(
        `/api/projetos/${projeto.id}`,
        {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        },
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.error ||
            "Não foi possível salvar o projeto.",
        );
      }

      /*
       * Confirma no console exatamente o que a API devolveu.
       */
      console.log(
        "[ProjetoModal] Projeto atualizado:",
        result.projeto,
      );

      onClose();

      /*
       * Recarrega a carteira para que o card receba
       * a nova etapa do banco.
       */
      onSaved?.();
    } catch (err) {
      console.error(
        "[ProjetoModal] Erro ao salvar:",
        err,
      );

      setError(
        err instanceof Error
          ? err.message
          : "Erro ao salvar projeto.",
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="fixed inset-0 z-[90] flex items-center justify-center bg-black/70 p-4 backdrop-blur-sm">
      <div className="flex max-h-[92vh] w-full max-w-3xl flex-col overflow-hidden rounded-[28px] border border-white/[0.09] bg-[#080d16] shadow-2xl shadow-black/70">

        {/* HEADER */}

        <div className="flex items-center justify-between border-b border-white/[0.06] px-6 py-5">
          <div>
            <div className="text-[10px] font-bold uppercase tracking-[0.2em] text-sky-400">
              Control Tower
            </div>

            <h2 className="mt-1 text-xl font-semibold text-white">
              Editar projeto
            </h2>

            <p className="mt-1 text-sm text-slate-500">
              {projeto.nome}
            </p>
          </div>

          <button
            type="button"
            onClick={onClose}
            className="flex h-9 w-9 items-center justify-center rounded-xl border border-white/[0.08] bg-white/[0.03] text-slate-400 transition hover:bg-white/[0.07] hover:text-white"
          >
            <X size={17} />
          </button>
        </div>

        {/* CONTEÚDO */}

        <div className="overflow-y-auto px-6 py-6">
          <div className="grid grid-cols-1 gap-5 md:grid-cols-2">

            <Field label="Projeto">
              <input
                value={form.nome}
                onChange={(e) =>
                  atualizar(
                    "nome",
                    e.target.value,
                  )
                }
                className="input"
              />
            </Field>

            <Field label="Plataforma">
              <select
                value={form.plataforma}
                onChange={(e) =>
                  atualizar(
                    "plataforma",
                    e.target.value,
                  )
                }
                className="input"
              >
                <option value="">
                  Selecione
                </option>

                {PLATAFORMAS.map((item) => (
                  <option
                    key={item}
                    value={item}
                  >
                    {item}
                  </option>
                ))}
              </select>
            </Field>

            {/* ETAPA ATUAL */}

            <Field label="Etapa atual">
              <select
                value={form.etapa_id}
                onChange={(e) =>
                  alterarEtapa(
                    e.target.value,
                  )
                }
                className="input"
              >
                <option value="">
                  Selecione
                </option>

                {etapas.map((etapa) => (
                  <option
                    key={etapa.id}
                    value={etapa.id}
                  >
                    {etapa.nome}
                  </option>
                ))}
              </select>

              <div className="mt-1.5 text-[10px] text-slate-600">
                A etapa atual define onde o projeto
                aparece na Control Tower.
              </div>
            </Field>

            <Field label="Setor">
              <select
                value={form.setor}
                onChange={(e) =>
                  atualizar(
                    "setor",
                    e.target.value,
                  )
                }
                className="input"
              >
                <option value="">
                  Selecione
                </option>

                {SETORES.map((item) => (
                  <option
                    key={item}
                    value={item}
                  >
                    {item}
                  </option>
                ))}
              </select>
            </Field>

            <Field label="Responsável">
              <select
                value={form.responsavel_id}
                onChange={(e) => {
                  const id =
                    e.target.value;

                  const responsavel =
                    responsaveis.find(
                      (item) =>
                        item.id === id,
                    );

                  setForm((atual) => ({
                    ...atual,
                    responsavel_id: id,
                    responsavel_nome:
                      responsavel?.nome ??
                      "",
                  }));
                }}
                className="input"
              >
                <option value="">
                  Selecione
                </option>

                {responsaveis.map(
                  (item) => (
                    <option
                      key={item.id}
                      value={item.id}
                    >
                      {item.nome}
                    </option>
                  ),
                )}
              </select>
            </Field>

            <Field label="Status">
              <select
                value={form.status}
                onChange={(e) =>
                  atualizar(
                    "status",
                    e.target.value,
                  )
                }
                className="input"
              >
                {STATUS.map((item) => (
                  <option
                    key={item}
                    value={item}
                  >
                    {item}
                  </option>
                ))}
              </select>
            </Field>

            <Field label="Prioridade">
              <select
                value={form.prioridade}
                onChange={(e) =>
                  atualizar(
                    "prioridade",
                    e.target.value,
                  )
                }
                className="input"
              >
                {PRIORIDADES.map(
                  (item) => (
                    <option
                      key={item}
                      value={item}
                    >
                      {item}
                    </option>
                  ),
                )}
              </select>
            </Field>

            <Field label="Progresso">
              <div className="flex items-center gap-3">
                <input
                  type="range"
                  min="0"
                  max="100"
                  value={form.percentual}
                  onChange={(e) =>
                    atualizar(
                      "percentual",
                      Number(
                        e.target.value,
                      ),
                    )
                  }
                  className="w-full accent-sky-400"
                />

                <span className="w-12 text-right text-sm font-semibold text-white">
                  {form.percentual}%
                </span>
              </div>
            </Field>

            <Field label="Data inicial">
              <input
                type="date"
                value={form.data_inicio}
                onChange={(e) =>
                  atualizar(
                    "data_inicio",
                    e.target.value,
                  )
                }
                className="input"
              />
            </Field>

            <Field label="Data final">
              <input
                type="date"
                value={form.data_fim}
                onChange={(e) =>
                  atualizar(
                    "data_fim",
                    e.target.value,
                  )
                }
                className="input"
              />
            </Field>

            {/* FASE DE ORIGEM */}

            <Field label="Fase de origem">
              <input
                value={form.fase_origem}
                onChange={(e) =>
                  alterarFaseOrigem(
                    e.target.value,
                  )
                }
                className="input"
                placeholder="Ex.: Suporte"
              />

              <div className="mt-1.5 text-[10px] text-slate-600">
                Se o nome informado corresponder a uma
                etapa existente, a etapa atual também será
                atualizada automaticamente.
              </div>
            </Field>
          </div>

          <div className="mt-5">
            <Field label="Observações">
              <textarea
                rows={5}
                value={form.observacoes}
                onChange={(e) =>
                  atualizar(
                    "observacoes",
                    e.target.value,
                  )
                }
                className="input min-h-[120px] resize-y"
                placeholder="Observações, próximos passos, contexto..."
              />
            </Field>
          </div>

          {error && (
            <div className="mt-5 rounded-2xl border border-red-500/20 bg-red-500/[0.07] px-4 py-3 text-sm text-red-300">
              {error}
            </div>
          )}
        </div>

        {/* FOOTER */}

        <div className="flex items-center justify-end gap-2 border-t border-white/[0.06] px-6 py-4">
          <button
            type="button"
            disabled={saving}
            onClick={onClose}
            className="rounded-xl border border-white/[0.08] bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-slate-300 transition hover:bg-white/[0.06] hover:text-white"
          >
            Cancelar
          </button>

          <button
            type="button"
            disabled={saving}
            onClick={salvar}
            className="flex items-center gap-2 rounded-xl bg-sky-500 px-5 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-sky-400 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {saving ? (
              <Loader2
                size={16}
                className="animate-spin"
              />
            ) : (
              <Save size={16} />
            )}

            {saving
              ? "Salvando..."
              : "Salvar alterações"}
          </button>
        </div>
      </div>
    </div>
  );
}

/*
 * ============================================================
 * FIELD
 * ============================================================
 */

function Field({
  label,
  children,
}: {
  label: string;
  children: React.ReactNode;
}) {
  return (
    <div>
      <label className="mb-2 block text-[10px] font-bold uppercase tracking-[0.13em] text-slate-500">
        {label}
      </label>

      {children}
    </div>
  );
}
</file>

<file path="components/timeline/GanttBoard.tsx">
"use client";

import { useMemo, useState } from "react";
import {
  ChevronLeft,
  ChevronRight,
  Clock3,
  Pencil,
  User,
} from "lucide-react";

type Projeto = {
  id: string;
  cliente_id: string;
  nome: string;
  plataforma: string | null;
  etapa_id: string | null;
  setor: string | null;
  responsavel_id: string | null;
  responsavel_nome: string | null;
  status: string;
  prioridade: string;
  data_inicio: string | null;
  data_fim: string | null;
  observacoes: string | null;
  fase_origem: string | null;
  percentual: number;
  created_at: string;
  updated_at: string;

  cliente: {
    id: string;
    nome: string;
    cidade: string | null;
  } | null;

  etapa: {
    id: string;
    nome: string;
    ordem: number;
  } | null;
};

type GanttBoardProps = {
  projetos: Projeto[];
  onEdit: (projeto: Projeto) => void;
};

type TimelineMonth = {
  date: Date;
  year: number;
  month: number;
  label: string;
  daysInMonth: number;
};

const DAY_MS = 1000 * 60 * 60 * 24;

const STATUS_STYLES: Record<
  string,
  {
    bar: string;
    fill: string;
    text: string;
    dot: string;
  }
> = {
  "Em andamento": {
    bar: "border-sky-400/30 bg-sky-950/50",
    fill: "bg-sky-500/70",
    text: "text-sky-300",
    dot: "bg-sky-400",
  },

  Planejado: {
    bar: "border-violet-400/30 bg-violet-950/40",
    fill: "bg-violet-500/65",
    text: "text-violet-300",
    dot: "bg-violet-400",
  },

  "Não iniciado": {
    bar: "border-slate-400/20 bg-slate-900/50",
    fill: "bg-slate-500/60",
    text: "text-slate-300",
    dot: "bg-slate-400",
  },

  Pausado: {
    bar: "border-amber-400/30 bg-amber-950/40",
    fill: "bg-amber-500/65",
    text: "text-amber-300",
    dot: "bg-amber-400",
  },

  Bloqueado: {
    bar: "border-red-400/30 bg-red-950/40",
    fill: "bg-red-500/65",
    text: "text-red-300",
    dot: "bg-red-400",
  },

  Finalizado: {
    bar: "border-emerald-400/30 bg-emerald-950/40",
    fill: "bg-emerald-500/65",
    text: "text-emerald-300",
    dot: "bg-emerald-400",
  },

  Cancelado: {
    bar: "border-rose-400/30 bg-rose-950/40",
    fill: "bg-rose-500/60",
    text: "text-rose-300",
    dot: "bg-rose-400",
  },
};

function parseDate(value: string | null) {
  if (!value) return null;

  const [year, month, day] = value.split("-").map(Number);

  if (
    !Number.isFinite(year) ||
    !Number.isFinite(month) ||
    !Number.isFinite(day)
  ) {
    return null;
  }

  return new Date(year, month - 1, day);
}

function startOfDay(date: Date) {
  const result = new Date(date);
  result.setHours(0, 0, 0, 0);
  return result;
}

function formatShortDate(date: Date | null) {
  if (!date) return "Sem data";

  return date.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "2-digit",
  });
}

function formatLongDate(date: Date | null) {
  if (!date) return "Sem data";

  return date.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
}

function diffDays(start: Date, end: Date) {
  return Math.round(
    (startOfDay(end).getTime() - startOfDay(start).getTime()) / DAY_MS,
  );
}

function clamp(value: number, min: number, max: number) {
  return Math.min(Math.max(value, min), max);
}

function getStatusStyle(status: string) {
  return (
    STATUS_STYLES[status] ?? {
      bar: "border-slate-400/20 bg-slate-900/50",
      fill: "bg-slate-500/60",
      text: "text-slate-300",
      dot: "bg-slate-400",
    }
  );
}

export default function GanttBoard({
  projetos,
  onEdit,
}: GanttBoardProps) {
  const [currentDate, setCurrentDate] = useState(() => {
    const today = new Date();

    return new Date(
      today.getFullYear(),
      today.getMonth(),
      1,
    );
  });

  const today = useMemo(() => {
    return startOfDay(new Date());
  }, []);

  /*
   * Timeline:
   *
   * mês anterior
   * mês atual
   * próximo mês
   * mês seguinte
   *
   * Mantemos uma janela de 4 meses para permitir
   * visualização operacional sem deixar a tela excessivamente larga.
   */
  const months = useMemo<TimelineMonth[]>(() => {
    const list: TimelineMonth[] = [];

    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    for (let index = -1; index <= 2; index += 1) {
      const date = new Date(year, month + index, 1);

      list.push({
        date,
        year: date.getFullYear(),
        month: date.getMonth(),
        label: date
          .toLocaleDateString("pt-BR", {
            month: "short",
            year: "2-digit",
          })
          .replace(".", "")
          .toUpperCase(),
        daysInMonth: new Date(
          date.getFullYear(),
          date.getMonth() + 1,
          0,
        ).getDate(),
      });
    }

    return list;
  }, [currentDate]);

  const timelineStart = useMemo(() => {
    const first = months[0];

    return startOfDay(
      new Date(first.year, first.month, 1),
    );
  }, [months]);

  const timelineEnd = useMemo(() => {
    const last = months[months.length - 1];

    return startOfDay(
      new Date(
        last.year,
        last.month + 1,
        0,
      ),
    );
  }, [months]);

  const totalDays = useMemo(() => {
    return diffDays(timelineStart, timelineEnd) + 1;
  }, [timelineStart, timelineEnd]);

  const todayPosition = useMemo(() => {
    if (today < timelineStart || today > timelineEnd) {
      return null;
    }

    const daysFromStart = diffDays(
      timelineStart,
      today,
    );

    return ((daysFromStart + 0.5) / totalDays) * 100;
  }, [today, timelineStart, timelineEnd, totalDays]);

  function previousPeriod() {
    setCurrentDate(
      new Date(
        currentDate.getFullYear(),
        currentDate.getMonth() - 1,
        1,
      ),
    );
  }

  function nextPeriod() {
    setCurrentDate(
      new Date(
        currentDate.getFullYear(),
        currentDate.getMonth() + 1,
        1,
      ),
    );
  }

  function goToToday() {
    const now = new Date();

    setCurrentDate(
      new Date(
        now.getFullYear(),
        now.getMonth(),
        1,
      ),
    );
  }

  function calculateBarPosition(
    projeto: Projeto,
  ) {
    const inicio = parseDate(projeto.data_inicio);
    const fimOriginal = parseDate(projeto.data_fim);

    /*
     * Se não houver início nem fim,
     * não existe informação suficiente para posicionar
     * corretamente o projeto no Gantt.
     */
    if (!inicio && !fimOriginal) {
      return null;
    }

    /*
     * Se existir apenas uma data:
     * usamos a mesma data como início/fim.
     */
    const dataInicio = startOfDay(
      inicio ?? fimOriginal!,
    );

    const dataFim = startOfDay(
      fimOriginal ?? inicio!,
    );

    /*
     * Proteção contra registros inconsistentes:
     * caso fim < início, usamos início como fim.
     */
    const fimCorrigido =
      dataFim < dataInicio
        ? dataInicio
        : dataFim;

    /*
     * Projeto completamente fora da janela.
     */
    if (
      fimCorrigido < timelineStart ||
      dataInicio > timelineEnd
    ) {
      return null;
    }

    /*
     * Recortamos somente a parte visual da barra
     * que pertence à janela atualmente exibida.
     */
    const visualInicio =
      dataInicio < timelineStart
        ? timelineStart
        : dataInicio;

    const visualFim =
      fimCorrigido > timelineEnd
        ? timelineEnd
        : fimCorrigido;

    const startOffsetDays = diffDays(
      timelineStart,
      visualInicio,
    );

    const durationDays =
      diffDays(
        visualInicio,
        visualFim,
      ) + 1;

    const left =
      (startOffsetDays / totalDays) * 100;

    const width =
      (durationDays / totalDays) * 100;

    const percentual = clamp(
      Number(projeto.percentual) || 0,
      0,
      100,
    );

    const duracaoTotalDias =
      diffDays(dataInicio, fimCorrigido) + 1;

    return {
      left: `${left}%`,
      width: `${Math.max(width, 0.8)}%`,
      percentual,
      dataInicio,
      dataFim: fimCorrigido,
      duracaoTotalDias,
      cortadoInicio: dataInicio < timelineStart,
      cortadoFim: fimCorrigido > timelineEnd,
    };
  }

  function isAtrasado(projeto: Projeto) {
    const fim = parseDate(projeto.data_fim);

    if (!fim) return false;

    return (
      fim < today &&
      projeto.status !== "Finalizado" &&
      projeto.status !== "Cancelado"
    );
  }

  return (
    <div className="flex flex-col gap-4 rounded-3xl border border-white/[0.06] bg-[#080d16]/80 p-5 backdrop-blur-md">
      {/* HEADER */}
      <div className="flex flex-wrap items-center justify-between gap-4 border-b border-white/[0.06] pb-4">
        <div>
          <div className="flex items-center gap-2">
            <h3 className="text-lg font-semibold text-white">
              Gantt / Timeline Operational
            </h3>

            <span className="rounded-full border border-sky-400/20 bg-sky-400/[0.07] px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-sky-300">
              Operacional
            </span>
          </div>

          <p className="mt-1 text-xs text-slate-500">
            Cronograma real dos projetos por data de início,
            previsão de término e progresso.
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <button
            type="button"
            onClick={goToToday}
            className="rounded-xl border border-white/[0.07] bg-white/[0.025] px-3 py-2 text-[11px] font-semibold text-slate-300 transition hover:border-white/[0.14] hover:bg-white/[0.05] hover:text-white"
          >
            Hoje
          </button>

          <div className="flex items-center gap-1 rounded-xl border border-white/[0.07] bg-white/[0.025] p-1">
            <button
              type="button"
              onClick={previousPeriod}
              aria-label="Período anterior"
              className="rounded-lg p-2 text-slate-400 transition hover:bg-white/[0.06] hover:text-white"
            >
              <ChevronLeft size={16} />
            </button>

            <span className="min-w-[145px] px-2 text-center text-xs font-semibold uppercase tracking-wider text-slate-300">
              {currentDate.toLocaleDateString(
                "pt-BR",
                {
                  month: "long",
                  year: "numeric",
                },
              )}
            </span>

            <button
              type="button"
              onClick={nextPeriod}
              aria-label="Próximo período"
              className="rounded-lg p-2 text-slate-400 transition hover:bg-white/[0.06] hover:text-white"
            >
              <ChevronRight size={16} />
            </button>
          </div>
        </div>
      </div>

      {/* LEGENDA */}
      <div className="flex flex-wrap items-center gap-x-5 gap-y-2 text-[10px] text-slate-500">
        <div className="flex items-center gap-2">
          <span className="h-2 w-2 rounded-full bg-sky-400" />
          Em andamento
        </div>

        <div className="flex items-center gap-2">
          <span className="h-2 w-2 rounded-full bg-violet-400" />
          Planejado
        </div>

        <div className="flex items-center gap-2">
          <span className="h-2 w-2 rounded-full bg-amber-400" />
          Pausado
        </div>

        <div className="flex items-center gap-2">
          <span className="h-2 w-2 rounded-full bg-red-400" />
          Bloqueado
        </div>

        <div className="flex items-center gap-2">
          <span className="h-2 w-2 rounded-full bg-emerald-400" />
          Finalizado
        </div>

        <div className="ml-auto flex items-center gap-2">
          <span className="h-3 w-px bg-sky-300" />
          Hoje
        </div>
      </div>

      {/* TIMELINE */}
      <div className="overflow-x-auto">
        <div className="min-w-[1080px]">
          {/* CABEÇALHO */}
          <div className="grid grid-cols-[310px_1fr] border-b border-white/[0.06] pb-3">
            <div className="flex items-end text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">
              Projeto / Cliente
            </div>

            <div className="relative flex">
              {months.map((month) => (
                <div
                  key={`${month.year}-${month.month}`}
                  className="flex-1 border-l border-white/[0.06] pl-3 text-center text-[10px] font-bold uppercase tracking-wider text-slate-400"
                >
                  {month.label}
                </div>
              ))}
            </div>
          </div>

          {/* PROJETOS */}
          <div className="divide-y divide-white/[0.04]">
            {projetos.map((projeto) => {
              const pos =
                calculateBarPosition(projeto);

              const statusStyle =
                getStatusStyle(projeto.status);

              const atrasado =
                isAtrasado(projeto);

              const inicio =
                parseDate(projeto.data_inicio);

              const fim =
                parseDate(projeto.data_fim);

              return (
                <div
                  key={projeto.id}
                  className="group grid grid-cols-[310px_1fr] items-center py-3 transition hover:bg-white/[0.02]"
                >
                  {/* IDENTIFICAÇÃO */}
                  <div className="min-w-0 pr-5">
                    <div className="flex items-center gap-2">
                      <span
                        className={`h-1.5 w-1.5 shrink-0 rounded-full ${statusStyle.dot}`}
                      />

                      <span className="truncate text-xs font-semibold text-white">
                        {projeto.nome}
                      </span>

                      <button
                        type="button"
                        onClick={() =>
                          onEdit(projeto)
                        }
                        aria-label={`Editar ${projeto.nome}`}
                        className="ml-auto shrink-0 rounded-lg p-1.5 text-slate-600 opacity-0 transition group-hover:opacity-100 hover:bg-white/[0.06] hover:text-white"
                      >
                        <Pencil size={13} />
                      </button>
                    </div>

                    <div className="mt-1 flex min-w-0 items-center gap-2 text-[10px] text-slate-500">
                      <span className="max-w-[150px] truncate text-sky-400">
                        {projeto.cliente?.nome ||
                          "Sem cliente"}
                      </span>

                      <span>•</span>

                      <span className="flex min-w-0 items-center gap-1 truncate">
                        <User size={10} />

                        <span className="truncate">
                          {projeto.responsavel_nome ||
                            "Sem responsável"}
                        </span>
                      </span>
                    </div>

                    <div className="mt-2 flex flex-wrap items-center gap-2">
                      {projeto.etapa?.nome && (
                        <span className="max-w-[130px] truncate rounded-md border border-white/[0.06] bg-white/[0.025] px-2 py-0.5 text-[9px] text-slate-400">
                          {projeto.etapa.nome}
                        </span>
                      )}

                      <span
                        className={`rounded-md border border-white/[0.05] px-2 py-0.5 text-[9px] ${statusStyle.text}`}
                      >
                        {projeto.status}
                      </span>

                      {atrasado && (
                        <span className="rounded-md border border-red-400/20 bg-red-400/[0.06] px-2 py-0.5 text-[9px] font-semibold text-red-300">
                          Atrasado
                        </span>
                      )}
                    </div>
                  </div>

                  {/* ÁREA DA TIMELINE */}
                  <div className="relative h-[68px] rounded-xl bg-white/[0.012]">
                    {/* GRADE MENSAL */}
                    <div className="absolute inset-0 flex">
                      {months.map((month) => (
                        <div
                          key={`${month.year}-${month.month}-grid`}
                          className="relative flex-1 border-l border-white/[0.035]"
                        >
                          {/* Pequenas divisões internas */}
                          <div className="absolute inset-0 grid grid-cols-7 opacity-40">
                            {Array.from({
                              length: 6,
                            }).map(
                              (_, index) => (
                                <div
                                  key={index}
                                  className="border-r border-white/[0.018]"
                                />
                              ),
                            )}
                          </div>
                        </div>
                      ))}
                    </div>

                    {/* LINHA DE HOJE */}
                    {todayPosition !== null && (
                      <div
                        className="absolute bottom-0 top-0 z-10 w-px bg-sky-300/70"
                        style={{
                          left: `${todayPosition}%`,
                        }}
                      >
                        <div className="absolute left-1/2 top-0 -translate-x-1/2 whitespace-nowrap rounded-md border border-sky-300/20 bg-sky-300/10 px-1.5 py-0.5 text-[8px] font-bold uppercase tracking-wider text-sky-300">
                          Hoje
                        </div>
                      </div>
                    )}

                    {/* SEM DATA */}
                    {!pos && (
                      <div className="absolute inset-0 flex items-center px-4">
                        <span className="rounded-lg border border-dashed border-white/[0.07] bg-white/[0.015] px-3 py-1.5 text-[10px] italic text-slate-600">
                          Sem período definido
                        </span>
                      </div>
                    )}

                    {/* BARRA DO PROJETO */}
                    {pos && (
                      <div
                        className={`absolute top-[24px] h-7 overflow-hidden rounded-lg border shadow-sm transition-all duration-300 group-hover:brightness-110 ${statusStyle.bar}`}
                        style={{
                          left: pos.left,
                          width: pos.width,
                          minWidth: "18px",
                        }}
                        title={[
                          projeto.nome,
                          `Início: ${formatLongDate(
                            pos.dataInicio,
                          )}`,
                          `Fim: ${formatLongDate(
                            pos.dataFim,
                          )}`,
                          `Duração: ${pos.duracaoTotalDias} ${
                            pos.duracaoTotalDias === 1
                              ? "dia"
                              : "dias"
                          }`,
                          `Progresso: ${pos.percentual}%`,
                          atrasado
                            ? "Status: ATRASADO"
                            : `Status: ${projeto.status}`,
                        ].join(" • ")}
                      >
                        {/* PROGRESSO */}
                        <div
                          className={`absolute inset-y-0 left-0 ${statusStyle.fill} transition-all duration-500`}
                          style={{
                            width: `${pos.percentual}%`,
                          }}
                        />

                        {/* CONTEÚDO */}
                        <div className="relative z-10 flex h-full items-center justify-between gap-2 px-2.5">
                          <span className="truncate text-[9px] font-bold text-white">
                            {pos.cortadoInicio
                              ? "← "
                              : ""}
                            {pos.percentual}%
                            {pos.cortadoFim
                              ? " →"
                              : ""}
                          </span>

                          {pos.duracaoTotalDias <=
                            45 && (
                            <span className="hidden shrink-0 items-center gap-1 text-[8px] font-medium text-white/70 sm:flex">
                              <Clock3
                                size={9}
                              />

                              {pos.duracaoTotalDias}d
                            </span>
                          )}
                        </div>
                      </div>
                    )}

                    {/* MARCAÇÕES DE DATA */}
                    {pos && (
                      <>
                        <div
                          className="absolute bottom-1 text-[8px] text-slate-600"
                          style={{
                            left: pos.left,
                          }}
                        >
                          {formatShortDate(
                            pos.dataInicio,
                          )}
                        </div>

                        <div
                          className="absolute bottom-1 -translate-x-full text-[8px] text-slate-600"
                          style={{
                            left: `calc(${pos.left} + ${pos.width})`,
                          }}
                        >
                          {formatShortDate(
                            pos.dataFim,
                          )}
                        </div>
                      </>
                    )}

                    {/* DATA DE FIM FORA DA JANELA */}
                    {!pos &&
                      fim &&
                      fim < timelineStart && (
                        <span className="absolute right-3 top-1/2 -translate-y-1/2 text-[9px] text-slate-600">
