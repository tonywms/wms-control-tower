@import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap");
@import "tailwindcss";

/* ==========================================================================
   WMS EXPERT · CONTROL TOWER — "AURORA" PREMIUM THEME
   --------------------------------------------------------------------------
   100% visual. Nenhuma regra de negócio, API ou banco foi alterada.
   Funciona como camada de override sobre as classes Tailwind já existentes
   no JSX (estilos sem @layer vencem os utilitários do Tailwind v4).

   Direção: índigo-meia-noite profundo, vidro fosco, bordas em gradiente,
   luz ciano → azul → violeta → magenta. Um único elemento "memorável":
   o brilho aurora no fundo + bordas luminosas. O resto fica disciplinado.
   ========================================================================== */

/* ==========================================================================
   1. TOKENS
   ========================================================================== */

:root {
  color-scheme: dark;

  /* Base — índigo meia-noite */
  --ink-1000: #04061a;
  --ink-950: #060a1f;
  --ink-900: #0a1030;
  --ink-850: #0e1740;
  --ink-800: #131f50;
  --ink-700: #1b2a68;

