  color: #eef4fb;
}

/* =========================================================
   MODAIS
   ========================================================= */

[class~="bg-[#090e17]"] {
  border-color: rgba(148, 163, 184, 0.20) !important;
  box-shadow:
    0 28px 80px rgba(0, 0, 0, 0.38),
    0 0 0 1px rgba(56, 189, 248, 0.025);
}

/* =========================================================
   BOTÕES AZUIS
   ========================================================= */

button[class*="bg-sky-500"] {
  box-shadow: 0 8px 25px rgba(14, 165, 233, 0.17);
}

button[class*="bg-sky-500"]:hover {
