}: {
  projeto: Projeto;
}) {
  const isBlocked =
    projeto.status === "Bloqueado";

  return (
    <div className="px-4 py-4 sm:px-5">
      <div className="flex items-start gap-3">
        <div
          className={[
            "mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg",
            isBlocked
              ? "bg-red-400/[0.07]"
              : "bg-amber-400/[0.07]",
          ].join(" ")}
        >
          <AlertTriangle
            size={13}
            className={
              isBlocked
                ? "text-red-300"
                : "text-amber-300"
            }
          />
        </div>

        <div className="min-w-0 flex-1">
          <div className="flex items-center gap-2">
            <span className="truncate text-xs font-medium text-slate-300">
              {projeto.nome}
            </span>

            <span className="shrink-0 text-[8px] uppercase tracking-[0.12em] text-red-300/70">
              {projeto.prioridade}
            </span>
          </div>

          <div className="mt-1 text-[9px] leading-4 text-slate-600">
            {projeto.observacoes ||
              projeto.status}
          </div>

          <div className="mt-2 flex items-center gap-2 text-[8px] text-slate-700">
            <span>
              {projeto.responsavel_nome ||
                "Sem responsável"}
            </span>

            <span>•</span>

            <span>
              {projeto.etapa?.nome ??
                "Sem etapa"}
            </span>
          </div>
        </div>
      </div>
    </div>
  );
}

