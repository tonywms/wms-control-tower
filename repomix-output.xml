function AreasSlide({
  areas,
}: {
  areas: Array<{
    nome: string;
    total: number;
    criticos: number;
    atencao: number;
    atrasados: number;
    bloqueados: number;
  }>;
}) {
  return (
    <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {areas.map((area) => {
        const pressao =
          area.criticos * 10 +
          area.bloqueados * 8 +
          area.atrasados * 5 +
          area.atencao * 2;

        const tone: Tone =
          area.criticos > 0 || area.bloqueados > 0
            ? "red"
            : area.atrasados > 0 || area.atencao > 0
              ? "amber"
              : "emerald";

        return (
          <article
            key={area.nome}
            className="rounded-2xl border border-white/[0.06] bg-white/[0.025] p-5"
          >
            <div className="flex items-start justify-between">
              <div>
                <div className="text-[9px] font-semibold uppercase tracking-[0.14em] text-slate-600">
                  Área
                </div>

                <h3 className="mt-1 text-sm font-semibold text-white">
                  {area.nome}
                </h3>
              </div>

              <div
                className={`flex h-9 w-9 items-center justify-center rounded-xl border ${toneClasses[tone]}`}
              >
                <Layers3 size={15} />
              </div>
            </div>

            <div className="mt-6 text-3xl font-semibold tracking-[-0.04em] text-white">
              {area.total}
            </div>

            <div className="text-[9px] text-slate-600">
              projetos ativos
            </div>

            <div className="mt-5 grid grid-cols-2 gap-2">
              <MiniMetric
                label="Críticos"
                value={area.criticos}
                danger={area.criticos > 0}
              />

              <MiniMetric
                label="Atenção"
                value={area.atencao}
              />

              <MiniMetric
                label="Atrasados"
                value={area.atrasados}
                danger={area.atrasados > 0}
              />

              <MiniMetric
                label="Bloqueados"
                value={area.bloqueados}
                danger={area.bloqueados > 0}
              />
            </div>

            <div className="mt-4 flex items-center justify-between border-t border-white/[0.05] pt-3">
              <span className="text-[8px] uppercase tracking-[0.12em] text-slate-700">
                Pressão
              </span>

              <span
                className={[
                  "text-[10px] font-semibold",
                  pressao > 20
                    ? "text-red-300"
                    : pressao > 0
                      ? "text-amber-300"
                      : "text-emerald-300",
                ].join(" ")}
              >
                {pressao > 20
                  ? "Alta"
                  : pressao > 0
                    ? "Moderada"
                    : "Estável"}
              </span>
            </div>
          </article>
        );
      })}

      {areas.length === 0 && (
        <div className="md:col-span-2 xl:col-span-4">
          <EmptyState
            title="Sem projetos ativos"
            description="Não existem projetos ativos para compor o radar das áreas."
          />
        </div>
      )}
    </section>
  );
}

