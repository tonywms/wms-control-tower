 </div>
}

function Kpi({label,value,tone}:{label:string;value:number;tone:"sky"|"red"|"amber"|"violet"|"slate"}){const c=tone==="red"?"border-red-400/12 bg-red-400/[.04] text-red-300":tone==="amber"?"border-amber-400/12 bg-amber-400/[.04] text-amber-300":tone==="violet"?"border-violet-400/12 bg-violet-400/[.04] text-violet-300":tone==="sky"?"border-sky-400/12 bg-sky-400/[.04] text-sky-300":"border-white/[.06] bg-white/[.025] text-slate-300";return <div className={`rounded-2xl border p-4 ${c}`}><div className="text-2xl font-semibold">{value}</div><div className="mt-1 text-[8px] font-semibold uppercase tracking-[.12em] opacity-65">{label}</div></div>}
