/* ---- preenchimento das barras ---- */
:is([class~="bg-sky-400/50"], [class~="bg-sky-400/60"], [class~="bg-sky-400/70"], [class~="bg-sky-500/70"]) {
  background-image: linear-gradient(90deg, #22d3ee, #4f8bff);
  background-color: transparent;
  box-shadow: 0 0 18px rgba(34, 211, 238, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.35);
}

:is([class~="bg-violet-400/50"], [class~="bg-violet-500/65"]) {
  background-image: linear-gradient(90deg, #a78bfa, #d946ef);
  background-color: transparent;
  box-shadow: 0 0 18px rgba(167, 139, 250, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.35);
}

[class~="bg-amber-500/65"] {
  background-image: linear-gradient(90deg, #fbbf24, #f97316);
  background-color: transparent;
  box-shadow: 0 0 18px rgba(251, 191, 36, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.35);
}

[class~="bg-red-500/65"] {
  background-image: linear-gradient(90deg, #fb7185, #ef4444);
  background-color: transparent;
  box-shadow: 0 0 18px rgba(251, 113, 133, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.3);
}

[class~="bg-emerald-500/65"] {
  background-image: linear-gradient(90deg, #34d399, #10b981);
  background-color: transparent;
  box-shadow: 0 0 18px rgba(52, 211, 153, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.35);
}

[class~="bg-rose-500/60"] {
  background-image: linear-gradient(90deg, #fb7185, #e11d48);
  background-color: transparent;
  box-shadow: 0 0 18px rgba(244, 63, 94, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
}

[class~="bg-slate-500/60"] {
  background-image: linear-gradient(90deg, #64748b, #94a3b8);
  background-color: transparent;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

/* ---- barras do Gantt (container) ---- */
[class~="bg-sky-950/50"] { background-color: rgba(14, 70, 120, 0.40); }
[class~="bg-violet-950/40"] { background-color: rgba(76, 29, 149, 0.36); }
[class~="bg-slate-900/50"] { background-color: rgba(30, 41, 90, 0.50); }
[class~="bg-amber-950/40"] { background-color: rgba(120, 53, 15, 0.38); }
[class~="bg-red-950/40"] { background-color: rgba(127, 29, 29, 0.38); }
[class~="bg-emerald-950/40"] { background-color: rgba(6, 78, 59, 0.38); }
[class~="bg-rose-950/40"] { background-color: rgba(136, 19, 55, 0.38); }

/* ==========================================================================
   10. BOTÕES
   ========================================================================== */

/* primário */
button[class~="bg-sky-500"] {
  position: relative;
  color: #04102e;
  font-weight: 700;
  letter-spacing: 0.005em;
  border: 1px solid rgba(255, 255, 255, 0.55);
  background: linear-gradient(110deg, #67e8f9 0%, #38bdf8 35%, #818cf8 70%, #c4b5fd 100%);
  background-size: 200% 100%;
  box-shadow:
    0 14px 34px -10px rgba(56, 189, 248, 0.65),
    0 0 0 1px rgba(34, 211, 238, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.65);
  transition:
    background-position 600ms var(--ease),
    box-shadow 300ms var(--ease),
    transform 300ms var(--ease),
    filter 300ms var(--ease);
}

button[class~="bg-sky-500"]:hover:not(:disabled) {
  background-position: 100% 0;
  transform: translateY(-2px);
  filter: saturate(1.15);
  box-shadow:
    0 20px 44px -10px rgba(99, 102, 241, 0.75),
    0 0 0 1px rgba(165, 180, 255, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.7);
}

button[class~="bg-sky-500"]:active:not(:disabled) {
  transform: translateY(0) scale(0.98);
}

button[class~="bg-sky-500"]:disabled {
  filter: grayscale(0.4);
  box-shadow: none;
}

/* secundários / ghost (botões com borda e fundo translúcido) */
button[class~="border"][class~="bg-white/[0.025]"],
button[class~="border"][class~="bg-white/[0.03]"],
button[class~="border"][class~="bg-white/[0.04]"] {
  transition: transform 250ms var(--ease), box-shadow 250ms var(--ease), color 200ms ease;
}

button[class~="border"][class~="bg-white/[0.025]"]:hover,
button[class~="border"][class~="bg-white/[0.03]"]:hover,
button[class~="border"][class~="bg-white/[0.04]"]:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-lift);
}

/* hovers genéricos de linhas e ícones */
[class*="hover:bg-white/"]:hover {
  background-color: rgba(129, 140, 248, 0.16);
}

[class*="hover:bg-red-400/"]:hover {
  background-color: rgba(251, 113, 133, 0.16);
}

/* spinners */
.animate-spin {
  filter: drop-shadow(0 0 6px rgba(34, 211, 238, 0.7));
}

/* ==========================================================================
   11. INPUTS
   (em @layer components para que utilitários como pr-11, min-h-[120px]
    e resize-y continuem funcionando por cima)
   ========================================================================== */

@layer components {
  .input {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 0.95rem;
    border-radius: 14px;
    border: 1px solid rgba(142, 160, 255, 0.24);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03));
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.4;
    outline: none;
    box-shadow: inset 0 1px 2px rgba(2, 4, 24, 0.35);
    transition:
      border-color 200ms ease,
      background 200ms ease,
      box-shadow 250ms var(--ease);
  }

  .input:hover {
    border-color: rgba(165, 180, 255, 0.40);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.04));
  }

  .input:focus,
  .input:focus-visible {
    outline: none;
    border-color: rgba(34, 211, 238, 0.75);
    background: linear-gradient(180deg, rgba(34, 211, 238, 0.08), rgba(99, 102, 241, 0.06));
    box-shadow:
      0 0 0 4px rgba(34, 211, 238, 0.14),
      0 12px 30px -12px rgba(34, 211, 238, 0.5);
  }

  .input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  select.input {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 2.5rem;
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%2393c5fd' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='m6 9 6 6 6-6'/></svg>"),
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03));
    background-repeat: no-repeat, no-repeat;
    background-position: right 0.85rem center, 0 0;
  }

  .input option {
    background: #0f1744;
    color: #f3f6ff;
  }

  textarea.input {
    line-height: 1.6;
  }
}

input[type="date"].input,
input[type="datetime-local"].input {
  color-scheme: dark;
}

/* ==========================================================================
   12. MODAIS E OVERLAYS
   ========================================================================== */

div.fixed.inset-0:not(.pointer-events-none) {
  background:
    radial-gradient(ellipse 60% 50% at 50% 30%, rgba(79, 70, 229, 0.22), transparent 70%),
    rgba(3, 5, 24, 0.74);
  backdrop-filter: blur(14px) saturate(130%);
  -webkit-backdrop-filter: blur(14px) saturate(130%);
  animation: overlay-in 220ms ease both;
}

/* o próprio modal é o filho direto do overlay */
div.fixed.inset-0:not(.pointer-events-none) > div {
  background:
    radial-gradient(ellipse 80% 40% at 50% 0%, rgba(99, 102, 241, 0.20), transparent 70%),
    linear-gradient(170deg, rgba(22, 32, 90, 0.97) 0%, rgba(8, 12, 40, 0.98) 100%) padding-box,
    var(--glass-edge-hot) border-box;
  background-origin: border-box;
  border-color: transparent;
  box-shadow:
    0 50px 120px -20px rgba(2, 4, 24, 0.95),
    0 0 90px -20px rgba(79, 139, 255, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.10);
  animation: modal-in 380ms var(--ease) both;
}

/* cabeçalhos / rodapés dos modais */
div.fixed.inset-0:not(.pointer-events-none) > div [class~="border-b"] {
  border-color: rgba(142, 160, 255, 0.18);
}

div.fixed.inset-0:not(.pointer-events-none) > div [class~="border-t"] {
  border-color: rgba(142, 160, 255, 0.18);
  background: rgba(3, 5, 24, 0.35);
}

/* rótulos de formulário */
label {
  color: var(--text-soft);
}

/* ==========================================================================
   13. KANBAN
   ========================================================================== */

/* colunas */
div[class*="min-h-[520px]"] {
  position: relative;
  border-radius: 22px;
}

/* faixa de cor do status no topo da coluna */
div[class*="min-h-[520px]"]::before {
  content: "";
  position: absolute;
  top: 0;
  left: 18px;
  right: 18px;
  height: 3px;
  border-radius: 0 0 6px 6px;
  pointer-events: none;
  background: var(--col-accent, rgba(148, 163, 184, 0.7));
  box-shadow: 0 0 22px 2px var(--col-glow, rgba(148, 163, 184, 0.4));
  z-index: 1;
}

.border-slate-500\/20.bg-slate-500\/5 {
  --col-accent: linear-gradient(90deg, #64748b, #cbd5e1);
  --col-glow: rgba(148, 163, 184, 0.45);
  background: linear-gradient(180deg, rgba(100, 116, 139, 0.18), rgba(30, 41, 90, 0.20));
  border-color: rgba(148, 163, 184, 0.30);
}

.border-violet-500\/20.bg-violet-500\/5 {
  --col-accent: linear-gradient(90deg, #8b5cf6, #d946ef);
  --col-glow: rgba(139, 92, 246, 0.6);
  background: linear-gradient(180deg, rgba(139, 92, 246, 0.22), rgba(40, 20, 100, 0.22));
  border-color: rgba(167, 139, 250, 0.38);
}

.border-sky-500\/20.bg-sky-500\/5 {
  --col-accent: linear-gradient(90deg, #22d3ee, #4f8bff);
  --col-glow: rgba(34, 211, 238, 0.6);
  background: linear-gradient(180deg, rgba(14, 165, 233, 0.22), rgba(14, 40, 100, 0.22));
  border-color: rgba(56, 189, 248, 0.42);
}

.border-amber-500\/20.bg-amber-500\/5 {
  --col-accent: linear-gradient(90deg, #fbbf24, #f97316);
  --col-glow: rgba(251, 191, 36, 0.55);
  background: linear-gradient(180deg, rgba(245, 158, 11, 0.22), rgba(90, 40, 10, 0.20));
  border-color: rgba(251, 191, 36, 0.42);
}

.border-red-500\/20.bg-red-500\/5 {
  --col-accent: linear-gradient(90deg, #fb7185, #ef4444);
  --col-glow: rgba(251, 113, 133, 0.6);
  background: linear-gradient(180deg, rgba(239, 68, 68, 0.22), rgba(100, 20, 40, 0.20));
  border-color: rgba(251, 113, 133, 0.42);
}

.border-emerald-500\/20.bg-emerald-500\/5 {
  --col-accent: linear-gradient(90deg, #34d399, #10b981);
  --col-glow: rgba(52, 211, 153, 0.55);
  background: linear-gradient(180deg, rgba(16, 185, 129, 0.22), rgba(6, 60, 50, 0.20));
  border-color: rgba(52, 211, 153, 0.42);
}

.border-rose-500\/20.bg-rose-500\/5 {
  --col-accent: linear-gradient(90deg, #fb7185, #be123c);
  --col-glow: rgba(244, 63, 94, 0.55);
  background: linear-gradient(180deg, rgba(244, 63, 94, 0.20), rgba(90, 15, 40, 0.20));
  border-color: rgba(251, 113, 133, 0.40);
}

/* coluna que está recebendo o drop */
div[class*="min-h-[520px]"][class~="border-blue-400/50"] {
  --col-accent: linear-gradient(90deg, #22d3ee, #8b5cf6, #d946ef);
  --col-glow: rgba(79, 139, 255, 0.8);
  background: linear-gradient(180deg, rgba(79, 139, 255, 0.20), rgba(34, 211, 238, 0.07));
  border-color: rgba(34, 211, 238, 0.7);
  animation: drop-glow 1.4s ease-in-out infinite;
}

/* cards do Kanban */
[draggable="true"] {
  position: relative;
  cursor: grab;
  background:
    linear-gradient(150deg, rgba(48, 64, 142, 0.88), rgba(20, 28, 80, 0.90)) padding-box,
    linear-gradient(145deg, rgba(125, 211, 252, 0.50), rgba(129, 140, 248, 0.16) 45%, rgba(217, 70, 239, 0.28)) border-box;
  background-origin: border-box;
  border-color: transparent;
  box-shadow:
    0 14px 30px -14px rgba(2, 4, 24, 0.9),
    inset 0 1px 0 rgba(255, 255, 255, 0.10);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  transition: box-shadow 280ms var(--ease);
}

[draggable="true"]:hover {
  /* sem transform aqui: mover o card sob o cursor pode atrapalhar o início do drag nativo */
  box-shadow:
    0 28px 50px -16px rgba(2, 4, 24, 0.95),
    0 0 0 1px rgba(34, 211, 238, 0.35),
    0 0 36px -8px rgba(79, 139, 255, 0.6),
    inset 0 1px 0 rgba(255, 255, 255, 0.14);
}

[draggable="true"]:active {
  cursor: grabbing;
}

/* chips internos do card */
[draggable="true"] [class~="bg-white/[0.03]"],
[draggable="true"] [class~="bg-white/[0.05]"] {
  background: rgba(8, 12, 44, 0.55);
  border-color: rgba(142, 160, 255, 0.24);
  box-shadow: none;
  backdrop-filter: none;
}

/* avatar do responsável */
[draggable="true"] [class~="rounded-full"][class~="bg-white/[0.05]"] {
  background: var(--brand);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.35);
  box-shadow: 0 4px 14px -2px rgba(79, 139, 255, 0.6);
}

/* ==========================================================================
   14. GANTT / TIMELINE
   ========================================================================== */

[class*="min-w-[1080px]"] [class~="group"]:hover {
  background: linear-gradient(90deg, rgba(34, 211, 238, 0.07), rgba(139, 92, 246, 0.06), transparent);
}

[class*="min-w-[1080px]"] [class~="h-[68px]"] {
  background-color: rgba(120, 135, 255, 0.05);
  box-shadow: inset 0 0 0 1px rgba(142, 160, 255, 0.08);
}

/* "hoje" — linha de destaque (qualquer elemento vertical colorido do Gantt) */
[class*="min-w-[1080px]"] [class~="w-px"][class~="bg-sky-400"],
[class*="min-w-[1080px]"] [class~="w-0.5"][class~="bg-sky-400"] {
  background: linear-gradient(180deg, #22d3ee, #d946ef);
  box-shadow: 0 0 18px 2px rgba(34, 211, 238, 0.7);
}

/* ==========================================================================
   15. TABELAS (configurações)
   ========================================================================== */

table {
  border-collapse: separate;
  border-spacing: 0;
}

thead tr {
  background: linear-gradient(90deg, rgba(34, 211, 238, 0.06), rgba(139, 92, 246, 0.07));
}

tbody tr {
  transition: background 220ms ease;
}

tbody tr:hover {
  background: linear-gradient(90deg, rgba(34, 211, 238, 0.08), rgba(139, 92, 246, 0.07) 60%, transparent);
}

/* ==========================================================================
   16. LOGIN
   ========================================================================== */

main[class*="bg-[#05080d]"] section.relative [class~="h-14"][class~="w-14"] {
  background: var(--brand);
  border-color: rgba(255, 255, 255, 0.4);
  box-shadow:
    0 20px 50px -10px rgba(79, 139, 255, 0.75),
    0 0 0 8px rgba(79, 139, 255, 0.10),
    inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

main[class*="bg-[#05080d]"] section.relative [class~="h-14"][class~="w-14"] svg {
  color: #fff;
}

main[class*="bg-[#05080d]"] section.relative [class~="rounded-3xl"][class~="backdrop-blur-xl"] {
  background:
    radial-gradient(ellipse 80% 40% at 50% 0%, rgba(99, 102, 241, 0.22), transparent 70%),
    linear-gradient(170deg, rgba(26, 38, 104, 0.82), rgba(8, 12, 40, 0.88)) padding-box,
    var(--glass-edge-hot) border-box;
  background-origin: border-box;
  box-shadow:
    0 50px 120px -30px rgba(2, 4, 24, 0.95),
    0 0 100px -30px rgba(79, 139, 255, 0.5),
    inset 0 1px 0 rgba(255, 255, 255, 0.12);
  animation: rise 800ms var(--ease) both;
}

/* ==========================================================================
   17. RESPONSIVO
   ========================================================================== */

@media (max-width: 1023px) {
  aside[class*="bg-[#070a10]"] {
    box-shadow:
      inset -1px 0 0 rgba(142, 160, 255, 0.2),
      30px 0 80px rgba(2, 4, 24, 0.7);
  }

  aside nav button:hover {
    transform: none;
  }
}

@media (max-width: 640px) {
  section.min-w-0 > header {
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  [draggable="true"]:hover {
    transform: none;
  }
}

/* ==========================================================================
   18. ACESSIBILIDADE — movimento reduzido
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
