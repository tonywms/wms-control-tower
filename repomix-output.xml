                                  }}
                                />
                              </div>
                            </div>

                            {index <
                              operationalFlow.length -
                                1 && (
                              <ArrowRight
                                size={11}
                                className="absolute -right-2 top-1/2 hidden -translate-y-1/2 text-slate-800 xl:block"
                              />
                            )}
                          </div>
                        );
                      },
                    )}
                  </div>
                </section>

                {/* =====================================================
                    EXISTENTE — KPI GRID
                   ===================================================== */}

                <div className="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
                  <KpiCard
                    label="Carteira total"
                    value={
                      loading
                        ? "—"
                        : String(
                            resumo?.total ?? 0,
                          )
                    }
                    helper="Projetos ativos na base"
                    icon={Layers3}
                    accent="sky"
                  />

                  <KpiCard
                    label="Go-Lives"
                    value={
                      loading
                        ? "—"
                        : String(
                            resumo?.goLives ?? 0,
                          )
                    }
                    helper="Na janela operacional"
                    icon={Zap}
                    accent="emerald"
                  />

                  <KpiCard
                    label="Integrações"
                    value={
                      loading
                        ? "—"
                        : String(
                            resumo?.integracoes ?? 0,
                          )
                    }
                    helper="Demandas de integração"
                    icon={Database}
                    accent="violet"
                  />

                  <KpiCard
                    label="Bloqueados"
                    value={
                      loading
                        ? "—"
                        : String(
                            resumo?.bloqueados ?? 0,
                          )
                    }
                    helper="Exigem intervenção"
                    icon={AlertTriangle}
                    accent="red"
                  />
                </div>

                {/* =====================================================
                    EXISTENTE — FLOW
                   ===================================================== */}

                <section className="mt-5 rounded-2xl border border-white/[0.06] bg-white/[0.025] p-4 sm:p-5">
                  <div className="flex items-center justify-between">
                    <div>
                      <div className="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                        Operational flow
                      </div>

                      <div className="mt-1 text-xs text-slate-600">
                        Distribuição atual por etapa
                      </div>
                    </div>

                    <div className="flex items-center gap-1.5 text-[10px] text-slate-600">
                      <CircleDot
                        size={12}
                        className="text-sky-400"
                      />
                      Base real
                    </div>
                  </div>

                  <div className="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 xl:grid-cols-8">
                    {operationalFlow.map(
                      (item) => (
                        <div
                          key={item.stage}
                          className="min-w-0"
                        >
                          <div className="flex items-end justify-between gap-2">
                            <span className="truncate text-[9px] text-slate-600">
                              {item.stage}
                            </span>

                            <span className="text-[11px] font-semibold text-slate-300">
                              {item.total}
                            </span>
                          </div>

                          <div className="mt-2 h-1.5 overflow-hidden rounded-full bg-white/[0.04]">
                            <div
                              className="h-full rounded-full bg-sky-400/60 transition-all"
                              style={{
                                width: `${Math.max(
                                  item.total === 0
                                    ? 0
                                    : (item.total /
                                        maxFlow) *
                                        100,
                                  item.total === 0
                                    ? 0
                                    : 7,
                                )}%`,
                              }}
                            />
                          </div>
                        </div>
                      ),
                    )}
                  </div>
                </section>

                {/* =====================================================
                    EXISTENTE — MAIN GRID
                   ===================================================== */}

                <div className="mt-5 grid gap-5 xl:grid-cols-[1.35fr_0.65fr]">
                  {/* LIVE OPERATIONS */}

                  <section className="min-w-0 rounded-2xl border border-white/[0.06] bg-white/[0.025]">
                    <div className="flex items-center justify-between border-b border-white/[0.05] px-4 py-4 sm:px-5">
                      <div>
                        <div className="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                          Live operations
                        </div>

                        <div className="mt-1 text-xs text-slate-600">
                          Projetos em execução
                        </div>
                      </div>

                      <button
                        type="button"
                        onClick={openCarteiraCompleta}
                        className="text-[10px] font-medium text-sky-400 hover:text-sky-300"
                      >
                        Ver carteira
                      </button>
                    </div>

                    <div className="divide-y divide-white/[0.04]">
                      {liveOperations.length ===
                      0 ? (
                        <EmptyState text="Nenhum projeto em andamento." />
                      ) : (
                        liveOperations.map(
                          (projeto) => (
                            <ProjectRow
                              key={projeto.id}
                              projeto={projeto}
                              onOpen360={
                                openProjeto360
                              }
                              onEdit={
                                openEditProjeto
                              }
                              onUpdated={
                                loadProjetos
                              }
                            />
                          ),
                        )
                      )}
                    </div>
                  </section>

                  {/* ALERTS */}

                  <section className="rounded-2xl border border-white/[0.06] bg-white/[0.025]">
                    <div className="flex items-center justify-between border-b border-white/[0.05] px-4 py-4 sm:px-5">
                      <div>
                        <div className="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                          Critical alerts
                        </div>

                        <div className="mt-1 text-xs text-slate-600">
                          Pontos que exigem atenção
                        </div>
                      </div>

                      <span className="flex h-6 min-w-6 items-center justify-center rounded-full bg-red-400/[0.08] px-2 text-[10px] font-semibold text-red-300">
                        {criticalAlerts.length}
                      </span>
                    </div>

                    <div className="divide-y divide-white/[0.04]">
                      {criticalAlerts.length ===
                      0 ? (
                        <EmptyState text="Nenhum alerta crítico." />
                      ) : (
                        criticalAlerts.map(
                          (projeto) => (
                            <AlertRow
                              key={projeto.id}
                              projeto={projeto}
                            />
                          ),
                        )
                      )}
                    </div>
                  </section>
                </div>

                {/* =====================================================
                    FASE 10 — SETORES + THROUGHPUT
                   ===================================================== */}

                <div className="mt-5 grid gap-5 lg:grid-cols-2">
                  {/* SETORES */}

                  <section className="rounded-2xl border border-white/[0.06] bg-white/[0.025]">
                    <div className="flex items-center justify-between border-b border-white/[0.05] px-4 py-4 sm:px-5">
                      <div>
                        <div className="flex items-center gap-2">
                          <Layers3
                            size={14}
                            className="text-violet-300"
                          />

                          <div className="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                            Carteira por setor
                          </div>
                        </div>

                        <div className="mt-1 text-xs text-slate-600">
                          Onde a demanda está concentrada
                        </div>
                      </div>
                    </div>

                    <div className="p-4 sm:p-5">
                      {executiveMetrics.setores.map(
                        (setor) => {
                          const percentage =
                            projetos.length > 0
                              ? Math.round(
                                  (setor.total /
                                    projetos.length) *
                                    100,
                                )
                              : 0;

                          return (
                            <div
                              key={setor.nome}
                              className="mb-4 last:mb-0"
                            >
                              <div className="flex items-center justify-between">
                                <span className="truncate text-[10px] text-slate-500">
                                  {setor.nome}
                                </span>

                                <div className="flex items-center gap-2">
                                  <span className="text-xs font-semibold text-slate-300">
                                    {setor.total}
                                  </span>

                                  <span className="text-[8px] text-slate-700">
                                    {percentage}%
                                  </span>
                                </div>
                              </div>

                              <div className="mt-2 h-1 overflow-hidden rounded-full bg-white/[0.04]">
                                <div
                                  className="h-full rounded-full bg-violet-400/50"
                                  style={{
                                    width: `${percentage}%`,
                                  }}
                                />
                              </div>
                            </div>
                          );
                        },
                      )}

                      {executiveMetrics.setores
                        .length === 0 && (
                        <EmptyState text="Nenhum setor encontrado." />
                      )}
                    </div>
                  </section>

                  {/* THROUGHPUT */}

                  <section className="rounded-2xl border border-white/[0.06] bg-white/[0.025]">
                    <div className="flex items-center justify-between border-b border-white/[0.05] px-4 py-4 sm:px-5">
                      <div>
                        <div className="flex items-center gap-2">
                          <TrendingUp
                            size={14}
                            className="text-emerald-300"
                          />

                          <div className="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                            Throughput
                          </div>
                        </div>

                        <div className="mt-1 text-xs text-slate-600">
                          Entregas identificadas pela base atual
                        </div>
                      </div>
                    </div>

                    <div className="grid grid-cols-2 gap-3 p-4 sm:p-5">
                      <div className="rounded-xl border border-white/[0.05] bg-black/10 p-4">
                        <div className="flex items-center justify-between">
                          <div className="text-[9px] uppercase tracking-[0.12em] text-slate-600">
                            Últimos 7 dias
                          </div>

                          <ArrowUpRight
                            size={13}
                            className="text-emerald-300"
                          />
                        </div>

                        <div className="mt-4 text-3xl font-semibold tracking-[-0.05em] text-white">
                          {
                            executiveMetrics.finalizados7Dias
                          }
                        </div>

                        <div className="mt-1 text-[9px] text-slate-700">
                          finalizados
                        </div>
                      </div>

                      <div className="rounded-xl border border-white/[0.05] bg-black/10 p-4">
                        <div className="flex items-center justify-between">
                          <div className="text-[9px] uppercase tracking-[0.12em] text-slate-600">
                            Últimos 30 dias
                          </div>

                          <ArrowUpRight
                            size={13}
                            className="text-sky-300"
                          />
                        </div>

                        <div className="mt-4 text-3xl font-semibold tracking-[-0.05em] text-white">
                          {
                            executiveMetrics.finalizados30Dias
                          }
                        </div>

                        <div className="mt-1 text-[9px] text-slate-700">
                          finalizados
                        </div>
                      </div>
                    </div>

                    <div className="mx-4 mb-4 rounded-xl border border-white/[0.05] bg-black/10 p-3 sm:mx-5 sm:mb-5">
                      <div className="flex items-center gap-2">
                        <CircleDot
                          size={12}
                          className="text-emerald-300"
                        />

                        <span className="text-[9px] text-slate-500">
                          Indicador calculado com base em
                          projetos Finalizados e updated_at.
                        </span>
                      </div>
                    </div>
                  </section>
                </div>

                {/* =====================================================
                    EXISTENTE — BOTTOM GRID
                   ===================================================== */}

                <div className="mt-5 grid gap-5 lg:grid-cols-2">
                  {/* CAPACITY */}

                  <section className="rounded-2xl border border-white/[0.06] bg-white/[0.025]">
                    <div className="flex items-center justify-between border-b border-white/[0.05] px-4 py-4 sm:px-5">
                      <div>
                        <div className="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                          Capacity & agenda
                        </div>

                        <div className="mt-1 text-xs text-slate-600">
                          Distribuição por responsável
                        </div>
                      </div>

                      <Users
                        size={15}
                        className="text-slate-600"
                      />
                    </div>

                    <div className="p-4 sm:p-5">
                      {capacity.map(
                        (person) => {
                          const percentage =
                            Math.min(
                              person.total * 20,
                              100,
                            );

                          return (
                            <div
                              key={person.nome}
                              className="mb-4 last:mb-0"
                            >
                              <div className="flex items-center justify-between">
                                <div className="flex items-center gap-2.5">
                                  <div className="flex h-7 w-7 items-center justify-center rounded-lg border border-white/[0.06] bg-white/[0.035] text-[9px] font-semibold text-slate-400">
                                    {getInitials(
                                      person.nome,
                                    )}
                                  </div>

                                  <div>
                                    <div className="text-[11px] font-medium text-slate-300">
                                      {person.nome}
                                    </div>

                                    <div className="text-[9px] text-slate-600">
                                      {person.total}{" "}
                                      projetos ·{" "}
                                      {
                                        person.andamento
                                      }{" "}
                                      em andamento
                                    </div>
                                  </div>
                                </div>

                                {person.bloqueados >
                                  0 && (
                                  <span className="text-[9px] text-red-300">
                                    {
                                      person.bloqueados
                                    }{" "}
                                    bloqueado
                                    {person.bloqueados >
                                    1
                                      ? "s"
                                      : ""}
                                  </span>
                                )}
                              </div>

                              <div className="mt-2 h-1 overflow-hidden rounded-full bg-white/[0.04]">
                                <div
                                  className="h-full rounded-full bg-sky-400/50"
                                  style={{
                                    width: `${percentage}%`,
                                  }}
                                />
                              </div>
                            </div>
                          );
                        },
                      )}

                      {capacity.length ===
                        0 && (
                        <EmptyState text="Nenhum responsável encontrado." />
                      )}
                    </div>
                  </section>

                  {/* UPCOMING */}

                  <section className="rounded-2xl border border-white/[0.06] bg-white/[0.025]">
                    <div className="flex items-center justify-between border-b border-white/[0.05] px-4 py-4 sm:px-5">
                      <div>
                        <div className="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                          Próximos Go-Lives
                        </div>

                        <div className="mt-1 text-xs text-slate-600">
                          Agenda operacional
                        </div>
                      </div>

                      <CalendarDays
                        size={15}
                        className="text-slate-600"
                      />
                    </div>

                    <div className="divide-y divide-white/[0.04]">
                      {goLives.length === 0 ? (
                        <EmptyState text="Nenhum Go-Live programado." />
                      ) : (
                        goLives.map(
                          (projeto) => (
                            <div
                              key={projeto.id}
                              className="flex items-center gap-3 px-4 py-3.5 sm:px-5"
                            >
                              <div className="flex h-9 w-9 shrink-0 flex-col items-center justify-center rounded-lg border border-white/[0.06] bg-white/[0.025]">
                                <span className="text-[8px] uppercase text-slate-600">
                                  {projeto.data_inicio
                                    ? projeto.data_inicio.slice(
                                        5,
                                        7,
                                      )
                                    : "--"}
                                </span>

                                <span className="text-[11px] font-semibold text-slate-300">
                                  {projeto.data_inicio
                                    ? projeto.data_inicio.slice(
                                        8,
                                        10,
                                      )
                                    : "--"}
                                </span>
                              </div>

                              <div className="min-w-0 flex-1">
                                <div className="flex items-center gap-2">
                                  <span className="truncate text-xs font-medium text-slate-300">
                                    {
                                      projeto.nome
                                    }
                                  </span>

                                  <span className="shrink-0 rounded-full bg-white/[0.04] px-1.5 py-0.5 text-[8px] text-slate-600">
                                    {
                                      projeto.status
                                    }
                                  </span>
                                </div>

                                <div className="mt-1 flex items-center gap-2 text-[9px] text-slate-600">
                                  <span>
                                    {projeto.responsavel_nome ||
                                      "Sem responsável"}
                                  </span>

                                  <span>•</span>

                                  <span>
                                    {projeto.data_fim
                                      ? formatDate(
                                          projeto.data_fim,
                                        )
                                      : "Sem fim"}
                                  </span>
                                </div>
                              </div>

                              <span className="hidden shrink-0 text-[9px] text-slate-600 sm:block">
                                {relativeDate(
                                  projeto.data_inicio,
                                )}
                              </span>
                            </div>
                          ),
                        )
                      )}
                    </div>
                  </section>
                </div>

                {carteiraCompletaOpen && (
                  <section
                    id="carteira-completa"
                    className="mt-5 scroll-mt-6 overflow-hidden rounded-2xl border border-white/[0.06] bg-white/[0.025]"
                  >
                    <div className="flex flex-col gap-3 border-b border-white/[0.05] px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
                      <div>
                        <div className="flex items-center gap-2">
                          <Layers3
                            size={14}
                            className="text-sky-300"
                          />

                          <div className="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                            Carteira completa
                          </div>
                        </div>

                        <div className="mt-1 text-xs text-slate-600">
                          {projetosFiltrados.length} projeto
                          {projetosFiltrados.length === 1 ? "" : "s"} na visão atual
                        </div>
                      </div>

                      <div className="flex items-center gap-2">
                        <div className="relative">
                          <Search
                            size={14}
                            className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-600"
                          />

                          <input
                            value={search}
                            onChange={(event) =>
                              setSearch(event.target.value)
                            }
                            placeholder="Filtrar carteira..."
                            className="h-9 w-full min-w-[220px] rounded-xl border border-white/[0.06] bg-black/20 pl-9 pr-3 text-xs text-slate-200 outline-none transition placeholder:text-slate-700 focus:border-sky-400/20 focus:bg-white/[0.04] sm:w-[260px]"
                          />
                        </div>

                        <button
                          type="button"
                          onClick={() => {
                            setCarteiraCompletaOpen(false);
                            setSearch("");
                          }}
                          className="flex h-9 w-9 items-center justify-center rounded-xl border border-white/[0.06] bg-white/[0.025] text-slate-600 transition hover:bg-white/[0.04] hover:text-slate-300"
                          aria-label="Fechar carteira completa"
                          title="Fechar carteira completa"
                        >
                          <X size={15} />
                        </button>
                      </div>
                    </div>

                    <div className="divide-y divide-white/[0.04]">
                      {projetosFiltrados.length === 0 ? (
                        <EmptyState text="Nenhum projeto encontrado para essa busca." />
                      ) : (
                        projetosFiltrados.map((projeto) => (
                          <ProjectRow
                            key={projeto.id}
                            projeto={projeto}
                            onOpen360={openProjeto360}
                            onEdit={openEditProjeto}
                            onUpdated={loadProjetos}
                          />
                        ))
                      )}
                    </div>
                  </section>
                )}

                {/* =====================================================
                    DATABASE STATUS
                   ===================================================== */}

                <div className="mt-5 flex flex-col gap-3 rounded-2xl border border-white/[0.06] bg-white/[0.018] px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                  <div className="flex items-center gap-2.5">
                    <div className="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-400/[0.07]">
                      <CheckCircle2
                        size={14}
                        className="text-emerald-300"
                      />
                    </div>

                    <div>
                      <div className="text-[10px] font-medium text-slate-400">
                        Conexão operacional
                      </div>

                      <div className="text-[9px] text-slate-600">
                        Supabase · {projetos.length}{" "}
                        projetos sincronizados
                      </div>
                    </div>
                  </div>

                  <div className="flex items-center gap-4 text-[9px] text-slate-600">
                    <span className="flex items-center gap-1.5">
                      <Clock3 size={11} />
                      Atualização em tempo real
                    </span>

                    <span className="flex items-center gap-1.5">
                      <TrendingUp size={11} />
                      Base operacional
                    </span>
                  </div>
                </div>

                {/* SEARCH RESULTS */}

                {search && (
                  <div className="mt-5 rounded-2xl border border-white/[0.06] bg-white/[0.025]">
                    <div className="flex items-center justify-between border-b border-white/[0.05] px-4 py-4">
                      <div>
                        <div className="text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-500">
                          Resultado da busca
                        </div>

                        <div className="mt-1 text-xs text-slate-600">
                          {projetosFiltrados.length}{" "}
                          projeto
                          {projetosFiltrados.length ===
                          1
                            ? ""
                            : "s"}{" "}
                          encontrado
                          {projetosFiltrados.length ===
                          1
                            ? ""
                            : "s"}
                        </div>
                      </div>

                      <button
                        onClick={() =>
                          setSearch("")
                        }
                        className="text-slate-600 hover:text-slate-300"
                      >
                        <X size={15} />
                      </button>
                    </div>

                    <div className="divide-y divide-white/[0.04]">
                      {projetosFiltrados
                        .slice(0, 10)
                        .map((projeto) => (
                          <ProjectRow
                            key={projeto.id}
                            projeto={projeto}
                            onOpen360={
                              openProjeto360
                            }
                            onEdit={
                              openEditProjeto
                            }
                            onUpdated={
                              loadProjetos
                            }
                          />
                        ))}

                      {projetosFiltrados.length ===
                        0 && (
                        <EmptyState text="Nenhum projeto encontrado para essa busca." />
                      )}
                    </div>
                  </div>
                )}
              </>
            )}
          </div>
        </section>
      </div>

      <Projeto360Modal
        projeto={projeto360}
        open={projeto360Open}
        onClose={closeProjeto360}
        onEdit={() => {
          const projetoCompleto = projetos.find((item) => item.id === projeto360?.id);
          closeProjeto360();
          if (projetoCompleto) openEditProjeto(projetoCompleto);
        }}
      />

      <ProjetoModal
        projeto={selectedProjeto}
        open={modalOpen}
        onClose={closeEditProjeto}
        onSaved={async () => {
          await loadProjetos();
          closeEditProjeto();
        }}
      />
    </main>
  );
}

/*
 * ================================================================
 * COMPONENTES — FASE 10
 * ================================================================
 */

function MiniMetric({
  label,
  value,
  icon: Icon,
}: {
  label: string;
  value: number;
  icon: typeof Workflow;
}) {
  return (
    <div className="rounded-xl border border-white/[0.05] bg-black/10 p-3">
      <div className="flex items-center gap-1.5">
        <Icon
          size={11}
          className="text-slate-600"
        />

        <span className="text-[8px] uppercase tracking-[0.1em] text-slate-600">
          {label}
        </span>
      </div>

      <div className="mt-2 text-lg font-semibold text-slate-200">
        {value}
      </div>
    </div>
  );
}

function ExecutiveMetric({
  label,
  value,
  helper,
}: {
  label: string;
  value: number | string;
  helper: string;
}) {
  return (
    <div className="rounded-xl border border-white/[0.05] bg-black/10 p-3">
      <div className="text-[9px] uppercase tracking-[0.12em] text-slate-600">
        {label}
      </div>

      <div className="mt-2 text-2xl font-semibold tracking-[-0.04em] text-white">
