[class~="rounded-full"][class~="bg-violet-400"] { box-shadow: 0 0 10px 1px rgba(167, 139, 250, 0.75); }
[class~="rounded-full"][class~="bg-emerald-400"] { box-shadow: 0 0 10px 1px rgba(52, 211, 153, 0.75); }
