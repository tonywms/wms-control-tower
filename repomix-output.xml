import { usePermissions } from "@/components/auth/usePermissions";
type Status =
  | "Não iniciado"
  | "Planejado"
  | "Em andamento"
  | "Pausado"
  | "Bloqueado"
  | "Finalizado"
  | "Cancelado";
type Projeto = {
  id: string;
  nome: string;
  status: string;
  prioridade?: string | null;
  percentual?: number | null;
  plataforma?: string | null;
  setor?: string | null;
  responsavel_nome?: string | null;
