  const dia = hoje.getDay();
  const inicio = new Date(hoje);
  if (dia === 0) inicio.setDate(hoje.getDate() + 1);
  else if (dia === 6) inicio.setDate(hoje.getDate() + 2);
  else inicio.setDate(hoje.getDate() - (dia - 1));
