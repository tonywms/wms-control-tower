            </span>

            {atrasado && (
              <span className="flex items-center gap-1 rounded-full border border-red-400/10 bg-red-400/[0.06] px-2 py-1 text-[8px] font-semibold uppercase tracking-[0.11em] text-red-300">
                <AlertTriangle size={9} />
                Atrasado
              </span>
            )}
          </div>

          <h3 className="mt-3 truncate text-sm font-semibold text-slate-200">
            {projeto.nome}
          </h3>

          <div className="mt-1 text-[10px] text-slate-600">
            {projeto.cliente?.nome ??
              "Cliente não informado"}

            {projeto.cliente?.cidade
              ? ` · ${projeto.cliente.cidade}`
              : ""}
          </div>
        </div>

        <button
          type="button"
          onClick={() =>
            onOpenProjeto(projeto.id)
          }
          className="flex h-9 shrink-0 items-center gap-1.5 rounded-xl border border-white/[0.06] bg-white/[0.025] px-3 text-[10px] font-medium text-slate-400 transition hover:border-violet-400/15 hover:bg-violet-400/[0.06] hover:text-violet-300"
        >
          Projeto 360

          <ArrowRight
            size={12}
            className="transition-transform group-hover:translate-x-0.5"
          />
        </button>
      </div>

      <div className="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
        <Info
          label="Etapa"
          value={
            projeto.etapa?.nome ?? "Sem etapa"
          }
        />

        <Info
          label="Responsável"
          value={
            projeto.responsavel_nome ??
            "Não definido"
          }
          icon={<UserRound size={11} />}
        />

        <Info
          label="Início"
          value={formatDate(
            projeto.data_inicio,
          )}
        />

        <Info
          label="Prazo"
          value={formatDate(projeto.data_fim)}
          danger={atrasado}
        />
      </div>

      <div className="mt-4">
        <div className="flex items-center justify-between">
          <span className="text-[9px] uppercase tracking-[0.12em] text-slate-600">
            Progresso
          </span>

          <span className="text-[10px] font-semibold text-slate-400">
            {percentual}%
          </span>
        </div>

        <div className="mt-2 h-1.5 overflow-hidden rounded-full bg-white/[0.05]">
          <div
            className="h-full rounded-full bg-violet-400/70 transition-all duration-700"
            style={{
              width: `${percentual}%`,
            }}
          />
        </div>
      </div>

      {projeto.observacoes && (
        <div className="mt-4 rounded-xl border border-white/[0.05] bg-white/[0.02] px-3 py-2.5">
          <div className="text-[8px] font-semibold uppercase tracking-[0.12em] text-slate-700">
            Contexto da demanda
          </div>

          <p className="mt-1 line-clamp-2 text-[10px] leading-4 text-slate-500">
            {projeto.observacoes}
          </p>
        </div>
      )}

      <div className="mt-4 flex items-center justify-between border-t border-white/[0.05] pt-3">
        <div className="flex items-center gap-2 text-[9px] text-slate-600">
          <CheckCircle2
            size={11}
            className="text-slate-700"
          />

          <span>
            {projeto.plataforma ??
              "Plataforma não informada"}
          </span>
        </div>

        <span className="text-[9px] text-slate-700">
          {projeto.setor ??
            "Desenvolvimento"}
        </span>
      </div>
    </article>
  );
}

function Info({
  label,
  value,
  icon,
  danger = false,
}: {
  label: string;
  value: string;
  icon?: React.ReactNode;
  danger?: boolean;
}) {
  return (
    <div className="rounded-xl border border-white/[0.05] bg-white/[0.02] p-2.5">
      <div className="text-[8px] font-semibold uppercase tracking-[0.12em] text-slate-700">
