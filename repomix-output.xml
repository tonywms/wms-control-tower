          : "border-white/[.05] bg-white/[.02] text-slate-300";

  return (
    <div className={`rounded-xl border p-3 ${c}`}>
      <div className="text-lg font-semibold">{value}</div>
      <div className="mt-1 text-[8px] uppercase tracking-[.12em] opacity-60">
        {label}
      </div>
