}

function Mini({
  label,
  value,
  icon: Icon,
  onClick,
}: {
  label: string;
  value: number;
  icon: typeof Activity;
  onClick?: () => void;
}) {
  return (
    <button type="button" onClick={onClick} className="rounded-2xl border border-white/[.06] bg-white/[.025] p-4 text-left transition hover:-translate-y-0.5 hover:bg-white/[.05]">
