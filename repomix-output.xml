}

function RisksSlide({
  projetos,
  onOpenProjeto,
}: {
  projetos: any[];
  onOpenProjeto: (id: string) => void;
}) {
  const bloqueados = projetos.filter(
    (item) => item.bloqueado,
  );

  const atrasados = projetos.filter(
    (item) => item.atrasado && !item.bloqueado,
  );

  return (
    <div className="grid gap-4 xl:grid-cols-2">
      <RiskColumn
        title="Bloqueios ativos"
        subtitle="Projetos com fluxo operacional interrompido"
        icon={ShieldAlert}
        tone="red"
        items={bloqueados}
        onOpenProjeto={onOpenProjeto}
      />

      <RiskColumn
        title="Risco de prazo"
        subtitle="Projetos ativos que já ultrapassaram a previsão"
        icon={Clock3}
        tone="amber"
        items={atrasados}
        onOpenProjeto={onOpenProjeto}
      />
    </div>
  );
}

