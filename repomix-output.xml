function ProblemsSlide({
  projetos,
  onOpenProjeto,
}: {
  projetos: any[];
  onOpenProjeto: (id: string) => void;
}) {
  const problemas = projetos.filter(
    (item) => item.score > 0,
  );

  return (
    <section className="rounded-2xl border border-white/[0.06] bg-white/[0.02]">
      <div className="flex items-center justify-between border-b border-white/[0.05] px-5 py-4">
        <div>
          <div className="text-[10px] font-semibold uppercase tracking-[0.15em] text-slate-500">
            Mapa de Problemas
          </div>

          <div className="mt-1 text-[11px] text-slate-600">
            Ranking automático pela pressão operacional atual
          </div>
        </div>

        <span className="rounded-full border border-red-400/10 bg-red-400/[0.05] px-2.5 py-1 text-[9px] font-semibold text-red-300">
          {problemas.length} com alerta
        </span>
      </div>

      <div className="divide-y divide-white/[0.04]">
        {problemas.slice(0, 12).map((item, index) => (
          <ProblemRow
            key={item.projeto.id}
            item={item}
            position={index + 1}
            onOpenProjeto={onOpenProjeto}
            expanded
          />
        ))}

        {problemas.length === 0 && (
