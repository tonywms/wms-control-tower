const TIPOS_VALIDOS = ["Pendência", "Impedimento"] as const;
const PRIORIDADES_VALIDAS = ["Baixa", "Normal", "Alta", "Crítica"] as const;
const STATUS_VALIDOS = [
  "Pendente",
  "Em andamento",
  "Concluída",
  "Cancelada",
] as const;

