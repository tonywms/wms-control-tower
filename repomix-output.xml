    setProjeto360Open(false);
    setProjeto360(null);

    // Sem projeto selecionado = modo criação no ProjetoModal.
    setSelectedProjeto(null);
    setModalOpen(true);
  }, []);

  const openEditProjeto = useCallback(
  (projeto: Projeto) => {
    // Garante exclusividade entre os modais.
    setProjeto360Open(false);
    setProjeto360(null);

    setSelectedProjeto(projeto);
    setModalOpen(true);
  },
  [],
);

  const openCarteiraCompleta = useCallback(() => {
    setCarteiraCompletaOpen(true);

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        document
          .getElementById("carteira-completa")
          ?.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
      });
    });
  }, []);

  const closeEditProjeto = useCallback(() => {
    setModalOpen(false);
    setSelectedProjeto(null);
  }, []);

  const loadProjetos = useCallback(async () => {
    try {
      setLoading(true);
      setError("");

      const response = await fetch("/api/projetos", {
        cache: "no-store",
      });

      if (!response.ok) {
        throw new Error(`Erro HTTP ${response.status}`);
      }

      const data = (await response.json()) as ApiResponse;

      if (!data.success) {
        throw new Error("A API não retornou sucesso.");
      }

      const projetosAtualizados = data.projetos ?? [];

      setProjetos(projetosAtualizados);
      setResumo(data.resumo ?? null);

      // Mantém modais sincronizados com o registro mais recente do banco.
      // Isso evita que prazo, prioridade ou responsável antigos continuem
      // aparecendo no Projeto 360 depois de uma decisão gerencial.
      setProjeto360((atual) => {
        if (!atual) return atual;

        return (
          projetosAtualizados.find(
            (item) => item.id === atual.id,
          ) ?? atual
        );
      });

      setSelectedProjeto((atual) => {
        if (!atual) return atual;

        return (
          projetosAtualizados.find(
            (item) => item.id === atual.id,
          ) ?? atual
        );
      });
    } catch (err) {
      console.error(err);

      setError(
        err instanceof Error
          ? err.message
          : "Erro ao carregar carteira.",
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadProjetos();
  }, [loadProjetos]);

  useEffect(() => {
    const atualizarHoje = () => {
      const data = new Date();
      data.setHours(0, 0, 0, 0);
      setHoje(data);
    };

    atualizarHoje();
  }, []);

  const projetosFiltrados = useMemo(() => {
    const term = search.trim().toLowerCase();

    if (!term) return projetos;

    return projetos.filter((projeto) => {
      const searchable = [
        projeto.nome,
        projeto.cliente?.nome,
        projeto.cliente?.cidade,
        projeto.responsavel_nome,
        projeto.etapa?.nome,
        projeto.setor,
        projeto.status,
        projeto.plataforma,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      return searchable.includes(term);
    });
  }, [projetos, search]);

  /*
   * ============================================================
   * GO-LIVES
   * ============================================================
   */

  const goLives = useMemo(() => {
    return projetos
      .filter(
        (projeto) =>
          projeto.etapa?.nome === "Go-Live" ||
          projeto.etapa?.nome === "GoLive",
      )
      .sort((a, b) => {
        if (!a.data_inicio) return 1;
        if (!b.data_inicio) return -1;

        return a.data_inicio.localeCompare(
          b.data_inicio,
        );
      })
      .slice(0, 5);
  }, [projetos]);

  /*
   * ============================================================
   * ALERTAS CRÍTICOS
   * ============================================================
   */

  const criticalAlerts = useMemo(() => {
    return projetos
      .filter(
        (projeto) =>
          projeto.status === "Bloqueado" ||
          projeto.prioridade === "Crítica" ||
          (projeto.data_fim &&
            daysUntil(projeto.data_fim) !== null &&
            (daysUntil(projeto.data_fim) ?? 0) < 0),
      )
      .slice(0, 5);
  }, [projetos]);

  /*
   * ============================================================
   * OPERAÇÕES EM ANDAMENTO
   * ============================================================
   */

  const liveOperations = useMemo(() => {
    return projetos
      .filter(
        (projeto) =>
          projeto.status === "Em andamento",
      )
      .slice(0, 6);
  }, [projetos]);

  /*
   * ============================================================
   * CAPACIDADE
   * ============================================================
   */

  const capacity = useMemo(() => {
    const map = new Map<
      string,
      {
        nome: string;
        total: number;
        andamento: number;
        bloqueados: number;
      }
    >();

    projetos.forEach((projeto) => {
      const nome =
        projeto.responsavel_nome ||
        "Sem responsável";

      const current = map.get(nome) ?? {
        nome,
        total: 0,
        andamento: 0,
        bloqueados: 0,
      };

      current.total += 1;

      if (projeto.status === "Em andamento") {
        current.andamento += 1;
      }

      if (projeto.status === "Bloqueado") {
        current.bloqueados += 1;
      }

      map.set(nome, current);
    });

    return Array.from(map.values())
      .sort((a, b) => b.total - a.total)
      .slice(0, 5);
  }, [projetos]);

  /*
   * ============================================================
   * FLUXO OPERACIONAL
   * ============================================================
   */

  const operationalFlow = useMemo(() => {
    const stages = [
      "Comercial",
      "Planejamento",
      "Configuração e Parametrização",
      "Homologação e Testes",
      "Treinamento e Capacitação",
      "Go-Live",
      "Suporte",
      "Pós-venda",
    ];

    return stages.map((stage) => {
      const total = projetos.filter(
        (projeto) =>
          projeto.etapa?.nome === stage,
      ).length;

      return {
        stage,
        total,
      };
    });
  }, [projetos]);

  const maxFlow = Math.max(
    ...operationalFlow.map((item) => item.total),
    1,
  );

  /*
   * ============================================================
   * FASE 10 — EXECUTIVE CONTROL TOWER
   *
   * Todos os indicadores abaixo são calculados apenas a partir
   * dos dados que já existem em projetos.
   * ============================================================
   */

  const executiveMetrics = useMemo(() => {
    if (!hoje) {
      return {
        ativos: 0,
        wip: 0,
        bloqueados: 0,
        pausados: 0,
        criticos: 0,
        atrasados: 0,
        proximos7Dias: 0,
        semResponsavel: 0,
        percentualMedio: 0,
        healthScore: 0,
        healthLabel: "Calculando",
        healthTone: "sky",
        statusDistribution: [],
        setores: [],
        bottleneck: {
          stage: "Calculando",
          total: 0,
        },
        executiveRisks: [],
        finalizados7Dias: 0,
        finalizados30Dias: 0,
      };
    }

    const ativos = projetos.filter(
      (projeto) =>
        projeto.status !== "Finalizado" &&
        projeto.status !== "Cancelado",
    );

    const wip = projetos.filter(
      (projeto) =>
        projeto.status === "Em andamento",
    );

    const bloqueados = projetos.filter(
      (projeto) =>
        projeto.status === "Bloqueado",
    );

    const pausados = projetos.filter(
      (projeto) =>
        projeto.status === "Pausado",
    );

    const criticos = projetos.filter(
      (projeto) =>
        projeto.prioridade === "Crítica",
    );

    const atrasados = projetos.filter((projeto) => {
      if (!projeto.data_fim) return false;

      const dias = daysUntil(projeto.data_fim);

      return (
        dias !== null &&
        dias < 0 &&
        projeto.status !== "Finalizado" &&
        projeto.status !== "Cancelado"
      );
    });

    const proximos7Dias = projetos.filter(
      (projeto) => {
        if (!projeto.data_fim) return false;

        const dias = daysUntil(projeto.data_fim);

        return (
          dias !== null &&
          dias >= 0 &&
          dias <= 7 &&
          projeto.status !== "Finalizado" &&
          projeto.status !== "Cancelado"
        );
      },
    );

    const semResponsavel = ativos.filter(
      (projeto) =>
        !projeto.responsavel_nome ||
        projeto.responsavel_nome.trim() === "",
    );

    const percentualMedio =
      ativos.length > 0
        ? Math.round(
            ativos.reduce(
              (acc, projeto) =>
                acc + (projeto.percentual || 0),
              0,
            ) / ativos.length,
          )
        : 0;

    /*
     * Health Score:
     *
     * começa em 100
     * - bloqueados
     * - atrasados
     * - críticos
     * - sem responsável
     * - pausados
     *
     * É um indicador executivo de saúde, não um
     * KPI financeiro ou SLA.
     */

    let healthScore = 100;

    if (ativos.length > 0) {
      healthScore -=
        Math.min(
          30,
          Math.round(
            (bloqueados.length /
              ativos.length) *
              45,
          ),
        );

      healthScore -=
        Math.min(
          25,
          Math.round(
            (atrasados.length /
              ativos.length) *
              35,
          ),
        );

      healthScore -=
        Math.min(
          15,
          Math.round(
            (criticos.length /
              ativos.length) *
              20,
          ),
        );

      healthScore -=
        Math.min(
          10,
          Math.round(
            (semResponsavel.length /
              ativos.length) *
              15,
          ),
        );

      healthScore -=
        Math.min(
          10,
          Math.round(
            (pausados.length /
              ativos.length) *
              10,
          ),
        );
    }

    healthScore = Math.max(
      0,
      Math.min(100, healthScore),
    );

    const healthLabel =
      healthScore >= 85
        ? "Saudável"
        : healthScore >= 70
          ? "Atenção"
          : healthScore >= 50
            ? "Risco"
            : "Crítico";

    const healthTone =
      healthScore >= 85
        ? "emerald"
        : healthScore >= 70
          ? "sky"
          : healthScore >= 50
            ? "amber"
            : "red";

    /*
     * STATUS DISTRIBUTION
     */

    const statusDistribution = [
      {
        label: "Em andamento",
        value: projetos.filter(
          (p) => p.status === "Em andamento",
        ).length,
      },
      {
        label: "Planejado",
        value: projetos.filter(
          (p) => p.status === "Planejado",
        ).length,
      },
      {
        label: "Não iniciado",
        value: projetos.filter(
          (p) => p.status === "Não iniciado",
        ).length,
      },
      {
        label: "Pausado",
        value: pausados.length,
      },
      {
        label: "Bloqueado",
        value: bloqueados.length,
      },
      {
        label: "Finalizado",
        value: projetos.filter(
          (p) => p.status === "Finalizado",
        ).length,
      },
    ];

    /*
     * SETOR
     */

    const setorMap = new Map<string, number>();

    projetos.forEach((projeto) => {
      const setor =
        projeto.setor?.trim() ||
        "Sem setor";

      setorMap.set(
        setor,
        (setorMap.get(setor) ?? 0) + 1,
      );
    });

    const setores = Array.from(
      setorMap.entries(),
    )
      .map(([nome, total]) => ({
        nome,
        total,
      }))
      .sort((a, b) => b.total - a.total)
      .slice(0, 6);

    /*
     * BOTTLENECK
     */

    const bottleneck = [...operationalFlow]
      .filter((item) => item.total > 0)
      .sort((a, b) => b.total - a.total)[0] ?? {
      stage: "Sem concentração",
      total: 0,
    };

    /*
     * RISCO EXECUTIVO
     */

    const executiveRisks: {
      title: string;
      description: string;
      count: number;
      severity: "critical" | "high" | "medium";
      icon: typeof AlertTriangle;
    }[] = [];

    if (bloqueados.length > 0) {
      executiveRisks.push({
        title: "Projetos bloqueados",
        description:
          "Demandam decisão ou desbloqueio executivo.",
        count: bloqueados.length,
        severity: "critical",
        icon: ShieldAlert,
      });
    }

    if (atrasados.length > 0) {
      executiveRisks.push({
        title: "Prazos vencidos",
        description:
          "Projetos ativos com data final ultrapassada.",
        count: atrasados.length,
        severity: "critical",
        icon: Timer,
      });
    }

    if (criticos.length > 0) {
      executiveRisks.push({
        title: "Prioridade crítica",
        description:
          "Projetos marcados como prioridade Crítica.",
        count: criticos.length,
        severity: "high",
        icon: CircleAlert,
      });
    }

    if (proximos7Dias.length > 0) {
      executiveRisks.push({
        title: "Janela de 7 dias",
        description:
          "Projetos com prazo final nos próximos 7 dias.",
        count: proximos7Dias.length,
        severity: "high",
        icon: CalendarDays,
      });
    }

    if (semResponsavel.length > 0) {
      executiveRisks.push({
        title: "Sem responsável",
        description:
          "Projetos ativos sem ownership definido.",
        count: semResponsavel.length,
        severity: "medium",
        icon: UserRoundX,
      });
    }

    if (pausados.length > 0) {
      executiveRisks.push({
        title: "Projetos pausados",
        description:
          "Itens fora do fluxo ativo de execução.",
        count: pausados.length,
        severity: "medium",
        icon: Clock3,
      });
    }

    /*
     * THROUGHPUT DISPONÍVEL NA BASE ATUAL
     *
     * Como a base possui finished_at, podemos medir
     * quantos projetos foram finalizados no período
     * dos últimos 7 e 30 dias.
     */

    const finalizados7Dias = projetos.filter(
      (projeto) => {
        if (
          projeto.status !== "Finalizado" ||
          !projeto.updated_at
        ) {
          return false;
        }

        const data = new Date(
          projeto.updated_at,
        );

        const diff =
          hoje.getTime() - data.getTime();

        return (
          diff >= 0 &&
          diff <=
            7 *
              24 *
              60 *
              60 *
              1000
        );
      },
    ).length;

    const finalizados30Dias = projetos.filter(
      (projeto) => {
        if (
          projeto.status !== "Finalizado" ||
          !projeto.updated_at
        ) {
          return false;
        }

        const data = new Date(
          projeto.updated_at,
        );

        const diff =
          hoje.getTime() - data.getTime();

        return (
          diff >= 0 &&
          diff <=
            30 *
              24 *
              60 *
              60 *
              1000
        );
      },
    ).length;

    return {
      ativos: ativos.length,
      wip: wip.length,
      bloqueados: bloqueados.length,
      pausados: pausados.length,
      criticos: criticos.length,
      atrasados: atrasados.length,
      proximos7Dias: proximos7Dias.length,
      semResponsavel: semResponsavel.length,
      percentualMedio,
      healthScore,
      healthLabel,
      healthTone,
      statusDistribution,
      setores,
      bottleneck,
      executiveRisks: executiveRisks.slice(
        0,
        6,
      ),
      finalizados7Dias,
      finalizados30Dias,
    };
  }, [projetos, operationalFlow, hoje]);

  /*
   * ============================================================
   * RENDER
   * ============================================================
   */

  async function handleLogout() {
    if (logoutLoading) return;

    try {
      setLogoutLoading(true);

      const response = await fetch("/api/auth/logout", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
      });

      const result = await response.json().catch(() => null);

      if (!response.ok || !result?.success) {
        throw new Error(
          result?.error || "Não foi possível encerrar a sessão.",
        );
      }

      router.replace("/login");
    } catch (error) {
      console.error("[Control Tower] Erro ao sair:", error);
      setLogoutLoading(false);
    }
  }

  return (
    <main className="min-h-screen bg-[#05070b] text-slate-100">
      <div className="fixed inset-0 pointer-events-none overflow-hidden">
        <div className="absolute left-[15%] top-[-15%] h-[520px] w-[520px] rounded-full bg-sky-500/[0.035] blur-[120px]" />

        <div className="absolute right-[-10%] top-[20%] h-[480px] w-[480px] rounded-full bg-blue-600/[0.025] blur-[120px]" />

        <div className="absolute bottom-[-20%] left-[30%] h-[520px] w-[520px] rounded-full bg-cyan-500/[0.018] blur-[140px]" />
      </div>

      <div className="relative flex min-h-screen">
        {/* MOBILE OVERLAY */}

        {sidebarOpen && (
          <button
            aria-label="Fechar menu"
            onClick={() =>
              setSidebarOpen(false)
            }
            className="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm lg:hidden"
          />
        )}

        {/* SIDEBAR */}

        <aside
          className={[
            "fixed inset-y-0 left-0 z-50 flex w-[258px] flex-col border-r border-white/[0.06] bg-[#070a10]/95 backdrop-blur-xl transition-transform duration-300 lg:static lg:translate-x-0",
            sidebarOpen
              ? "translate-x-0"
              : "-translate-x-full",
          ].join(" ")}
        >
          <div className="flex h-[76px] items-center justify-between border-b border-white/[0.06] px-5">
            <div className="flex items-center gap-3">
              <div className="flex h-9 w-9 items-center justify-center rounded-xl border border-sky-400/20 bg-sky-400/[0.08]">
                <Sparkles
                  size={17}
                  className="text-sky-300"
                />
              </div>

              <div>
                <div className="text-[13px] font-semibold tracking-[0.18em] text-white">
                  WMS EXPERT
                </div>

                <div className="mt-0.5 text-[10px] uppercase tracking-[0.2em] text-slate-500">
                  Control Tower
                </div>
              </div>
            </div>

            <button
              onClick={() =>
                setSidebarOpen(false)
              }
              className="rounded-lg p-2 text-slate-500 hover:bg-white/[0.04] hover:text-white lg:hidden"
            >
              <X size={17} />
            </button>
          </div>

          <div className="px-3 pt-6">
            <div className="mb-3 px-3 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-600">
              Workspace
            </div>

            <nav className="space-y-1">
              {menuItems.map((item) => {
                const Icon = item.icon;
                const active =
                  selectedMenu === item.label;

                return (
                  <button
