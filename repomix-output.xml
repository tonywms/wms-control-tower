  background-image: radial-gradient(rgba(160, 175, 255, 0.16) 1px, transparent 1.2px);
  background-size: 28px 28px;
  -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 25%, #000 0%, transparent 78%);
  mask-image: radial-gradient(ellipse 80% 70% at 50% 25%, #000 0%, transparent 78%);
}

/* orbes do JSX (div.fixed com 3 filhos) */
main[class*="bg-[#05070b]"] > div.fixed > div:nth-child(1) {
  background-color: rgba(34, 211, 238, 0.22);
  animation: aurora-drift-a 26s ease-in-out infinite;
}

main[class*="bg-[#05070b]"] > div.fixed > div:nth-child(2) {
  background-color: rgba(139, 92, 246, 0.26);
  animation: aurora-drift-b 32s ease-in-out infinite;
}

main[class*="bg-[#05070b]"] > div.fixed > div:nth-child(3) {
  background-color: rgba(217, 70, 239, 0.16);
  animation: aurora-drift-c 38s ease-in-out infinite;
}

/* login / configurações */
main[class*="bg-[#05080d]"] > div.absolute:nth-of-type(1) {
  background-color: rgba(34, 211, 238, 0.24);
}

main[class*="bg-[#05080d]"] > div.absolute:nth-of-type(2) {
  background-color: rgba(139, 92, 246, 0.28);
}

main[class*="bg-[#05080d]"] > div.absolute:nth-of-type(3) {
  background-color: rgba(217, 70, 239, 0.16);
}

/* ==========================================================================
   5. SIDEBAR
   ========================================================================== */

aside[class*="bg-[#070a10]"] {
  background:
    radial-gradient(ellipse 120% 40% at 0% 0%, rgba(34, 211, 238, 0.14), transparent 70%),
    radial-gradient(ellipse 100% 40% at 100% 100%, rgba(139, 92, 246, 0.16), transparent 70%),
    linear-gradient(180deg, rgba(10, 16, 48, 0.94) 0%, rgba(7, 11, 34, 0.96) 100%);
  border-right-color: transparent;
  box-shadow:
    inset -1px 0 0 rgba(142, 160, 255, 0.16),
    18px 0 60px -20px rgba(2, 4, 24, 0.7);
  backdrop-filter: blur(24px) saturate(150%);
  -webkit-backdrop-filter: blur(24px) saturate(150%);
}

aside [class~="border-white/[0.06]"] {
  border-color: rgba(142, 160, 255, 0.14);
}

/* logo */
aside [class~="h-9"][class~="w-9"][class~="rounded-xl"] {
  background: var(--brand);
  border-color: rgba(255, 255, 255, 0.35);
  box-shadow:
    0 8px 28px -4px rgba(79, 139, 255, 0.65),
    0 0 0 4px rgba(79, 139, 255, 0.10),
    inset 0 1px 0 rgba(255, 255, 255, 0.45);
}

aside [class~="h-9"][class~="w-9"] svg {
  color: #fff;
  filter: drop-shadow(0 1px 4px rgba(4, 6, 26, 0.5));
}

aside [class~="tracking-[0.18em]"][class~="text-white"] {
  font-family: var(--font-display);
  font-weight: 700;
  background: linear-gradient(100deg, #ffffff 20%, #a5e8ff 60%, #d9c6ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

aside [class~="tracking-[0.2em]"] {
  color: #8f9bd0;
}

/* títulos de seção */
aside [class~="text-slate-600"] {
  color: #7f8cc2;
}

/* navegação */
aside nav button {
  position: relative;
  border-radius: 14px;
  transition:
    background 220ms var(--ease),
    color 220ms var(--ease),
    transform 220ms var(--ease),
    box-shadow 220ms var(--ease);
}

aside nav button:hover {
  background: linear-gradient(90deg, rgba(99, 102, 241, 0.16), rgba(34, 211, 238, 0.05));
  color: #eef2ff;
  transform: translateX(3px);
}

aside nav button svg {
  transition: color 220ms var(--ease), filter 220ms var(--ease);
}

/* item ativo */
aside nav button[class~="text-sky-200"] {
  color: #ffffff;
  font-weight: 600;
  border-color: transparent;
  background:
    linear-gradient(90deg, rgba(34, 211, 238, 0.22), rgba(99, 102, 241, 0.20) 60%, rgba(217, 70, 239, 0.14)) padding-box,
    linear-gradient(120deg, rgba(34, 211, 238, 0.75), rgba(129, 140, 248, 0.35) 55%, rgba(217, 70, 239, 0.45)) border-box;
  background-origin: border-box;
  box-shadow:
    0 10px 30px -10px rgba(79, 139, 255, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.10);
  transform: none;
}

aside nav button[class~="text-sky-200"]::before {
  content: "";
  position: absolute;
  left: -13px;
  top: 22%;
  bottom: 22%;
  width: 4px;
  border-radius: 0 6px 6px 0;
  background: linear-gradient(180deg, #22d3ee, #8b5cf6);
  box-shadow: 0 0 16px 2px rgba(34, 211, 238, 0.65);
}

aside nav button[class~="text-sky-200"] svg {
  color: #67e8f9;
  filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.8));
}

aside nav button:hover svg {
  color: #a5f3fc;
}

/* contador */
aside nav [class~="bg-white/[0.05]"] {
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.28), rgba(139, 92, 246, 0.30));
  color: #e9eeff;
  font-weight: 700;
  box-shadow: inset 0 0 0 1px rgba(165, 180, 255, 0.28);
}

/* card de status do sistema */
aside [class~="rounded-2xl"][class~="bg-white/[0.025]"] {
  background:
    linear-gradient(160deg, rgba(16, 185, 129, 0.16), rgba(14, 22, 62, 0.6)) padding-box,
    linear-gradient(140deg, rgba(52, 211, 153, 0.55), rgba(99, 102, 241, 0.2)) border-box;
  background-origin: border-box;
  border-color: transparent;
}

aside [class~="bg-emerald-400"][class~="rounded-full"] {
  animation: pulse-ring 2.4s ease-out infinite;
}

/* ==========================================================================
   6. TOPBAR
   ========================================================================== */

section.min-w-0 > header {
  position: sticky;
  top: 0;
  z-index: 30;
  background: linear-gradient(180deg, rgba(8, 12, 36, 0.82), rgba(8, 12, 36, 0.62));
  border-bottom-color: transparent;
  box-shadow: 0 1px 0 rgba(142, 160, 255, 0.16), 0 18px 40px -26px rgba(2, 4, 24, 0.9);
  backdrop-filter: blur(22px) saturate(170%);
  -webkit-backdrop-filter: blur(22px) saturate(170%);
}

/* linha de luz inferior */
section.min-w-0 > header::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;
  height: 1px;
  pointer-events: none;
  background: linear-gradient(90deg, transparent 0%, rgba(34, 211, 238, 0.55) 25%, rgba(139, 92, 246, 0.55) 60%, rgba(217, 70, 239, 0.4) 80%, transparent 100%);
  opacity: 0.7;
}

/* busca */
section.min-w-0 > header input {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(142, 160, 255, 0.22);
  color: var(--text);
  transition: border-color 200ms ease, box-shadow 200ms ease, background 200ms ease, width 300ms var(--ease);
}

section.min-w-0 > header input:hover {
  background: rgba(255, 255, 255, 0.07);
}

section.min-w-0 > header input:focus {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(34, 211, 238, 0.7);
  box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.14), 0 10px 30px -10px rgba(34, 211, 238, 0.45);
}

/* breadcrumb */
section.min-w-0 > header [class~="text-slate-600"] {
  color: #8693c8;
}

/* sino de notificação */
section.min-w-0 > header button[class~="h-9"][class~="w-9"]:hover {
  color: #fff;
  border-color: rgba(34, 211, 238, 0.5);
  background: rgba(34, 211, 238, 0.10);
  box-shadow: 0 8px 24px -8px rgba(34, 211, 238, 0.5);
  transform: translateY(-1px);
}

section.min-w-0 > header [class~="bg-red-400"][class~="rounded-full"] {
  animation: pulse-ring-red 2s ease-out infinite;
}

/* avatar */
section.min-w-0 > header [class~="rounded-full"][class~="bg-sky-400/[0.08]"] {
  background: var(--brand);
  border-color: rgba(255, 255, 255, 0.4);
  color: #fff;
  box-shadow: 0 6px 20px -4px rgba(79, 139, 255, 0.7);
}

/* divisor vertical */
[class~="w-px"][class~="bg-white/[0.06]"] {
  background: linear-gradient(180deg, transparent, rgba(142, 160, 255, 0.4), transparent);
}

/* menu do usuário (dropdown) */
[class*="bg-[#0a1019]"] {
  background: linear-gradient(170deg, rgba(24, 34, 86, 0.96), rgba(9, 14, 42, 0.97));
  border-color: rgba(142, 160, 255, 0.28);
  box-shadow: 0 30px 70px -10px rgba(2, 4, 24, 0.9), 0 0 0 1px rgba(34, 211, 238, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.07);
  animation: modal-in 220ms var(--ease) both;
}

/* ==========================================================================
   7. SUPERFÍCIES (cards em vidro com borda gradiente)
   ========================================================================== */

/* tier 1 — fundo quase invisível (colunas, trilhas) */
:is(
  [class~="bg-white/[0.01]"],
  [class~="bg-white/[0.012]"],
  [class~="bg-white/[0.015]"],
  [class~="bg-white/[0.018]"]
) {
  background-color: rgba(120, 135, 255, 0.045);
}

/* tier 2 — cards padrão (tem borda) */
:is(
  [class~="bg-white/[0.02]"],
  [class~="bg-white/[0.025]"],
  [class~="bg-white/[0.03]"],
  [class~="bg-white/[0.035]"]
):is([class~="border"]):not([draggable]) {
  background:
    var(--glass-fill) padding-box,
    var(--glass-edge) border-box;
  background-origin: border-box;
  border-color: transparent;
  box-shadow: var(--shadow-card);
  backdrop-filter: blur(16px) saturate(140%);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  transition:
    box-shadow 300ms var(--ease),
    transform 300ms var(--ease),
    background 300ms var(--ease);
}

/* cards grandes ganham mais presença no hover */
:is(
  [class~="bg-white/[0.02]"],
  [class~="bg-white/[0.025]"]
):is([class~="rounded-2xl"], [class~="rounded-3xl"]):is([class~="border"]):not([draggable]):hover {
  box-shadow: var(--shadow-lift);
}

/* tier 3 — realçados */
:is(
  [class~="bg-white/[0.04]"],
  [class~="bg-white/[0.045]"],
  [class~="bg-white/[0.05]"],
  [class~="bg-white/[0.06]"],
  [class~="bg-white/[0.08]"],
  [class~="bg-white/5"]
) {
  background-color: rgba(129, 140, 248, 0.14);
}

:is(
  [class~="bg-white/[0.04]"],
  [class~="bg-white/[0.045]"],
  [class~="bg-white/[0.05]"],
  [class~="bg-white/5"]
):is([class~="border"]) {
  background:
    var(--glass-fill-hi) padding-box,
    var(--glass-edge) border-box;
  background-origin: border-box;
  border-color: transparent;
}

/* poços escuros (inset) */
:is([class~="bg-black/10"], [class~="bg-black/20"]) {
  background-color: rgba(3, 5, 24, 0.40);
  box-shadow: inset 0 2px 10px rgba(2, 4, 24, 0.45);
}

/* bordas neutras em divisórias */
:is(
  [class~="border-white/[0.04]"],
  [class~="border-white/[0.05]"],
  [class~="border-white/[0.06]"],
  [class~="border-white/[0.07]"],
  [class~="border-white/[0.08]"],
  [class~="border-white/[0.09]"],
  [class~="border-white/[0.1]"],
  [class~="border-white/10"]
):not([class~="border"]) {
  border-color: rgba(142, 160, 255, 0.16);
}

[class*="divide-white/"] > * + * {
  border-color: rgba(142, 160, 255, 0.12);
}

/* painéis grandes (Kanban, toolbar do Gantt, configurações) */
:is(
  [class*="bg-[#070b12]"],
  [class*="bg-[#0b111a]"],
  [class*="bg-[#090e15]"],
  [class*="bg-[#080d16]/80"]
) {
  background:
    linear-gradient(165deg, rgba(20, 30, 82, 0.62), rgba(8, 12, 38, 0.72)) padding-box,
    var(--glass-edge) border-box;
  background-origin: border-box;
  border-color: transparent;
  box-shadow: 0 30px 70px -28px rgba(2, 4, 24, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

[class*="bg-[#05080d]"]:not(main) {
  background-color: rgba(4, 6, 28, 0.55);
}

/* ==========================================================================
   8. HERO, KPIs E TIPOGRAFIA
   ========================================================================== */

/* entrada orquestrada — a única animação "de página" */
section.min-w-0 > div[class*="pb-10"] > * {
  animation: rise 700ms var(--ease) backwards;
}

section.min-w-0 > div[class*="pb-10"] > *:nth-child(1) { animation-delay: 40ms; }
section.min-w-0 > div[class*="pb-10"] > *:nth-child(2) { animation-delay: 120ms; }
section.min-w-0 > div[class*="pb-10"] > *:nth-child(3) { animation-delay: 200ms; }
section.min-w-0 > div[class*="pb-10"] > *:nth-child(4) { animation-delay: 280ms; }
section.min-w-0 > div[class*="pb-10"] > *:nth-child(n + 5) { animation-delay: 360ms; }

/* hero principal */
main .rounded-3xl[class*="from-white/"] {
  background:
    radial-gradient(ellipse 60% 120% at 100% 0%, rgba(217, 70, 239, 0.28), transparent 60%),
    radial-gradient(ellipse 60% 120% at 0% 100%, rgba(34, 211, 238, 0.22), transparent 62%),
    linear-gradient(135deg, rgba(36, 50, 128, 0.82), rgba(14, 20, 62, 0.88)) padding-box,
    var(--glass-edge-hot) border-box;
  background-origin: border-box;
  border-color: transparent;
  box-shadow:
    0 40px 90px -30px rgba(79, 139, 255, 0.45),
    0 0 0 1px rgba(255, 255, 255, 0.03),
    inset 0 1px 0 rgba(255, 255, 255, 0.12);
}

main .rounded-3xl[class*="from-white/"] [class~="bg-sky-400/[0.045]"] {
  background-color: rgba(34, 211, 238, 0.35);
}

/* títulos */
main h1 {
  font-weight: 700;
  letter-spacing: -0.04em;
  background: linear-gradient(100deg, #ffffff 25%, #bfe9ff 60%, #e0d2ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

main h2,
main h3 {
  font-weight: 650;
}

/* números grandes dos cards */
main [class~="text-5xl"] {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.06em;
  background: linear-gradient(180deg, #ffffff 30%, #9fb4ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  filter: drop-shadow(0 6px 24px rgba(79, 139, 255, 0.35));
}

main [class~="text-lg"][class~="font-semibold"][class~="text-white"],
main [class~="text-2xl"][class~="font-semibold"][class~="text-white"] {
  font-family: var(--font-display);
  letter-spacing: -0.03em;
}

/* escala de texto (todas com contraste ≥ 4.5:1 sobre o fundo) */
.text-slate-700 { color: #6f7dae; }
.text-slate-600 { color: #8794c7; }
.text-slate-500 { color: #9ba7d6; }
.text-slate-400 { color: #b4bee6; }
.text-slate-300 { color: #cfd7f6; }
.text-slate-200 { color: #e4e9fc; }
.text-white { color: #f8faff; }

[class~="text-white/15"] { color: rgba(190, 200, 255, 0.35); }
[class~="text-white/25"] { color: rgba(190, 200, 255, 0.50); }
[class~="text-white/35"] { color: rgba(200, 210, 255, 0.62); }
[class~="text-white/40"] { color: rgba(205, 215, 255, 0.70); }
[class~="text-white/45"] { color: rgba(210, 220, 255, 0.76); }
[class~="text-white/55"] { color: rgba(220, 228, 255, 0.84); }
[class~="text-white/60"] { color: rgba(225, 232, 255, 0.90); }

/* ==========================================================================
