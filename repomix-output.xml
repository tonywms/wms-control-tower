  const [modalAberto, setModalAberto] =
    useState(false);
  const [projetoPendente, setProjetoPendente] =
    useState<Projeto | null>(null);
  const [statusPendente, setStatusPendente] =
    useState<Status | null>(null);
  const [motivo, setMotivo] =
