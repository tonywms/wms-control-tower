    {precisaPrazo&&<div><div className="mb-2 flex items-center gap-2 text-[9px] font-semibold uppercase tracking-[.12em] text-slate-500"><CalendarDays size={12}/>Reprogramar prazo</div><div className="flex gap-2"><input type="date" value={prazo} onChange={e=>setPrazo(e.target.value)} className="h-10 flex-1 rounded-xl border border-white/[.06] bg-black/20 px-3 text-xs text-slate-300"/><button disabled={!prazo||saving} onClick={()=>void onApply("reprogramar_prazo",prazo)} className="rounded-xl border border-sky-400/15 bg-sky-400/[.06] px-4 text-[9px] text-sky-300 disabled:opacity-40">Aplicar prazo</button></div></div>}
    {precisaOwner&&<div><div className="mb-2 flex items-center gap-2 text-[9px] font-semibold uppercase tracking-[.12em] text-slate-500"><UserRound size={12}/>Definir responsável</div><div className="flex gap-2"><select value={responsavel} onChange={e=>setResponsavel(e.target.value)} className="h-10 flex-1 rounded-xl border border-white/[.06] bg-[#0a1020] px-3 text-xs text-slate-300"><option value="">Selecione...</option>{responsaveis.map(r=><option key={r.id} value={r.id}>{r.nome}</option>)}</select><button disabled={!responsavel||saving} onClick={()=>void onApply("definir_responsavel",responsavel)} className="rounded-xl border border-sky-400/15 bg-sky-400/[.06] px-4 text-[9px] text-sky-300 disabled:opacity-40">Definir owner</button></div></div>}
    {podeStatus&&<div><div className="mb-2 text-[9px] font-semibold uppercase tracking-[.12em] text-slate-500">Resolver execução</div><div className="grid grid-cols-2 gap-2"><button disabled={saving} onClick={()=>void onApply("concluir")} className="flex h-10 items-center justify-center gap-2 rounded-xl border border-emerald-400/15 bg-emerald-400/[.06] text-[9px] font-semibold text-emerald-300 disabled:opacity-40"><Check size={13}/>Concluir item</button><button disabled={saving} onClick={()=>void onApply("cancelar")} className="flex h-10 items-center justify-center gap-2 rounded-xl border border-red-400/15 bg-red-400/[.05] text-[9px] font-semibold text-red-300 disabled:opacity-40"><Ban size={13}/>Cancelar item</button></div></div>}
    <button onClick={onOpenProjeto} className="flex h-10 w-full items-center justify-center gap-2 rounded-xl border border-violet-400/15 bg-violet-400/[.05] text-[9px] text-violet-300">Abrir Projeto 360 para análise completa</button>
   </div>
